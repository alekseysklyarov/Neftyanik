@page
@model Neftyanik.Portal.Web.Pages.Platform.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Восстановление доступа";
}
<h1 class="h4">@ViewData["Title"]</h1>
@if (Model.Submitted)
{
    <p role="status">Если учётная запись подходит для выбранного действия, на указанный адрес будет отправлено письмо. Проверьте также папку «Спам».</p>
}
<form method="post" asp-antiforgery="true">
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    <div class="mb-3">
        <label asp-for="Email" class="form-label">Email администратора платформы</label>
        <input asp-for="Email" class="form-control" autocomplete="email" required />
    </div>
    <button type="submit" class="btn btn-primary">Восстановить пароль</button>
    <button type="submit" asp-page-handler="Confirmation" class="btn btn-outline-secondary">Повторить подтверждение email</button>
</form>
<p class="mt-3">Восстановление доступно только после подтверждения email. Если адрес не был указан при создании учётной записи, обратитесь к уполномоченному оператору.</p>
<a asp-page="/Platform/Account/Login">Вход в управление платформой</a>
