@page
@model Neftyanik.Portal.Web.Pages.Platform.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Новый пароль";
}
<h1 class="h4">@ViewData["Title"]</h1>
<form method="post" asp-antiforgery="true" data-recovery-form>
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    <input asp-for="UserId" type="hidden" />
    <input asp-for="Token" type="hidden" />
    <div class="mb-3">
        <label asp-for="NewPassword" class="form-label">Новый пароль</label>
        <input asp-for="NewPassword" class="form-control" autocomplete="new-password" required />
    </div>
    <div class="mb-3">
        <label asp-for="ConfirmPassword" class="form-label">Подтвердите пароль</label>
        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" required />
    </div>
    <button type="submit" class="btn btn-primary">Изменить пароль</button>
</form>
<noscript>Для безопасной передачи ссылки требуется JavaScript. Включите его и откройте ссылку из письма повторно.</noscript>
<script src="~/js/platform-recovery.js" asp-append-version="true"></script>
