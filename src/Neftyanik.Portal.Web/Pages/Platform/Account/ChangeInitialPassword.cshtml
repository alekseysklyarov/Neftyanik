@page
@model Neftyanik.Portal.Web.Pages.Platform.Account.ChangeInitialPasswordModel
@{
    ViewData["Title"] = AppLocalizer.Get("Смена временного пароля", "Зміна тимчасового пароля", "Change temporary password");
}
<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <h1 class="h4">@ViewData["Title"]</h1>
        <p>@AppLocalizer.Get("До смены пароля доступно только это действие.", "До зміни пароля доступна лише ця дія.", "Only this operation is available until your password is changed.")</p>
        <form method="post" asp-page="/Platform/Account/ChangeInitialPassword" asp-antiforgery="true">
            <div asp-validation-summary="All" class="text-danger" role="alert"></div>
            <div class="mb-3">
                <label asp-for="Input.CurrentPassword" class="form-label">@AppLocalizer.Get("Временный пароль", "Тимчасовий пароль", "Temporary password")</label>
                <input asp-for="Input.CurrentPassword" class="form-control" autocomplete="current-password" required />
            </div>
            <div class="mb-3">
                <label asp-for="Input.NewPassword" class="form-label">@AppLocalizer.Get("Новый пароль", "Новий пароль", "New password")</label>
                <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" required />
            </div>
            <div class="mb-3">
                <label asp-for="Input.ConfirmNewPassword" class="form-label">@AppLocalizer.Get("Подтверждение пароля", "Підтвердження пароля", "Confirm password")</label>
                <input asp-for="Input.ConfirmNewPassword" class="form-control" autocomplete="new-password" required />
            </div>
            <button type="submit" class="btn btn-primary">@AppLocalizer.Get("Изменить пароль", "Змінити пароль", "Change password")</button>
        </form>
    </div>
</div>
