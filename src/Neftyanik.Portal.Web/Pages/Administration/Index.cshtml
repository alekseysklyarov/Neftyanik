@page "/Administration"
@model Neftyanik.Portal.Web.Pages.Administration.IndexModel
@{
    ViewData["Title"] = AppLocalizer.Get("Администрирование", "Адміністрування", "Administration");
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h1 class="h2 mb-1">@AppLocalizer.Get("Панель администрирования", "Панель адміністрування", "Administration dashboard")</h1>
        <p class="text-muted mb-0">@AppLocalizer.Get("Сводная информация о состоянии системы и приложения.", "Зведена інформація про стан системи та застосунку.", "Summary information about the system and application state.")</p>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h2 class="h6 text-muted">@AppLocalizer.Get("Подключение к базе данных", "Підключення до бази даних", "Database connection")</h2>
                <p class="display-6 mb-0 @(Model.DatabaseAvailable ? "text-success" : "text-danger")">
                    @(Model.DatabaseAvailable
                        ? AppLocalizer.Get("Доступно", "Доступно", "Available")
                        : AppLocalizer.Get("Недоступно", "Недоступно", "Unavailable"))
                </p>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h2 class="h6 text-muted">@AppLocalizer.Get("Пользователи", "Користувачі", "Users")</h2>
                <p class="display-6 mb-0">@Model.RegisteredUsersCount</p>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h2 class="h6 text-muted">@AppLocalizer.Get("Роли", "Ролі", "Roles")</h2>
                <p class="display-6 mb-0">@Model.RolesCount</p>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h2 class="h6 text-muted">@AppLocalizer.Get("Применённые миграции", "Застосовані міграції", "Applied migrations")</h2>
                <p class="display-6 mb-0">@Model.AppliedMigrationsCount</p>
            </div>
        </div>
    </div>
</div>

@if (Model.CanViewUserActivity && Model.UserActivitySummary is not null)
{
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3">
                <div>
                    <h2 class="h5 mb-1">@AppLocalizer.Get("Активность пользователей", "Активність користувачів", "User activity")</h2>
                    <p class="text-muted mb-0">@AppLocalizer.Get("Сводка по успешным входам зарегистрированных пользователей.", "Зведення щодо успішних входів зареєстрованих користувачів.", "Summary of successful sign-ins for registered users.")</p>
                </div>
                <div>
                    <a class="btn btn-outline-primary" asp-page="/Administration/UserActivity">@AppLocalizer.Get("Активность пользователей", "Активність користувачів", "User activity")</a>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-sm-6 col-xl-2">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small">@AppLocalizer.Get("Всего пользователей", "Усього користувачів", "Total users")</div>
                        <div class="fs-4 fw-semibold">@Model.UserActivitySummary.TotalRegisteredUsers</div>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-2">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small">@AppLocalizer.Get("Хотя бы один вход", "Хоча б один вхід", "Ever logged in")</div>
                        <div class="fs-4 fw-semibold">@Model.UserActivitySummary.EverLoggedInUsers</div>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-2">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small">@AppLocalizer.Get("Активны сегодня", "Активні сьогодні", "Active today")</div>
                        <div class="fs-4 fw-semibold">@Model.UserActivitySummary.ActiveTodayUsers</div>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-2">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small">@AppLocalizer.Get("Активны за 7 дней", "Активні за 7 днів", "Active in last 7 days")</div>
                        <div class="fs-4 fw-semibold">@Model.UserActivitySummary.ActiveLast7DaysUsers</div>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-2">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small">@AppLocalizer.Get("Активны за 30 дней", "Активні за 30 днів", "Active in last 30 days")</div>
                        <div class="fs-4 fw-semibold">@Model.UserActivitySummary.ActiveLast30DaysUsers</div>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-2">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small">@AppLocalizer.Get("Никогда не входили", "Ніколи не входили", "Never logged in")</div>
                        <div class="fs-4 fw-semibold">@Model.UserActivitySummary.NeverLoggedInUsers</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@if (User.IsInRole(RoleNames.Administrator) || User.IsInRole(RoleNames.Accountant))
{
    <div class="card shadow-sm mb-4">
        <div class="card-body d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
                <h2 class="h5 mb-1">@AppLocalizer.Get("Финансовый аудит", "Фінансовий аудит", "Financial audit")</h2>
                <p class="text-muted mb-0">@AppLocalizer.Get("Просмотр журнала изменений финансовых операций и связанных сущностей.", "Перегляд журналу змін фінансових операцій і пов'язаних сутностей.", "View the audit trail of financial operations and related entities.")</p>
            </div>
            <div>
                <a class="btn btn-outline-primary" asp-page="/Administration/AuditLog/Index">@AppLocalizer.Get("Журнал финансового аудита", "Журнал фінансового аудиту", "Financial audit log")</a>
            </div>
        </div>
    </div>
}

<div class="card shadow-sm">
    <div class="card-body">
        <h2 class="h5">@AppLocalizer.Get("Окружение", "Середовище", "Environment")</h2>
        <p class="mb-0">@AppLocalizer.Get("Текущее окружение:", "Поточне середовище:", "Current environment:") <strong>@Model.EnvironmentName</strong></p>
    </div>
</div>

<div class="row g-4 mt-1">
    <div class="col-md-6 col-xl-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body d-flex flex-column">
                <h2 class="h5">@AppLocalizer.Get("Управление участками", "Керування ділянками", "Plot management")</h2>
                <p class="text-muted flex-grow-1">@AppLocalizer.Get("Просмотр, создание, редактирование и архивирование участков товарищества.", "Перегляд, створення, редагування та архівування ділянок товариства.", "View, create, edit, and archive association plots.")</p>
                <div>
                    <a class="btn btn-primary" asp-page="/Administration/Plots/Index">@AppLocalizer.Get("Перейти к участкам", "Перейти до ділянок", "Open plots")</a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body d-flex flex-column">
                <h2 class="h5">@AppLocalizer.Get("Управление членами товарищества", "Керування членами товариства", "Member management")</h2>
                <p class="text-muted flex-grow-1">@AppLocalizer.Get("Просмотр, создание, редактирование и архивирование карточек членов товарищества.", "Перегляд, створення, редагування та архівування карток членів товариства.", "View, create, edit, and archive member records.")</p>
                <div>
                    <a class="btn btn-primary" asp-page="/Administration/Members/Index">@AppLocalizer.Get("Перейти к членам товарищества", "Перейти до членів товариства", "Open members")</a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body d-flex flex-column">
                <h2 class="h5">@AppLocalizer.Get("Финансы", "Фінанси", "Finance")</h2>
                <p class="text-muted flex-grow-1">@AppLocalizer.Get("Сводка по начислениям, платежам и балансам участков товарищества.", "Зведення щодо нарахувань, платежів і балансів ділянок товариства.", "Summary of charges, payments, and plot balances.")</p>
                <div>
                    <a class="btn btn-primary" asp-page="/Administration/Finance/Index">@AppLocalizer.Get("Перейти к финансам", "Перейти до фінансів", "Open finance")</a>
                </div>
            </div>
        </div>
    </div>
</div>
