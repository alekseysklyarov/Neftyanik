@page "/Administration"
@model Neftyanik.Portal.Web.Pages.Administration.IndexModel
@{
    ViewData["Title"] = "Администрирование";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h1 class="h2 mb-1">Панель администрирования</h1>
        <p class="text-muted mb-0">Сводная информация о состоянии системы и приложения.</p>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h2 class="h6 text-muted">Подключение к базе данных</h2>
                <p class="display-6 mb-0 @(Model.DatabaseAvailable ? "text-success" : "text-danger")">
                    @(Model.DatabaseAvailable ? "Доступно" : "Недоступно")
                </p>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h2 class="h6 text-muted">Пользователи</h2>
                <p class="display-6 mb-0">@Model.RegisteredUsersCount</p>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h2 class="h6 text-muted">Роли</h2>
                <p class="display-6 mb-0">@Model.RolesCount</p>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h2 class="h6 text-muted">Применённые миграции</h2>
                <p class="display-6 mb-0">@Model.AppliedMigrationsCount</p>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <h2 class="h5">Окружение</h2>
        <p class="mb-0">Текущее окружение: <strong>@Model.EnvironmentName</strong></p>
    </div>
</div>

<div class="row g-4 mt-1">
    <div class="col-md-6 col-xl-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body d-flex flex-column">
                <h2 class="h5">Управление участками</h2>
                <p class="text-muted flex-grow-1">Просмотр, создание, редактирование и архивирование участков товарищества.</p>
                <div>
                    <a class="btn btn-primary" asp-page="/Administration/Plots/Index">Перейти к участкам</a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body d-flex flex-column">
                <h2 class="h5">Управление членами товарищества</h2>
                <p class="text-muted flex-grow-1">Просмотр, создание, редактирование и архивирование карточек членов товарищества.</p>
                <div>
                    <a class="btn btn-primary" asp-page="/Administration/Members/Index">Перейти к членам товарищества</a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body d-flex flex-column">
                <h2 class="h5">Финансы</h2>
                <p class="text-muted flex-grow-1">Сводка по начислениям, платежам и балансам участков товарищества.</p>
                <div>
                    <a class="btn btn-primary" asp-page="/Administration/Finance/Index">Перейти к финансам</a>
                </div>
            </div>
        </div>
    </div>
</div>
