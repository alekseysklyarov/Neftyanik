@page "/Administration/AuditLog/{id:long}"
@model Neftyanik.Portal.Web.Pages.Administration.FinancialAuditLog.DetailsModel
@{
    ViewData["Title"] = AppLocalizer.Get("Запись финансового аудита", "Запис фінансового аудиту", "Financial audit entry");
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">@AppLocalizer.Get("Запись финансового аудита", "Запис фінансового аудиту", "Financial audit entry") #@Model.Entry.Id</h1>
        <p class="text-muted mb-0">@AppLocalizer.Get("Подробная информация о записи журнала финансового аудита.", "Детальна інформація про запис журналу фінансового аудиту.", "Detailed information about a financial audit log entry.")</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a class="btn btn-outline-primary" asp-page="/Administration/AuditLog/Index">@AppLocalizer.Get("К журналу аудита", "До журналу аудиту", "Back to audit log")</a>
        <a class="btn btn-outline-secondary" asp-page="/Administration/Index">@AppLocalizer.Get("К администрированию", "До адміністрування", "Back to administration")</a>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">@AppLocalizer.Get("Дата и время (UTC)", "Дата й час (UTC)", "Date and time (UTC)")</dt>
            <dd class="col-sm-8">@Model.Entry.CreatedAtUtc.ToString("dd.MM.yyyy HH:mm") UTC</dd>

            <dt class="col-sm-4">@AppLocalizer.Get("Пользователь", "Користувач", "User")</dt>
            <dd class="col-sm-8">@Model.Entry.UserDisplayName</dd>

            <dt class="col-sm-4">@AppLocalizer.Get("User ID", "User ID", "User ID")</dt>
            <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Entry.UserId) ? "—" : Model.Entry.UserId)</dd>

            <dt class="col-sm-4">@AppLocalizer.Get("Действие", "Дія", "Action")</dt>
            <dd class="col-sm-8">@Model.Entry.Action</dd>

            <dt class="col-sm-4">@AppLocalizer.Get("Тип сущности", "Тип сутності", "Entity type")</dt>
            <dd class="col-sm-8">@Model.Entry.EntityType</dd>

            <dt class="col-sm-4">@AppLocalizer.Get("ID сущности", "ID сутності", "Entity ID")</dt>
            <dd class="col-sm-8">@Model.Entry.EntityId</dd>

            <dt class="col-sm-4">@AppLocalizer.Get("Описание", "Опис", "Description")</dt>
            <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Entry.Description) ? "—" : Model.Entry.Description)</dd>
        </dl>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h2 class="h5 mb-3">@AppLocalizer.Get("Старые значения", "Старі значення", "Old values")</h2>
                @if (Model.Entry.OldValues.Count == 0)
                {
                    <p class="text-muted mb-0">@AppLocalizer.Get("Старые значения отсутствуют.", "Старі значення відсутні.", "No old values are available.")</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>@AppLocalizer.Get("Свойство", "Властивість", "Property")</th>
                                    <th>@AppLocalizer.Get("Значение", "Значення", "Value")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Entry.OldValues)
                                {
                                    <tr>
                                        <td class="text-nowrap">@item.PropertyName</td>
                                        <td>@item.Value</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Entry.OldValuesJson))
                {
                    <details class="mt-3">
                        <summary>@AppLocalizer.Get("Показать исходный JSON", "Показати вихідний JSON", "Show raw JSON")</summary>
                        <pre class="small bg-light border rounded p-3 mt-2 mb-0 text-wrap">@Model.Entry.OldValuesJson</pre>
                    </details>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h2 class="h5 mb-3">@AppLocalizer.Get("Новые значения", "Нові значення", "New values")</h2>
                @if (Model.Entry.NewValues.Count == 0)
                {
                    <p class="text-muted mb-0">@AppLocalizer.Get("Новые значения отсутствуют.", "Нові значення відсутні.", "No new values are available.")</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>@AppLocalizer.Get("Свойство", "Властивість", "Property")</th>
                                    <th>@AppLocalizer.Get("Значение", "Значення", "Value")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Entry.NewValues)
                                {
                                    <tr>
                                        <td class="text-nowrap">@item.PropertyName</td>
                                        <td>@item.Value</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Entry.NewValuesJson))
                {
                    <details class="mt-3">
                        <summary>@AppLocalizer.Get("Показать исходный JSON", "Показати вихідний JSON", "Show raw JSON")</summary>
                        <pre class="small bg-light border rounded p-3 mt-2 mb-0 text-wrap">@Model.Entry.NewValuesJson</pre>
                    </details>
                }
            </div>
        </div>
    </div>
</div>
