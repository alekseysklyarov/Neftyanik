@page "{id:long}/Edit"
@model Neftyanik.Portal.Web.Pages.Administration.Finance.Expenses.EditModel
@{
    ViewData["Title"] = "Редактирование расхода";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">Редактирование расхода</h1>
        <p class="text-muted mb-0">Измените данные обычного расхода и сохраните их.</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a class="btn btn-outline-secondary" asp-page="/Administration/Finance/Expenses/Details" asp-route-id="@Model.ExpenseId">К карточке расхода</a>
        <a class="btn btn-outline-secondary" asp-page="/Administration/Finance/Expenses/Index">К расходам</a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Input.ExpenseCategoryId" class="form-label"></label>
                    <select asp-for="Input.ExpenseCategoryId" asp-items="Model.ExpenseCategoryOptions" class="form-select">
                        <option value="">Выберите тип расхода</option>
                    </select>
                    <span asp-validation-for="Input.ExpenseCategoryId" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.ExpenseDate" class="form-label"></label>
                    <input asp-for="Input.ExpenseDate" class="form-control" type="date" />
                    <span asp-validation-for="Input.ExpenseDate" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.Amount" class="form-label"></label>
                    <input asp-for="Input.Amount" class="form-control" type="number" step="0.01" min="0" />
                    <span asp-validation-for="Input.Amount" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.Payee" class="form-label"></label>
                    <input asp-for="Input.Payee" class="form-control" />
                    <span asp-validation-for="Input.Payee" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.DocumentNumber" class="form-label"></label>
                    <input asp-for="Input.DocumentNumber" class="form-control" />
                    <span asp-validation-for="Input.DocumentNumber" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Input.Description" class="form-label"></label>
                    <textarea asp-for="Input.Description" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Input.Description" class="text-danger"></span>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">Сохранить</button>
                <a class="btn btn-outline-secondary" asp-page="/Administration/Finance/Expenses/Details" asp-route-id="@Model.ExpenseId">Отмена</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
