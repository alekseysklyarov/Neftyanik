@page "{readingId:long}"
@model Neftyanik.Portal.Web.Pages.Administration.Finance.Expenses.Electricity.PayModel
@{ ViewData["Title"] = "Оплата поставщику"; }
<h1 class="h2">Оплата поставщику</h1>
<p>Показания от @Model.ReadingDate.ToString("dd.MM.yyyy"). Осталось оплатить: <strong>@Model.Remaining.ToString("0.00") грн</strong>.</p>
<p class="text-muted">Зарегистрируйте уже выполненную оплату. Можно внести часть суммы.</p>
<form method="post" class="card card-body">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="row g-3">
        <div class="col-md-6"><label asp-for="Input.PaymentDate" class="form-label"></label><input asp-for="Input.PaymentDate" type="date" class="form-control" /></div>
        <div class="col-md-6"><label asp-for="Input.Amount" class="form-label"></label><input asp-for="Input.Amount" type="number" step="0.01" min="0.01" class="form-control" /></div>
        <div class="col-md-6"><label asp-for="Input.PaymentMethod" class="form-label"></label><select asp-for="Input.PaymentMethod" class="form-select"><option value="1">Касса (наличные)</option><option value="2">Банковский счёт</option></select></div>
        <div class="col-md-6"><label asp-for="Input.DocumentNumber" class="form-label"></label><input asp-for="Input.DocumentNumber" class="form-control" /></div>
    </div>
    <div class="mt-3"><button type="submit" class="btn btn-primary">Записать оплату</button> <a asp-page="Index" class="btn btn-outline-secondary">Назад</a></div>
</form>
