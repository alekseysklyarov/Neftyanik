@page
@model Neftyanik.Portal.Web.Pages.Administration.Finance.Reports.IndexModel
@{
    ViewData["Title"] = AppLocalizer.Get("Отчёты", "Звіти", "Reports");
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">@AppLocalizer.Get("Отчёты", "Звіти", "Reports")</h1>
        <p class="text-muted mb-0">@AppLocalizer.Get("Поступления и расходование средств товарищества.", "Надходження та використання коштів товариства.", "Association income and spending.")</p>
    </div>
    <a class="btn btn-outline-secondary" asp-page="/Administration/Finance/Index">@AppLocalizer.Get("К финансам", "До фінансів", "Back to finance")</a>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <section class="card h-100 shadow-sm">
            <div class="card-body d-flex flex-column">
                <h2 class="h5">@AppLocalizer.Get("Взносы и расходование средств", "Внески та використання коштів", "Contributions and use of funds")</h2>
                <p class="text-muted flex-grow-1">@AppLocalizer.Get("Поступления, расходы и остатки по источникам средств за выбранный период.", "Надходження, витрати та залишки за джерелами коштів за вибраний період.", "Income, spending and balances by funding source for the selected period.")</p>
                <div><a class="btn btn-outline-primary" asp-page="/Administration/Finance/Funds">@AppLocalizer.Get("Открыть отчёт", "Відкрити звіт", "Open report")</a></div>
            </div>
        </section>
    </div>
    <div class="col-md-6">
        <section class="card h-100 shadow-sm">
            <div class="card-body d-flex flex-column">
                <h2 class="h5">@AppLocalizer.Get("Расходы", "Витрати", "Expenses")</h2>
                <p class="text-muted flex-grow-1">@AppLocalizer.Get("Сводка и журнал расходов с поиском и фильтрами.", "Зведення та журнал витрат із пошуком і фільтрами.", "Expense summary and journal with search and filters.")</p>
                <div><a class="btn btn-outline-primary" asp-page="Expenses">@AppLocalizer.Get("Открыть отчёт", "Відкрити звіт", "Open report")</a></div>
            </div>
        </section>
    </div>
</div>
