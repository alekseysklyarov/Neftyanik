@page "/Administration/Finance/Electricity/Tariffs"
@model Neftyanik.Portal.Web.Pages.Administration.Finance.Electricity.Tariffs.IndexModel
@{
    ViewData["Title"] = AppLocalizer.Get("Тарифы поставщика", "Тарифи постачальника", "Supplier tariffs");
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">@AppLocalizer.Get("Тарифы поставщика", "Тарифи постачальника", "Supplier tariffs")</h1>
        <p class="text-muted mb-0">@AppLocalizer.Get("Дневной и ночной тарифы поставщика используются только для общего счётчика. Тарифы для пользователей ведутся отдельно и применяются для начислений участникам.", "Денний і нічний тарифи постачальника використовуються лише для загального лічильника. Тарифи для користувачів ведуться окремо та застосовуються для нарахувань учасникам.", "Supplier day and night tariffs are used only for the shared meter. User tariffs are maintained separately and applied to member charges.")</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a class="btn btn-outline-primary" asp-page="/Administration/Electricity/MemberTariffs/Index">@AppLocalizer.Get("Тарифы для участников", "Тарифи для учасників", "Member tariffs")</a>
        <a class="btn btn-primary" asp-page="/Administration/Finance/Electricity/Tariffs/Create">@AppLocalizer.Get("Добавить тариф", "Додати тариф", "Add tariff")</a>
        <a class="btn btn-outline-secondary" asp-page="/Administration/Finance/Index">@AppLocalizer.Get("К финансам", "До фінансів", "Back to finance")</a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        @if (Model.Tariffs.Count == 0)
        {
            <div class="p-4 text-center text-muted">@AppLocalizer.Get("Тарифы поставщика пока не добавлены.", "Тарифи постачальника ще не додані.", "No supplier tariffs have been added yet.")</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>@AppLocalizer.Get("Действует с", "Діє з", "Effective from")</th>
                            <th>@AppLocalizer.Get("Дневной тариф общего счётчика, грн/кВт·ч", "Денний тариф загального лічильника, грн/кВт·год", "Shared meter day tariff, UAH/kWh")</th>
                            <th>@AppLocalizer.Get("Ночной тариф общего счётчика, грн/кВт·ч", "Нічний тариф загального лічильника, грн/кВт·год", "Shared meter night tariff, UAH/kWh")</th>
                            <th>@AppLocalizer.Get("Текущий тариф для пользователей, грн/кВт·ч", "Поточний тариф для користувачів, грн/кВт·год", "Current user tariff, UAH/kWh")</th>
                            <th>@AppLocalizer.Get("Создан", "Створено", "Created")</th>
                            <th>@AppLocalizer.Get("Создал", "Створив", "Created by")</th>
                            <th class="text-end">@AppLocalizer.Get("Действия", "Дії", "Actions")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var tariff in Model.Tariffs)
                        {
                            <tr>
                                <td>
                                    @tariff.EffectiveFrom.ToString("dd.MM.yyyy")
                                    @if (tariff.IsCurrent)
                                    {
                                        <span class="badge text-bg-success ms-2">@AppLocalizer.Get("Текущий для общего счётчика", "Поточний для загального лічильника", "Current for shared meter")</span>
                                    }
                                </td>
                                <td>@tariff.DayRate.ToString("0.0000") грн/кВт·ч</td>
                                <td>@tariff.NightRate.ToString("0.0000") грн/кВт·ч</td>
                                <td>@(Model.CurrentMemberRate.HasValue ? $"{Model.CurrentMemberRate.Value:0.0000} грн/кВт·ч" : "—")</td>
                                <td>@tariff.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                <td>@tariff.CreatedBy</td>
                                <td class="text-end">
                                    <a class="btn btn-sm btn-outline-primary" asp-page="/Administration/Finance/Electricity/Tariffs/Details" asp-route-id="@tariff.Id">@AppLocalizer.Get("Подробнее", "Детальніше", "Details")</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
