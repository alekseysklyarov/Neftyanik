@page "/Administration/Finance/Electricity/Tariffs/Create"
@model Neftyanik.Portal.Web.Pages.Administration.Finance.Electricity.Tariffs.CreateModel
@{
    ViewData["Title"] = "Новый тариф электроэнергии";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">Новый тариф электроэнергии</h1>
        <p class="text-muted mb-0">Добавление новой записи в историю тарифов.</p>
    </div>
    <a class="btn btn-outline-secondary" asp-page="/Administration/Finance/Electricity/Tariffs/Index">К списку тарифов</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="Input.EffectiveFrom" class="form-label"></label>
                    <input asp-for="Input.EffectiveFrom" class="form-control" type="date" />
                    <span asp-validation-for="Input.EffectiveFrom" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Input.DayRate" class="form-label"></label>
                    <input asp-for="Input.DayRate" class="form-control" type="number" step="0.0001" min="0" />
                    <span asp-validation-for="Input.DayRate" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Input.NightRate" class="form-label"></label>
                    <input asp-for="Input.NightRate" class="form-control" type="number" step="0.0001" min="0" />
                    <span asp-validation-for="Input.NightRate" class="text-danger"></span>
                </div>
            </div>
            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">Сохранить тариф</button>
                <a class="btn btn-outline-secondary" asp-page="/Administration/Finance/Electricity/Tariffs/Index">Отмена</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
