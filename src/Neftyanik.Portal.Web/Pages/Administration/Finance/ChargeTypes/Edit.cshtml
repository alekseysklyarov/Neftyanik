@page "{id:int}"
@model Neftyanik.Portal.Web.Pages.Administration.Finance.ChargeTypes.EditModel
@{
    ViewData["Title"] = "Редактирование типа начисления";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h2 mb-1">Редактирование типа начисления</h1>
        <p class="text-muted mb-0">Измените параметры типа начисления.</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-page="/Administration/Finance/ChargeTypes/Details" asp-route-id="@Model.ChargeTypeId">Подробнее</a>
        <a class="btn btn-outline-secondary" asp-page="/Administration/Finance/ChargeTypes/Index">К списку</a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Input.Name" class="form-label"></label>
                    <input asp-for="Input.Name" class="form-control" />
                    <span asp-validation-for="Input.Name" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.DefaultAmount" class="form-label"></label>
                    <input asp-for="Input.DefaultAmount" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="Input.DefaultAmount" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Input.Description" class="form-label"></label>
                    <textarea asp-for="Input.Description" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Input.Description" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <div class="form-check">
                        <input asp-for="Input.IsDefault" class="form-check-input" />
                        <label asp-for="Input.IsDefault" class="form-check-label"></label>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-check">
                        <input asp-for="Input.IsYearly" class="form-check-input" />
                        <label asp-for="Input.IsYearly" class="form-check-label"></label>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-check">
                        <input asp-for="Input.OnlyOnOwnerChange" class="form-check-input" />
                        <label asp-for="Input.OnlyOnOwnerChange" class="form-check-label"></label>
                    </div>
                </div>
                <div class="col-12">
                    <div class="form-check">
                        <input asp-for="Input.IsActive" class="form-check-input" />
                        <label asp-for="Input.IsActive" class="form-check-label"></label>
                    </div>
                </div>
            </div>
            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">Сохранить</button>
                <a class="btn btn-outline-secondary" asp-page="/Administration/Finance/ChargeTypes/Details" asp-route-id="@Model.ChargeTypeId">Отмена</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
