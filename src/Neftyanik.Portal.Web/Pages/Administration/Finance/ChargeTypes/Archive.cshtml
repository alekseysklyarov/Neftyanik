@page "{id:int}"
@model Neftyanik.Portal.Web.Pages.Administration.Finance.ChargeTypes.ArchiveModel
@{
    ViewData["Title"] = Model.IsArchiveOperation ? "Архивация типа начисления" : "Восстановление типа начисления";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h3 mb-3">@(Model.IsArchiveOperation ? "Архивация типа начисления" : "Восстановление типа начисления")</h1>
                <p>
                    @(Model.IsArchiveOperation
                        ? "Запись будет переведена в архив и останется в системе. Уже созданные начисления сохранят свою историю."
                        : "Тип начисления будет снова доступен для использования.")
                </p>

                <dl class="row mb-4">
                    <dt class="col-sm-4">Наименование</dt>
                    <dd class="col-sm-8">@Model.ChargeType.Name</dd>

                    <dt class="col-sm-4">Использований</dt>
                    <dd class="col-sm-8">@Model.ChargeType.ChargesCount</dd>
                </dl>

                <form method="post" class="d-flex gap-2 flex-wrap">
                    <button type="submit" class="btn @(Model.IsArchiveOperation ? "btn-warning" : "btn-success")">@(Model.IsArchiveOperation ? "Подтвердить архивацию" : "Подтвердить восстановление")</button>
                    <a class="btn btn-outline-secondary" asp-page="/Administration/Finance/ChargeTypes/Details" asp-route-id="@Model.ChargeType.Id">Отмена</a>
                </form>
            </div>
        </div>
    </div>
</div>
