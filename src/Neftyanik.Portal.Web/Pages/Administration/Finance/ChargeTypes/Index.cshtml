@page
@model Neftyanik.Portal.Web.Pages.Administration.Finance.ChargeTypes.IndexModel
@{
    ViewData["Title"] = "Типы начислений";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">Типы начислений</h1>
        <p class="text-muted mb-0">Справочник типов начислений для финансового учета.</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a class="btn btn-primary" asp-page="/Administration/Finance/ChargeTypes/Create">Добавить тип начисления</a>
        <a class="btn btn-outline-secondary" asp-page="/Administration/Finance/Index">Назад к финансам</a>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-6">
                <label asp-for="Search" class="form-label">Поиск</label>
                <input asp-for="Search" class="form-control" placeholder="Наименование типа начисления" />
            </div>
            <div class="col-md-3">
                <label asp-for="Status" class="form-label">Статус</label>
                <select asp-for="Status" class="form-select">
                    <option value="active">Только активные</option>
                    <option value="all">Все</option>
                    <option value="archived">Только архивные</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-outline-primary flex-fill">Найти</button>
                <a class="btn btn-outline-secondary" asp-page="/Administration/Finance/ChargeTypes/Index" asp-route-status="all">Сбросить</a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        @if (Model.ChargeTypes.Count == 0)
        {
            <div class="p-4 text-center text-muted">@Model.EmptyStateMessage</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Наименование</th>
                            <th>Сумма по умолчанию</th>
                            <th>Статус</th>
                            <th>Использований</th>
                            <th class="text-end">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var chargeType in Model.ChargeTypes)
                        {
                            <tr>
                                <td class="fw-semibold">@chargeType.Name</td>
                                <td>@(chargeType.DefaultAmount.HasValue ? chargeType.DefaultAmount.Value.ToString("0.00") : "—")</td>
                                <td>
                                    @if (chargeType.IsActive)
                                    {
                                        <span class="badge text-bg-success">Активен</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">В архиве</span>
                                    }
                                </td>
                                <td>@chargeType.ChargesCount</td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a class="btn btn-outline-secondary" asp-page="/Administration/Finance/ChargeTypes/Details" asp-route-id="@chargeType.Id">Подробнее</a>
                                        <a class="btn btn-outline-primary" asp-page="/Administration/Finance/ChargeTypes/Edit" asp-route-id="@chargeType.Id">Редактировать</a>
                                        <a class="btn btn-outline-warning" asp-page="/Administration/Finance/ChargeTypes/Archive" asp-route-id="@chargeType.Id">@(chargeType.IsActive ? "Архивировать" : "Восстановить")</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav aria-label="Навигация по страницам" class="mt-4">
        <ul class="pagination justify-content-center flex-wrap">
            <li class="page-item @(Model.HasPreviousPage ? string.Empty : "disabled")">
                <a class="page-link" asp-page="/Administration/Finance/ChargeTypes/Index" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-pageNumber="@(Model.PageNumber - 1)">Назад</a>
            </li>
            @for (var pageIndex = 1; pageIndex <= Model.TotalPages; pageIndex++)
            {
                <li class="page-item @(pageIndex == Model.PageNumber ? "active" : string.Empty)">
                    <a class="page-link" asp-page="/Administration/Finance/ChargeTypes/Index" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-pageNumber="@pageIndex">@pageIndex</a>
                </li>
            }
            <li class="page-item @(Model.HasNextPage ? string.Empty : "disabled")">
                <a class="page-link" asp-page="/Administration/Finance/ChargeTypes/Index" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-pageNumber="@(Model.PageNumber + 1)">Вперёд</a>
            </li>
        </ul>
    </nav>
}
