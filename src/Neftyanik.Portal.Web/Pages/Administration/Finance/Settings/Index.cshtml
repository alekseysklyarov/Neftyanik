@page
@model Neftyanik.Portal.Web.Pages.Administration.Finance.Settings.IndexModel
@{
    ViewData["Title"] = "Настройки финансов";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">Настройки финансов</h1>
        <p class="text-muted mb-0">Справочники и настройки, используемые в финансовом учете.</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a class="btn btn-outline-secondary" asp-page="/Administration/Finance/Index">К финансам</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-6 col-xl-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body d-flex flex-column">
                <h2 class="h5">Типы расходов</h2>
                <p class="text-muted flex-grow-1">Справочник категорий расходов товарищества.</p>
                <div>
                    <a class="btn btn-primary" asp-page="/Administration/Finance/ExpenseCategories/Index">Открыть</a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body d-flex flex-column">
                <h2 class="h5">Тарифы поставщика</h2>
                <p class="text-muted flex-grow-1">Тарифы поставщика для расчета расходов по общему счетчику.</p>
                <div>
                    <a class="btn btn-primary" asp-page="/Administration/Finance/Electricity/Tariffs/Index">Открыть</a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body d-flex flex-column">
                <h2 class="h5">Тарифы для участников</h2>
                <p class="text-muted flex-grow-1">Тарифы для расчёта начислений по электросчётчикам членов товарищества.</p>
                <div>
                    <a class="btn btn-primary" asp-page="/Administration/Electricity/MemberTariffs/Index">Открыть</a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body d-flex flex-column">
                <h2 class="h5">Типы начислений</h2>
                <p class="text-muted flex-grow-1">Справочник типов начислений для участков и членов товарищества.</p>
                <div>
                    <a class="btn btn-primary" asp-page="/Administration/Finance/ChargeTypes/Index">Открыть</a>
                </div>
            </div>
        </div>
    </div>
</div>
