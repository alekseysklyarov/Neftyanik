@page
@model Neftyanik.Portal.Web.Pages.Administration.Finance.Settings.IndexModel
@{
    ViewData["Title"] = AppLocalizer.Get("Настройки финансов", "Налаштування фінансів", "Finance settings");
}

@if (User.IsInRole(RoleNames.Administrator))
{
    <p><a class="btn btn-outline-primary" asp-page="PaymentInstructions">Реквизиты для оплаты участниками</a></p>
}
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">@AppLocalizer.Get("Настройки финансов", "Налаштування фінансів", "Finance settings")</h1>
        <p class="text-muted mb-0">@AppLocalizer.Get("Справочники и настройки, используемые в финансовом учете.", "Довідники та налаштування, що використовуються у фінансовому обліку.", "Reference data and settings used in finance.")</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a class="btn btn-outline-secondary" asp-page="/Administration/Finance/Index">@AppLocalizer.Get("К финансам", "До фінансів", "Back to finance")</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-12">
        <h2 class="h4">@AppLocalizer.Get("Готовность товарищества", "Готовність товариства", "Association readiness")</h2>
        <p>@AppLocalizer.Get("Обзор на", "Огляд на", "Overview as of") @Model.Readiness.AsOfDate.ToString("dd.MM.yyyy").
            @AppLocalizer.Get("Это отдельные проверки, а не блокировка портала. Операции сохраняют собственные проверки, в том числе тариф на дату показания и права доступа.", "Це окремі перевірки, а не блокування порталу. Операції зберігають власні перевірки, зокрема тариф на дату показання й права доступу.", "These are individual checks, not a portal lock. Operations retain their own validation, including tariffs on the reading date and access permissions.")</p>
    </div>
    @foreach (var card in Model.Cards)
    {
        <div class="col-md-6 col-xl-4">
            <section class="card h-100 shadow-sm" data-readiness-area="@card.Area" aria-labelledby="readiness-@card.Area">
                <div class="card-body d-flex flex-column">
                    <h3 class="h5" id="readiness-@card.Area">@card.Title</h3>
                    <div class="mb-3"><span class="badge text-wrap text-start @card.BadgeClass">@card.Status</span></div>
                    <p>@card.Reason</p>
                    @if (!string.IsNullOrEmpty(card.Details))
                    {
                        <p>@card.Details</p>
                    }
                    <p class="text-muted flex-grow-1">@card.Limitation</p>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var link in card.Links)
                        {
                            <a class="btn btn-outline-primary" asp-page="@link.Page">@link.Text</a>
                        }
                    </div>
                </div>
            </section>
        </div>
    }
</div>

<section class="mt-4" aria-labelledby="available-operations">
    <h2 class="h4" id="available-operations">@AppLocalizer.Get("Что уже можно делать", "Що вже можна робити", "What you can already do")</h2>
    <ul>
        <li>@AppLocalizer.Get("Создавать участников и участки.", "Створювати учасників і ділянки.", "Create members and plots.")</li>
        <li>@AppLocalizer.Get("Принимать платежи после создания действующей связи владения участком.", "Приймати платежі після створення чинного зв’язку володіння ділянкою.", "Accept payments after creating a current plot ownership.")</li>
        <li>@AppLocalizer.Get("Создавать справочники типов начислений и категорий расходов.", "Створювати довідники типів нарахувань і категорій витрат.", "Create charge types and expense categories.")</li>
        <li>@AppLocalizer.Get("Просматривать отчёты, даже если финансовых данных ещё нет.", "Переглядати звіти, навіть якщо фінансових даних ще немає.", "View reports even before financial data exists.")</li>
        <li>@AppLocalizer.Get("Вводить начальные показания новых счётчиков без тарифа.", "Вводити початкові показання нових лічильників без тарифу.", "Enter initial readings for new meters without a tariff.")</li>
    </ul>
    <p class="text-muted">@AppLocalizer.Get("Доступность действий зависит от вашей роли. Настройки открываются на существующих страницах; этот обзор ничего не изменяет.", "Доступність дій залежить від вашої ролі. Налаштування відкриваються на наявних сторінках; цей огляд нічого не змінює.", "Actions depend on your role. Settings open on existing pages; this overview changes nothing.")</p>
</section>
