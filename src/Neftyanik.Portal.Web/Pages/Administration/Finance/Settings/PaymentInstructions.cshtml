@page
@model Neftyanik.Portal.Web.Pages.Administration.Finance.Settings.PaymentInstructionsModel
@{ ViewData["Title"] = "Реквизиты для оплаты"; }
<h1 class="h2">Реквизиты для оплаты</h1>
<p>Эти данные увидят участники в личном кабинете.</p>
<form method="post" class="card card-body">
    <div asp-validation-summary="All" class="text-danger"></div>
    <label asp-for="Input.Recipient" class="form-label"></label><input asp-for="Input.Recipient" class="form-control mb-3" />
    <label asp-for="Input.CardNumber" class="form-label"></label><input asp-for="Input.CardNumber" inputmode="numeric" autocomplete="off" class="form-control mb-3" />
    <label asp-for="Input.Purpose" class="form-label"></label><textarea asp-for="Input.Purpose" class="form-control mb-3"></textarea>
    <label asp-for="Input.Contact" class="form-label"></label><input asp-for="Input.Contact" class="form-control mb-3" />
    <div><button class="btn btn-primary" type="submit">Сохранить</button> <a asp-page="Index" class="btn btn-outline-secondary">Назад</a></div>
</form>
