@page "{id:int}"
@model Neftyanik.Portal.Web.Pages.Administration.Finance.ExpenseCategories.EditModel
@{
    ViewData["Title"] = AppLocalizer.Get("Редактирование типа расхода", "Редагування типу витрати", "Edit expense type");
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">@AppLocalizer.Get("Редактирование типа расхода", "Редагування типу витрати", "Edit expense type")</h1>
        <p class="text-muted mb-0">@AppLocalizer.Get("Измените наименование, описание и статус типа расхода.", "Змініть назву, опис і статус типу витрати.", "Change the name, description, and status of the expense type.")</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a class="btn btn-outline-secondary" asp-page="/Administration/Finance/ExpenseCategories/Index">@AppLocalizer.Get("К типам расходов", "До типів витрат", "Back to expense types")</a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="mb-3 text-muted">@AppLocalizer.Get("Использований в расходах:", "Використань у витратах:", "Used in expenses:") @Model.ExpensesCount</div>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Input.Name" class="form-label">@AppLocalizer.Get("Наименование", "Назва", "Name")</label>
                    <input asp-for="Input.Name" class="form-control" />
                    <span asp-validation-for="Input.Name" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Input.Description" class="form-label">@AppLocalizer.Get("Описание", "Опис", "Description")</label>
                    <textarea asp-for="Input.Description" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Input.Description" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <div class="form-check">
                        <input asp-for="Input.IsActive" class="form-check-input" />
                        <label asp-for="Input.IsActive" class="form-check-label">@AppLocalizer.Get("Активен", "Активний", "Active")</label>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">@AppLocalizer.Get("Сохранить", "Зберегти", "Save")</button>
                <a class="btn btn-outline-secondary" asp-page="/Administration/Finance/ExpenseCategories/Index">@AppLocalizer.Get("Отмена", "Скасувати", "Cancel")</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
