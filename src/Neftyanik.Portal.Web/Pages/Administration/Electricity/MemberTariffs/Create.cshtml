@page
@model Neftyanik.Portal.Web.Pages.Administration.Electricity.MemberTariffs.CreateModel
@{
    ViewData["Title"] = AppLocalizer.Get("Новый тариф для участников", "Новий тариф для учасників", "New member tariff");
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body">
                <h1 class="h3 mb-3">@AppLocalizer.Get("Новый тариф для участников", "Новий тариф для учасників", "New member tariff")</h1>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <form method="post" class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Input.EffectiveFrom" class="form-label">@AppLocalizer.Get("Действует с", "Діє з", "Effective from")</label>
                        <input asp-for="Input.EffectiveFrom" class="form-control" />
                        <span asp-validation-for="Input.EffectiveFrom" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Input.Rate" class="form-label">@AppLocalizer.Get("Тариф, грн/кВт·ч", "Тариф, грн/кВт·год", "Tariff, UAH/kWh")</label>
                        <input asp-for="Input.Rate" class="form-control" type="number" step="0.0001" min="0" inputmode="decimal" />
                        <span asp-validation-for="Input.Rate" class="text-danger"></span>
                    </div>
                    <div class="col-12 d-flex gap-2">
                        <button type="submit" class="btn btn-primary">@AppLocalizer.Get("Сохранить", "Зберегти", "Save")</button>
                        <a class="btn btn-outline-secondary" asp-page="/Administration/Electricity/MemberTariffs/Index">@AppLocalizer.Get("Назад", "Назад", "Back")</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
