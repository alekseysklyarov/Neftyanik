@page
@model Neftyanik.Portal.Web.Pages.Administration.Electricity.Association.Tariffs.IndexModel
@{
    ViewData["Title"] = "Тарифы поставщика";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">Тарифы поставщика</h1>
        <p class="text-muted mb-0">Используются только для расчёта суммы по общему счётчику.</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a class="btn btn-primary" asp-page="/Administration/Electricity/Association/Tariffs/Create">Добавить тариф</a>
        <a class="btn btn-outline-secondary" asp-page="/Administration/Electricity/Association/Index">К общему счётчику</a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Действует с</th>
                    <th>Дневной тариф</th>
                    <th>Ночной тариф</th>
                    <th>Текущий</th>
                    <th>Создан</th>
                    <th>Кем создан</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Tariffs.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">Тарифы поставщика пока не заданы.</td></tr>
                }
                else
                {
                    @foreach (var item in Model.Tariffs)
                    {
                        <tr>
                            <td>@item.EffectiveFrom.ToString("dd.MM.yyyy")</td>
                            <td>@item.DayRate.ToString("0.0000") грн/кВт·ч</td>
                            <td>@item.NightRate.ToString("0.0000") грн/кВт·ч</td>
                            <td>@(item.IsCurrent ? "Да" : "—")</td>
                            <td>@item.CreatedAtUtc.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>@item.CreatedBy</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
