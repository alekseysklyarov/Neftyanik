@page
@model Neftyanik.Portal.Web.Pages.Administration.Electricity.Meters.IndexModel
@{
    ViewData["Title"] = "Счётчики участников";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">Счётчики участников</h1>
        <p class="text-muted mb-0">Индивидуальные счётчики однотарифные и могут покрывать несколько участков.</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a class="btn btn-primary" asp-page="/Administration/Electricity/Meters/Create">Добавить счётчик</a>
        <a class="btn btn-outline-primary" asp-page="/Administration/Electricity/MemberTariffs/Index">Тариф для участников</a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Участник</th>
                    <th>Счётчик</th>
                    <th>Связанные участки</th>
                    <th>Расчётный участок</th>
                    <th>Последняя дата</th>
                    <th>Последняя сумма</th>
                    <th>Статус</th>
                    <th class="text-end">Действия</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Meters.Count == 0)
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">Счётчики участников пока не добавлены.</td></tr>
                }
                else
                {
                    @foreach (var item in Model.Meters)
                    {
                        <tr>
                            <td>@item.MemberName</td>
                            <td>@item.DisplayName</td>
                            <td>@string.Join(", ", item.LinkedPlotNumbers)</td>
                            <td>@item.BillingPlotNumber</td>
                            <td>@(item.LatestReadingDate.HasValue ? item.LatestReadingDate.Value.ToString("dd.MM.yyyy") : "—")</td>
                            <td>@(item.LatestAmount.HasValue ? $"{item.LatestAmount.Value:0.00} грн" : "—")</td>
                            <td>
                                @(item.IsActive ? "Активен" : "Отключен")
                                @if (item.HasOwnershipWarning)
                                {
                                    <div class="small text-warning">Требуется проверка владельца участков</div>
                                }
                            </td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-primary" asp-page="/Administration/Electricity/Meters/Details" asp-route-id="@item.Id">Открыть</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
