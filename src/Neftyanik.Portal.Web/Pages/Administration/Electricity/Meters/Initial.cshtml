@page "/Administration/Electricity/Meters/{id:int}/Initial"
@model Neftyanik.Portal.Web.Pages.Administration.Electricity.Meters.InitialModel
@{
    ViewData["Title"] = "Начальные показания счётчика";
}

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body">
                <h1 class="h3 mb-3">Начальные показания счётчика</h1>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <form method="post" class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Input.ReadingDate" class="form-label">Дата показаний</label>
                        <input asp-for="Input.ReadingDate" class="form-control" />
                        <span asp-validation-for="Input.ReadingDate" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Input.CurrentReading" class="form-label">@(Model.Meter.RequiresNightReading ? "Начальное дневное показание, кВт·ч" : "Начальное показание, кВт·ч")</label>
                        <input asp-for="Input.CurrentReading" class="form-control" />
                        <span asp-validation-for="Input.CurrentReading" class="text-danger"></span>
                    </div>
                    @if (Model.Meter.RequiresNightReading)
                    {
                        <div class="col-md-6">
                            <label asp-for="Input.CurrentNightReading" class="form-label">Начальное ночное показание, кВт·ч</label>
                            <input asp-for="Input.CurrentNightReading" class="form-control" />
                            <span asp-validation-for="Input.CurrentNightReading" class="text-danger"></span>
                        </div>
                    }
                    <div class="col-12 d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Сохранить</button>
                        <a class="btn btn-outline-secondary" asp-page="/Administration/Electricity/Meters/Details" asp-route-id="@Model.Meter.Id">Назад</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="h5 mb-3">Сведения о счётчике</h2>
                <dl class="mb-0">
                    <dt>Счётчик</dt>
                    <dd>@Model.Meter.DisplayName</dd>
                    <dt>Участник</dt>
                    <dd>@Model.Meter.MemberName</dd>
                    <dt>Тип счётчика</dt>
                    <dd>@(Model.Meter.RequiresNightReading ? "Двухзонный" : "Однозонный")</dd>
                    <dt>Связанные участки</dt>
                    <dd>@string.Join(", ", Model.Meter.LinkedPlotNumbers)</dd>
                    <dt>Расчётный участок</dt>
                    <dd>@Model.Meter.BillingPlotNumber</dd>
                </dl>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
