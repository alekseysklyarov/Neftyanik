@page
@model Neftyanik.Portal.Web.Pages.Administration.Plots.CreateModel
@{
    ViewData["Title"] = "Новый участок";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h2 mb-1">Новый участок</h1>
        <p class="text-muted mb-0">Заполните данные участка.</p>
    </div>
    <a class="btn btn-outline-secondary" asp-page="/Administration/Plots/Index">К списку участков</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Input.Number" class="form-label"></label>
                    <input asp-for="Input.Number" class="form-control" />
                    <span asp-validation-for="Input.Number" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.CadastralNumber" class="form-label"></label>
                    <input asp-for="Input.CadastralNumber" class="form-control" />
                    <span asp-validation-for="Input.CadastralNumber" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Input.Address" class="form-label"></label>
                    <input asp-for="Input.Address" class="form-control" />
                    <span asp-validation-for="Input.Address" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.AreaSquareMeters" class="form-label"></label>
                    <input asp-for="Input.AreaSquareMeters" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="Input.AreaSquareMeters" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Input.Notes" class="form-label"></label>
                    <textarea asp-for="Input.Notes" class="form-control" rows="5"></textarea>
                    <span asp-validation-for="Input.Notes" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <div class="form-check">
                        <input asp-for="Input.IsActive" class="form-check-input" />
                        <label asp-for="Input.IsActive" class="form-check-label"></label>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">Сохранить</button>
                <a class="btn btn-outline-secondary" asp-page="/Administration/Plots/Index">Отмена</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
