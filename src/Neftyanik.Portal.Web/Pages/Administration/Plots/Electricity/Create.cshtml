@page "/Administration/Plots/{plotId:int}/Electricity/Create"
@model Neftyanik.Portal.Web.Pages.Administration.Plots.Electricity.CreateModel
@{
    ViewData["Title"] = "Новые показания электроэнергии";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">Новые показания электроэнергии</h1>
        <p class="text-muted mb-0">Участок @Model.Plot.PlotNumber</p>
    </div>
    <a class="btn btn-outline-secondary" asp-page="/Administration/Plots/Electricity/Index" asp-route-plotId="@Model.Plot.PlotId">К истории показаний</a>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-white">
        <h2 class="h5 mb-0">Предыдущие показания</h2>
    </div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4">
                <div class="text-muted small">Предыдущая дата</div>
                <div class="fw-semibold">@Model.PreviousReading.ReadingDate.ToString("dd.MM.yyyy")</div>
            </div>
            <div class="col-md-4">
                <div class="text-muted small">Предыдущее дневное показание</div>
                <div class="fw-semibold">@Model.PreviousReading.CurrentDayReading.ToString("0.000") кВт·ч</div>
            </div>
            <div class="col-md-4">
                <div class="text-muted small">Предыдущее ночное показание</div>
                <div class="fw-semibold">@Model.PreviousReading.CurrentNightReading.ToString("0.000") кВт·ч</div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="post" id="electricity-reading-form">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="Input.ReadingDate" class="form-label"></label>
                    <input asp-for="Input.ReadingDate" class="form-control" type="date" />
                    <span asp-validation-for="Input.ReadingDate" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Input.CurrentDayReading" class="form-label"></label>
                    <input asp-for="Input.CurrentDayReading" class="form-control js-current-day-reading" type="number" step="0.001" min="0" />
                    <span asp-validation-for="Input.CurrentDayReading" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Input.CurrentNightReading" class="form-label"></label>
                    <input asp-for="Input.CurrentNightReading" class="form-control js-current-night-reading" type="number" step="0.001" min="0" />
                    <span asp-validation-for="Input.CurrentNightReading" class="text-danger"></span>
                </div>
            </div>
            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">Создать начисление</button>
                <a class="btn btn-outline-secondary" asp-page="/Administration/Plots/Electricity/Index" asp-route-plotId="@Model.Plot.PlotId">Отмена</a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white">
        <h2 class="h5 mb-0">Расчет</h2>
    </div>
    <div class="card-body">
        @if (Model.Preview.Tariff is null)
        {
            <div class="alert alert-warning mb-0" role="alert">
                Для выбранной даты не найден действующий тариф. Итоговое начисление создать нельзя, пока не будет добавлен подходящий тариф.
            </div>
        }
        else
        {
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="text-muted small">Расход день</div>
                    <div class="fw-semibold js-day-consumption" data-previous-value="@Model.PreviousReading.CurrentDayReading">@(Model.Preview.DayConsumption.HasValue ? $"{Model.Preview.DayConsumption.Value:0.000} кВт·ч" : "—")</div>
                </div>
                <div class="col-md-4">
                    <div class="text-muted small">Расход ночь</div>
                    <div class="fw-semibold js-night-consumption" data-previous-value="@Model.PreviousReading.CurrentNightReading">@(Model.Preview.NightConsumption.HasValue ? $"{Model.Preview.NightConsumption.Value:0.000} кВт·ч" : "—")</div>
                </div>
                <div class="col-md-4">
                    <div class="text-muted small">Тариф действует с</div>
                    <div class="fw-semibold">@Model.Preview.Tariff.EffectiveFrom.ToString("dd.MM.yyyy")</div>
                </div>
                <div class="col-md-4">
                    <div class="text-muted small">Дневной тариф</div>
                    <div class="fw-semibold js-day-rate" data-rate="@Model.Preview.Tariff.DayRate.ToString("0.0000", System.Globalization.CultureInfo.InvariantCulture)">@Model.Preview.Tariff.DayRate.ToString("0.0000") грн/кВт·ч</div>
                </div>
                <div class="col-md-4">
                    <div class="text-muted small">Ночной тариф</div>
                    <div class="fw-semibold js-night-rate" data-rate="@Model.Preview.Tariff.NightRate.ToString("0.0000", System.Globalization.CultureInfo.InvariantCulture)">@Model.Preview.Tariff.NightRate.ToString("0.0000") грн/кВт·ч</div>
                </div>
                <div class="col-md-4">
                    <div class="text-muted small">Тип предыдущей записи</div>
                    <div class="fw-semibold">@(Model.PreviousReading.IsInitialReading ? "Начальные показания" : "Начисление")</div>
                </div>
                <div class="col-md-4">
                    <div class="text-muted small">Стоимость день</div>
                    <div class="fw-semibold js-day-amount">@(Model.Preview.DayAmount.HasValue ? $"{Model.Preview.DayAmount.Value:0.00} грн" : "—")</div>
                </div>
                <div class="col-md-4">
                    <div class="text-muted small">Стоимость ночь</div>
                    <div class="fw-semibold js-night-amount">@(Model.Preview.NightAmount.HasValue ? $"{Model.Preview.NightAmount.Value:0.00} грн" : "—")</div>
                </div>
                <div class="col-md-4">
                    <div class="text-muted small">Итого</div>
                    <div class="fw-semibold js-total-amount">@(Model.Preview.TotalAmount.HasValue ? $"{Model.Preview.TotalAmount.Value:0.00} грн" : "—")</div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (Model.Preview.Tariff is not null)
    {
        <script>
            (() => {
                const dayInput = document.querySelector('.js-current-day-reading');
                const nightInput = document.querySelector('.js-current-night-reading');
                const dayConsumptionElement = document.querySelector('.js-day-consumption');
                const nightConsumptionElement = document.querySelector('.js-night-consumption');
                const dayAmountElement = document.querySelector('.js-day-amount');
                const nightAmountElement = document.querySelector('.js-night-amount');
                const totalAmountElement = document.querySelector('.js-total-amount');
                const dayRate = Number.parseFloat(document.querySelector('.js-day-rate')?.dataset.rate ?? '0');
                const nightRate = Number.parseFloat(document.querySelector('.js-night-rate')?.dataset.rate ?? '0');
                const previousDay = Number.parseFloat(dayConsumptionElement?.dataset.previousValue ?? '0');
                const previousNight = Number.parseFloat(nightConsumptionElement?.dataset.previousValue ?? '0');

                const formatReading = value => `${value.toFixed(3)} кВт·ч`;
                const formatMoney = value => `${value.toFixed(2)} грн`;
                const roundMoney = value => Math.round((value + Number.EPSILON) * 100) / 100;

                const updatePreview = () => {
                    const currentDay = Number.parseFloat(dayInput?.value ?? '');
                    const currentNight = Number.parseFloat(nightInput?.value ?? '');

                    if (!Number.isNaN(currentDay)) {
                        const dayConsumption = currentDay - previousDay;
                        dayConsumptionElement.textContent = dayConsumption >= 0 ? formatReading(dayConsumption) : '—';
                        dayAmountElement.textContent = dayConsumption >= 0 ? formatMoney(roundMoney(dayConsumption * dayRate)) : '—';
                    }
                    else {
                        dayConsumptionElement.textContent = '—';
                        dayAmountElement.textContent = '—';
                    }

                    if (!Number.isNaN(currentNight)) {
                        const nightConsumption = currentNight - previousNight;
                        nightConsumptionElement.textContent = nightConsumption >= 0 ? formatReading(nightConsumption) : '—';
                        nightAmountElement.textContent = nightConsumption >= 0 ? formatMoney(roundMoney(nightConsumption * nightRate)) : '—';
                    }
                    else {
                        nightConsumptionElement.textContent = '—';
                        nightAmountElement.textContent = '—';
                    }

                    const dayText = dayAmountElement.textContent;
                    const nightText = nightAmountElement.textContent;
                    if (dayText !== '—' && nightText !== '—') {
                        const dayAmount = Number.parseFloat(dayText.replace(' грн', ''));
                        const nightAmount = Number.parseFloat(nightText.replace(' грн', ''));
                        totalAmountElement.textContent = formatMoney(roundMoney(dayAmount + nightAmount));
                    }
                    else {
                        totalAmountElement.textContent = '—';
                    }
                };

                dayInput?.addEventListener('input', updatePreview);
                nightInput?.addEventListener('input', updatePreview);
            })();
        </script>
    }
}
