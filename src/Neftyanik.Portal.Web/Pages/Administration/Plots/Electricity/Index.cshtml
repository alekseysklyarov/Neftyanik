@page "/Administration/Plots/{plotId:int}/Electricity"
@model Neftyanik.Portal.Web.Pages.Administration.Plots.Electricity.IndexModel
@{
    ViewData["Title"] = $"Электроэнергия участка {Model.Plot.PlotNumber}";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">Электроэнергия участка @Model.Plot.PlotNumber</h1>
        <p class="text-muted mb-0">История показаний и начислений по электроэнергии.</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        @if (Model.HasHistory)
        {
            <a class="btn btn-primary" asp-page="/Administration/Plots/Electricity/Create" asp-route-plotId="@Model.Plot.PlotId">Внести новые показания</a>
        }
        <a class="btn btn-outline-secondary" asp-page="/Administration/Plots/Finance/Index" asp-route-plotId="@Model.Plot.PlotId">Назад к финансам участка</a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        @if (Model.Readings.Count == 0)
        {
            <div class="p-4 text-center text-muted">История показаний по электроэнергии пока отсутствует.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Дата</th>
                            <th>Тип записи</th>
                            <th>День: показание</th>
                            <th>День: расход</th>
                            <th>Ночь: показание</th>
                            <th>Ночь: расход</th>
                            <th>Дневной тариф</th>
                            <th>Ночной тариф</th>
                            <th>Начислено</th>
                            <th>Статус начисления</th>
                            <th class="text-end">Ссылка</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var reading in Model.Readings)
                        {
                            <tr>
                                <td>@reading.ReadingDate.ToString("dd.MM.yyyy")</td>
                                <td>@reading.EntryTypeText</td>
                                <td>@reading.CurrentDayReading.ToString("0.000") кВт·ч</td>
                                <td>@(reading.DayConsumption.HasValue ? $"{reading.DayConsumption.Value:0.000} кВт·ч" : "—")</td>
                                <td>@reading.CurrentNightReading.ToString("0.000") кВт·ч</td>
                                <td>@(reading.NightConsumption.HasValue ? $"{reading.NightConsumption.Value:0.000} кВт·ч" : "—")</td>
                                <td>@(reading.DayRate.HasValue ? $"{reading.DayRate.Value:0.0000} грн/кВт·ч" : "—")</td>
                                <td>@(reading.NightRate.HasValue ? $"{reading.NightRate.Value:0.0000} грн/кВт·ч" : "—")</td>
                                <td>@(reading.TotalAmount.HasValue ? $"{reading.TotalAmount.Value:0.00} грн" : "—")</td>
                                <td>@reading.ChargeStatusText</td>
                                <td class="text-end">
                                    @if (reading.ChargeId.HasValue)
                                    {
                                        <a class="btn btn-sm btn-outline-primary" asp-page="/Administration/Plots/Finance/Index" asp-route-plotId="@Model.Plot.PlotId" asp-fragment="charges">К начислению</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav aria-label="Навигация по истории показаний" class="mt-4">
        <ul class="pagination justify-content-center flex-wrap">
            <li class="page-item @(Model.HasPreviousPage ? string.Empty : "disabled")">
                <a class="page-link" asp-page="/Administration/Plots/Electricity/Index" asp-route-plotId="@Model.Plot.PlotId" asp-route-pageNumber="@(Model.PageNumber - 1)">Назад</a>
            </li>
            @for (var pageIndex = 1; pageIndex <= Model.TotalPages; pageIndex++)
            {
                <li class="page-item @(pageIndex == Model.PageNumber ? "active" : string.Empty)">
                    <a class="page-link" asp-page="/Administration/Plots/Electricity/Index" asp-route-plotId="@Model.Plot.PlotId" asp-route-pageNumber="@pageIndex">@pageIndex</a>
                </li>
            }
            <li class="page-item @(Model.HasNextPage ? string.Empty : "disabled")">
                <a class="page-link" asp-page="/Administration/Plots/Electricity/Index" asp-route-plotId="@Model.Plot.PlotId" asp-route-pageNumber="@(Model.PageNumber + 1)">Вперед</a>
            </li>
        </ul>
    </nav>
}
