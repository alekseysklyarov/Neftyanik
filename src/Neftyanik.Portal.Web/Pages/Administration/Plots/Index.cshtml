@page
@model Neftyanik.Portal.Web.Pages.Administration.Plots.IndexModel
@{
    ViewData["WideLayout"] = true;
    ViewData["Title"] = AppLocalizer.Get("Участки", "Ділянки", "Plots");
    var isAdministrator = User.IsInRole(RoleNames.Administrator);
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">@AppLocalizer.Get("Участки", "Ділянки", "Plots")</h1>
        <p class="text-muted mb-0">@AppLocalizer.Get("Список участков товарищества.", "Список ділянок товариства.", "List of association plots.")</p>
    </div>
    @if (isAdministrator)
    {
        <div>
            <a class="btn btn-primary" asp-page="/Administration/Plots/Create">@AppLocalizer.Get("Добавить участок", "Додати ділянку", "Add plot")</a>
        </div>
    }
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="alert">@successMessage</div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="plot-list-filters">
            <input asp-for="SortBy" type="hidden" />
            <input asp-for="SortDirection" type="hidden" />
            <div class="col-md-6 col-xl-4">
                <label asp-for="Search" class="form-label">@AppLocalizer.Get("Поиск", "Пошук", "Search")</label>
                <input asp-for="Search" class="form-control" placeholder="@AppLocalizer.Get("Номер, адрес, кадастровый номер или владелец", "Номер, адреса, кадастровий номер або власник", "Number, address, cadastral number, or owner")" />
            </div>
            <div class="col-md-6 col-xl-2">
                <label asp-for="Status" class="form-label">@AppLocalizer.Get("Статус участка", "Статус ділянки", "Plot status")</label>
                <select asp-for="Status" class="form-select">
                    <option value="all">@AppLocalizer.Get("Все", "Усі", "All")</option>
                    <option value="active">@AppLocalizer.Get("Только активные", "Лише активні", "Active only")</option>
                    <option value="archived">@AppLocalizer.Get("Только архивные", "Лише архівні", "Archived only")</option>
                </select>
            </div>
            <div class="col-md-6 col-xl-3">
                <label asp-for="Ownership" class="form-label">@AppLocalizer.Get("Владельцы", "Власники", "Owners")</label>
                <select asp-for="Ownership" class="form-select">
                    <option value="all">@AppLocalizer.Get("Все участки", "Усі ділянки", "All plots")</option>
                    <option value="withowners">@AppLocalizer.Get("Только с текущими владельцами", "Лише з поточними власниками", "With current owners only")</option>
                    <option value="withoutowners">@AppLocalizer.Get("Только без текущих владельцев", "Лише без поточних власників", "Without current owners only")</option>
                </select>
            </div>
            <div class="col-md-6 col-xl-3">
                <label asp-for="FinancialStatus" class="form-label">@AppLocalizer.Get("Финансовый статус", "Фінансовий статус", "Financial status") *</label>
                <select asp-for="FinancialStatus" class="form-select">
                    <option value="all">@AppLocalizer.Get("Все", "Усі", "All")</option>
                    <option value="debt">@AppLocalizer.Get("С задолженностью", "Із заборгованістю", "With debt")</option>
                    <option value="nodebt">@AppLocalizer.Get("С нулевым балансом", "З нульовим балансом", "Zero balance")</option>
                    <option value="overpayment">@AppLocalizer.Get("С переплатой", "З переплатою", "With overpayment")</option>
                </select>
            </div>
            <div class="d-flex gap-2 plot-filter-actions">
                <button type="submit" class="btn btn-outline-primary">@AppLocalizer.Get("Найти", "Знайти", "Search")</button>
                <a class="btn btn-outline-secondary" asp-page="/Administration/Plots/Index">@AppLocalizer.Get("Сбросить", "Скинути", "Reset")</a>
            </div>
        </form>
    </div>
</div>

<p class="text-muted small">* @AppLocalizer.Get("Только ежегодный платёж, без учёта электроэнергии и других платежей. Оплачено — сумма, зачтённая в ежегодные начисления; нераспределённый аванс не учитывается.", "Лише щорічний платіж, без урахування електроенергії та інших платежів. Сплачено — сума, зарахована в щорічні нарахування; нерозподілений аванс не враховується.", "Annual fees only, excluding electricity and other payments. Paid shows amounts allocated to annual charges; unallocated advances are excluded.")</p>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="d-flex justify-content-between align-items-center px-3 pt-3 text-muted small">
            <span>@AppLocalizer.Get("Количество записей", "Кількість записів", "Record count"): @Model.TotalCount</span>
        </div>
        @if (Model.Plots.Count == 0)
        {
            <div class="p-4 text-center text-muted">
                @Model.EmptyStateMessage
            </div>
        }
        else
        {
            <form method="post" asp-page-handler="CreateCharges" id="bulk-charge-form">
                <input asp-for="Search" type="hidden" />
                <input asp-for="Status" type="hidden" />
                <input asp-for="Ownership" type="hidden" />
                <input asp-for="FinancialStatus" type="hidden" />
                <input asp-for="SortBy" type="hidden" />
                <input asp-for="SortDirection" type="hidden" />
                <input asp-for="PageNumber" type="hidden" />
                <div id="bulk-charge-selected-plot-inputs"></div>

                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 p-3 border-bottom">
                    <div>
                        <h2 class="h5 mb-1">@AppLocalizer.Get("Список участков", "Список ділянок", "Plot list")</h2>
                        <p class="small text-muted mb-0">@AppLocalizer.Get("Для начисления доступны только активные участки с текущими владельцами.", "Для нарахування доступні лише активні ділянки з поточними власниками.", "Only active plots with current owners are available for charges.")</p>
                    </div>
                    <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#bulkChargeModal">@AppLocalizer.Get("Начислить выбранным", "Нарахувати вибраним", "Charge selected")</button>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 plot-list-table">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 1%;">
                                    <div class="form-check mb-0">
                                        <input class="form-check-input" type="checkbox" id="select-all-plots" aria-label="@AppLocalizer.Get("Выбрать все участки", "Вибрати всі ділянки", "Select all plots")" />
                                    </div>
                                </th>
                                <th>
                                    <a class="text-decoration-none link-dark" asp-page="/Administration/Plots/Index" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-ownership="@Model.Ownership" asp-route-financialStatus="@Model.FinancialStatus" asp-route-sortBy="number" asp-route-sortDirection="@Model.GetNextSortDirection("number")">@AppLocalizer.Get("Номер", "Номер", "Number") @Model.GetSortIndicator("number")</a>
                                </th>
                                <th>
                                    <a class="text-decoration-none link-dark" asp-page="/Administration/Plots/Index" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-ownership="@Model.Ownership" asp-route-financialStatus="@Model.FinancialStatus" asp-route-sortBy="address" asp-route-sortDirection="@Model.GetNextSortDirection("address")">@AppLocalizer.Get("Адрес", "Адреса", "Address") @Model.GetSortIndicator("address")</a>
                                    <div class="small mt-1"><a class="text-decoration-none link-secondary" asp-page="/Administration/Plots/Index" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-ownership="@Model.Ownership" asp-route-financialStatus="@Model.FinancialStatus" asp-route-sortBy="cadastral" asp-route-sortDirection="@Model.GetNextSortDirection("cadastral")">@AppLocalizer.Get("Кадастровый номер", "Кадастровий номер", "Cadastral number") @Model.GetSortIndicator("cadastral")</a></div>
                                </th>
                                <th>
                                    <a class="text-decoration-none link-dark" asp-page="/Administration/Plots/Index" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-ownership="@Model.Ownership" asp-route-financialStatus="@Model.FinancialStatus" asp-route-sortBy="area" asp-route-sortDirection="@Model.GetNextSortDirection("area")">@AppLocalizer.Get("Площадь, соток", "Площа, соток", "Area, соток") @Model.GetSortIndicator("area")</a>
                                </th>
                                <th>
                                    <a class="text-decoration-none link-dark" asp-page="/Administration/Plots/Index" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-ownership="@Model.Ownership" asp-route-financialStatus="@Model.FinancialStatus" asp-route-sortBy="status" asp-route-sortDirection="@Model.GetNextSortDirection("status")">@AppLocalizer.Get("Статус", "Статус", "Status") @Model.GetSortIndicator("status")</a>
                                </th>
                                <th>
                                    <a class="text-decoration-none link-dark" asp-page="/Administration/Plots/Index" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-ownership="@Model.Ownership" asp-route-financialStatus="@Model.FinancialStatus" asp-route-sortBy="owner" asp-route-sortDirection="@Model.GetNextSortDirection("owner")">@AppLocalizer.Get("Владелец", "Власник", "Owner") @Model.GetSortIndicator("owner")</a>
                                </th>
                                <th class="text-end">@AppLocalizer.Get("Начислено / оплачено", "Нараховано / сплачено", "Charged / paid") *</th>
                                <th class="text-end">@AppLocalizer.Get("Баланс / финансовый статус", "Баланс / фінансовий статус", "Balance / financial status") *</th>
                                <th class="text-end">@AppLocalizer.Get("Действия", "Дії", "Actions")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var plot in Model.Plots)
                            {
                                <tr>
                                    <td>
                                        @if (plot.CanCreateCharge)
                                        {
                                            @if (Model.ChargeInput.SelectedPlotIds.Contains(plot.Id))
                                            {
                                                <input class="form-check-input" type="checkbox" name="ChargeInput.SelectedPlotIds" value="@plot.Id" checked aria-label="@AppLocalizer.Get($"Выбрать участок {plot.Number}", $"Вибрати ділянку {plot.Number}", $"Select plot {plot.Number}")" />
                                            }
                                            else
                                            {
                                                <input class="form-check-input" type="checkbox" name="ChargeInput.SelectedPlotIds" value="@plot.Id" aria-label="@AppLocalizer.Get($"Выбрать участок {plot.Number}", $"Вибрати ділянку {plot.Number}", $"Select plot {plot.Number}")" />
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td class="fw-semibold">@plot.Number</td>
                                    <td>
                                        <div>@(string.IsNullOrWhiteSpace(plot.Address) ? "—" : plot.Address)</div>
                                        @if (!string.IsNullOrWhiteSpace(plot.CadastralNumber))
                                        {
                                            <div class="small text-muted text-break">@AppLocalizer.Get("Кадастр:", "Кадастр:", "Cadastre:") @plot.CadastralNumber</div>
                                        }
                                    </td>
                                    <td>@(plot.AreaSquareMeters.HasValue ? plot.AreaSquareMeters.Value.ToString("0.###") : "—")</td>
                                    <td>
                                        @if (!plot.IsActive)
                                        {
                                            <span class="member-status member-status-archived">@AppLocalizer.Get("Аннулировано", "Анульовано", "Cancelled")</span>
                                        }
                                        else
                                        {
                                            <span class="member-status member-status-active">@AppLocalizer.Get("Активен", "Активна", "Active")</span>
                                        }
                                    </td>
                                    <td>
                                        @if (plot.OwnerMemberId.HasValue && !string.IsNullOrWhiteSpace(plot.OwnerFullName))
                                        {
                                            <a asp-page="/Administration/Members/Details" asp-route-id="@plot.OwnerMemberId.Value">@plot.OwnerFullName</a>
                                        }
                                        else
                                        {
                                            <div class="text-muted">—</div>
                                        }
                                        @if (!plot.CanCreateCharge)
                                        {
                                            <div class="small text-muted">@AppLocalizer.Get("Начисление недоступно", "Нарахування недоступне", "Charge unavailable")</div>
                                        }
                                    </td>
                                    <td class="text-nowrap text-end">
                                        <div><span class="small text-muted">@AppLocalizer.Get("Начислено:", "Нараховано:", "Charged:")</span> @plot.Charges.ToString("0.00") ₴</div>
                                        <div><span class="small text-muted">@AppLocalizer.Get("Оплачено:", "Сплачено:", "Paid:")</span> @plot.Payments.ToString("0.00") ₴</div>
                                    </td>
                                    <td class="text-end">
                                        <div class="fw-semibold text-nowrap @plot.BalanceCssClass">@plot.BalanceDisplayAmount.ToString("0.00") ₴</div>
                                        <div class="small @plot.BalanceCssClass">@plot.FinancialStatusText</div>
                                    </td>
                                    <td class="text-end">
                                        <div class="member-list-actions">
                                            <a class="btn btn-sm btn-outline-secondary" asp-page="/Administration/Plots/Details" asp-route-id="@plot.Id">@AppLocalizer.Get("Подробнее", "Детальніше", "Details")</a>
                                            @if (isAdministrator)
                                            {
                                                <details class="member-more-actions">
                                                    <summary class="btn btn-sm btn-outline-secondary">@AppLocalizer.Get("Ещё", "Ще", "More")</summary>
                                                    <div class="member-more-links">
                                                        <a asp-page="/Administration/Plots/Edit" asp-route-id="@plot.Id">@AppLocalizer.Get("Редактировать", "Редагувати", "Edit")</a>
                                                        <a asp-page="/Administration/Plots/Archive" asp-route-id="@plot.Id">@(plot.IsActive ? AppLocalizer.Get("Архивировать", "Архівувати", "Archive") : AppLocalizer.Get("Восстановить", "Відновити", "Restore"))</a>
                                                    </div>
                                                </details>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="modal fade" id="bulkChargeModal" tabindex="-1" aria-labelledby="bulkChargeModalLabel" aria-hidden="true">
                    <div class="modal-dialog modal-lg modal-dialog-scrollable">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h2 class="modal-title h5" id="bulkChargeModalLabel">@AppLocalizer.Get("Начисление по выбранным участкам", "Нарахування за вибраними ділянками", "Charge selected plots")</h2>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@AppLocalizer.Get("Закрыть", "Закрити", "Close")"></button>
                            </div>
                            <div class="modal-body">
                                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                                <div class="mb-3">
                                    <div class="fw-semibold">@AppLocalizer.Get("Выбранные участки", "Вибрані ділянки", "Selected plots")</div>
                                    <div id="bulk-charge-selected-count" class="text-muted small mb-2"></div>
                                    <ul id="bulk-charge-selected-plots" class="mb-0 ps-3"></ul>
                                    <span asp-validation-for="ChargeInput.SelectedPlotIds" class="text-danger"></span>
                                </div>

                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label asp-for="ChargeInput.ChargeTypeId" class="form-label">@AppLocalizer.Get("Тип начисления", "Тип нарахування", "Charge type")</label>
                                        @if (Model.HasSingleChargeType)
                                        {
                                            <input type="hidden" asp-for="ChargeInput.ChargeTypeId" />
                                            <input class="form-control" value="@Model.SingleChargeTypeText" readonly />
                                        }
                                        else
                                        {
                                            <select asp-for="ChargeInput.ChargeTypeId" asp-items="Model.ChargeTypeOptions" class="form-select">
                                                <option value="">@AppLocalizer.Get("Выберите тип начисления", "Виберіть тип нарахування", "Select charge type")</option>
                                            </select>
                                        }
                                        <span asp-validation-for="ChargeInput.ChargeTypeId" class="text-danger"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="ChargeInput.Amount" class="form-label">@AppLocalizer.Get("Сумма, грн", "Сума, грн", "Amount, UAH")</label>
                                        <input class="form-control" id="charge-amount-display" value="@(Model.ChargeInput.Amount.HasValue ? $"{Model.ChargeInput.Amount.Value:0.00} грн" : string.Empty)" readonly />
                                        <span asp-validation-for="ChargeInput.Amount" class="text-danger"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="ChargeInput.ChargeDate" class="form-label">@AppLocalizer.Get("Дата начисления", "Дата нарахування", "Charge date")</label>
                                        <input class="form-control" value="@Model.CurrentChargeDateDisplay" readonly />
                                        <span asp-validation-for="ChargeInput.ChargeDate" class="text-danger"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="ChargeInput.DueDate" class="form-label">@AppLocalizer.Get("Срок оплаты", "Строк оплати", "Due date")</label>
                                        <input asp-for="ChargeInput.DueDate" class="form-control" type="date" />
                                        <span asp-validation-for="ChargeInput.DueDate" class="text-danger"></span>
                                    </div>
                                    <div class="col-12">
                                        <label asp-for="ChargeInput.Description" class="form-label">@AppLocalizer.Get("Описание", "Опис", "Description")</label>
                                        <textarea asp-for="ChargeInput.Description" class="form-control" rows="3"></textarea>
                                        <span asp-validation-for="ChargeInput.Description" class="text-danger"></span>
                                    </div>
                                    <div class="col-12">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="confirm-bulk-charge" required />
                                            <label class="form-check-label" for="confirm-bulk-charge">
                                                @AppLocalizer.Get("Подтверждаю создание начислений для всех выбранных участков.", "Підтверджую створення нарахувань для всіх вибраних ділянок.", "I confirm creating charges for all selected plots.")
                                            </label>
                                            <div class="invalid-feedback d-block" id="confirm-bulk-charge-validation" hidden>
                                                @AppLocalizer.Get("Подтвердите создание начислений.", "Підтвердьте створення нарахувань.", "Confirm the charge creation.")
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@AppLocalizer.Get("Отмена", "Скасувати", "Cancel")</button>
                                <button type="submit" class="btn btn-primary" id="submit-bulk-charge">@AppLocalizer.Get("Создать начисления", "Створити нарахування", "Create charges")</button>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        }
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav aria-label="@AppLocalizer.Get("Навигация по страницам", "Навігація сторінками", "Pagination")" class="mt-4">
        <ul class="pagination justify-content-center flex-wrap">
            <li class="page-item @(Model.HasPreviousPage ? string.Empty : "disabled")">
                <a class="page-link"
                   asp-page="/Administration/Plots/Index"
                   asp-route-search="@Model.Search"
                   asp-route-status="@Model.Status"
                   asp-route-ownership="@Model.Ownership" asp-route-financialStatus="@Model.FinancialStatus"
                   asp-route-sortBy="@Model.SortBy"
                   asp-route-sortDirection="@Model.SortDirection"
                   asp-route-pageNumber="@(Model.PageNumber - 1)">@AppLocalizer.Get("Назад", "Назад", "Previous")</a>
            </li>
            @for (var pageIndex = 1; pageIndex <= Model.TotalPages; pageIndex++)
            {
                <li class="page-item @(pageIndex == Model.PageNumber ? "active" : string.Empty)">
                    <a class="page-link"
                       asp-page="/Administration/Plots/Index"
                       asp-route-search="@Model.Search"
                       asp-route-status="@Model.Status"
                       asp-route-ownership="@Model.Ownership" asp-route-financialStatus="@Model.FinancialStatus"
                       asp-route-sortBy="@Model.SortBy"
                       asp-route-sortDirection="@Model.SortDirection"
                       asp-route-pageNumber="@pageIndex">@pageIndex</a>
                </li>
            }
            <li class="page-item @(Model.HasNextPage ? string.Empty : "disabled")">
                <a class="page-link"
                   asp-page="/Administration/Plots/Index"
                   asp-route-search="@Model.Search"
                   asp-route-status="@Model.Status"
                   asp-route-ownership="@Model.Ownership" asp-route-financialStatus="@Model.FinancialStatus"
                   asp-route-sortBy="@Model.SortBy"
                   asp-route-sortDirection="@Model.SortDirection"
                   asp-route-pageNumber="@(Model.PageNumber + 1)">@AppLocalizer.Get("Вперёд", "Вперед", "Next")</a>
            </li>
        </ul>
    </nav>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const maxSelectedPlotsToDisplay = 5;
            const plotsNotSelectedText = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(AppLocalizer.Get("Участки не выбраны.", "Ділянки не вибрано.", "No plots selected.")));
            const selectAtLeastOnePlotText = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(AppLocalizer.Get("Выберите хотя бы один участок в списке.", "Виберіть хоча б одну ділянку у списку.", "Select at least one plot from the list.")));
            const selectedPlotsCountText = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(AppLocalizer.Get("Выбрано участков", "Вибрано ділянок", "Selected plots")));
            const plotText = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(AppLocalizer.Get("Участок", "Ділянка", "Plot")));
            const moreSelectedPlotsText = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(AppLocalizer.Get("и ещё", "і ще", "and")));
            const selectAllCheckbox = document.getElementById('select-all-plots');
            const modalElement = document.getElementById('bulkChargeModal');
            const selectedPlotsList = document.getElementById('bulk-charge-selected-plots');
            const selectedPlotsCount = document.getElementById('bulk-charge-selected-count');
            const submitBulkChargeButton = document.getElementById('submit-bulk-charge');
            const confirmBulkChargeCheckbox = document.getElementById('confirm-bulk-charge');
            const confirmBulkChargeValidation = document.getElementById('confirm-bulk-charge-validation');
            const chargeTypeSelect = document.getElementById('ChargeInput_ChargeTypeId');
            const chargeAmountDisplay = document.getElementById('charge-amount-display');
            const chargeTypeDefaultAmounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChargeTypeDefaultAmounts));
            const allSelectablePlots = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SelectablePlots.Select(plot => new { id = plot.Id, number = plot.Number })));
            const initiallySelectedPlotIds = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChargeInput.SelectedPlotIds));

            if (!selectAllCheckbox) {
                return;
            }

            const selectedPlotInputsContainer = document.getElementById('bulk-charge-selected-plot-inputs');
            const plotCheckboxes = Array.from(document.querySelectorAll('input[name="ChargeInput.SelectedPlotIds"]'));
            const visiblePlotCheckboxesById = new Map(plotCheckboxes.map(checkbox => [Number(checkbox.value), checkbox]));
            const selectablePlotsById = new Map(allSelectablePlots.map(plot => [Number(plot.id), plot]));
            const selectedPlotIds = new Set(initiallySelectedPlotIds.map(id => Number(id)).filter(id => selectablePlotsById.has(id)));

            const syncVisibleCheckboxes = () => {
                for (const checkbox of plotCheckboxes) {
                    checkbox.checked = selectedPlotIds.has(Number(checkbox.value));
                }
            };

            const syncHiddenSelectedPlotInputs = () => {
                if (!selectedPlotInputsContainer) {
                    return;
                }

                selectedPlotInputsContainer.innerHTML = '';

                const sortedSelectedPlotIds = Array.from(selectedPlotIds).sort((left, right) => left - right);
                for (const plotId of sortedSelectedPlotIds) {
                    const visibleCheckbox = visiblePlotCheckboxesById.get(plotId);
                    if (visibleCheckbox?.checked) {
                        continue;
                    }

                    const input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = 'ChargeInput.SelectedPlotIds';
                    input.value = String(plotId);
                    selectedPlotInputsContainer.appendChild(input);
                }
            };

            const updateSelectAllState = () => {
                const selectedCount = selectedPlotIds.size;
                const selectableCount = allSelectablePlots.length;
                selectAllCheckbox.checked = selectableCount > 0 && selectedCount === selectableCount;
                selectAllCheckbox.indeterminate = selectedCount > 0 && selectedCount < selectableCount;
            };

            const getSelectedPlots = () => Array.from(selectedPlotIds)
                .map(plotId => selectablePlotsById.get(plotId))
                .filter(plot => plot)
                .sort((left, right) => left.number.localeCompare(right.number, undefined, { numeric: true, sensitivity: 'base' }));

            const updateBulkChargeSummary = () => {
                if (!selectedPlotsList || !selectedPlotsCount || !submitBulkChargeButton) {
                    return;
                }

                const selectedPlots = getSelectedPlots();
                selectedPlotsList.innerHTML = '';

                if (selectedPlots.length === 0) {
                    selectedPlotsCount.textContent = plotsNotSelectedText;
                    const item = document.createElement('li');
                    item.textContent = selectAtLeastOnePlotText;
                    selectedPlotsList.appendChild(item);
                    submitBulkChargeButton.disabled = true;
                    return;
                }

                selectedPlotsCount.textContent = `${selectedPlotsCountText}: ${selectedPlots.length}.`;
                submitBulkChargeButton.disabled = false;

                for (const plot of selectedPlots.slice(0, maxSelectedPlotsToDisplay)) {
                    const item = document.createElement('li');
                    item.textContent = plot.number || plotText;
                    selectedPlotsList.appendChild(item);
                }

                if (selectedPlots.length > maxSelectedPlotsToDisplay) {
                    const item = document.createElement('li');
                    item.className = 'text-muted';
                    item.textContent = `${moreSelectedPlotsText} ${selectedPlots.length - maxSelectedPlotsToDisplay}.`;
                    selectedPlotsList.appendChild(item);
                }
            };

            const resetConfirmationState = () => {
                if (!confirmBulkChargeCheckbox || !confirmBulkChargeValidation) {
                    return;
                }

                confirmBulkChargeCheckbox.checked = false;
                confirmBulkChargeValidation.hidden = true;
            };

            const updateChargeAmount = () => {
                if (!chargeAmountDisplay) {
                    return;
                }

                const selectedChargeTypeId = chargeTypeSelect ? chargeTypeSelect.value : chargeTypeSelect;
                const selectedAmount = selectedChargeTypeId && chargeTypeDefaultAmounts[selectedChargeTypeId] !== undefined
                    ? chargeTypeDefaultAmounts[selectedChargeTypeId]
                    : null;

                if (selectedAmount === null || selectedAmount === undefined) {
                    chargeAmountDisplay.value = '';
                    return;
                }

                const normalizedAmount = Number(selectedAmount).toFixed(2);
                chargeAmountDisplay.value = `${normalizedAmount} грн`;
            };

            selectAllCheckbox.addEventListener('change', () => {
                selectedPlotIds.clear();

                if (selectAllCheckbox.checked) {
                    for (const plot of allSelectablePlots) {
                        selectedPlotIds.add(Number(plot.id));
                    }
                }

                syncVisibleCheckboxes();
                syncHiddenSelectedPlotInputs();
                updateSelectAllState();
                updateBulkChargeSummary();
            });

            for (const checkbox of plotCheckboxes) {
                checkbox.addEventListener('change', () => {
                    const plotId = Number(checkbox.value);

                    if (checkbox.checked) {
                        selectedPlotIds.add(plotId);
                    } else {
                        selectedPlotIds.delete(plotId);
                    }

                    syncHiddenSelectedPlotInputs();
                    updateSelectAllState();
                    updateBulkChargeSummary();
                });
            }

            if (modalElement) {
                modalElement.addEventListener('show.bs.modal', () => {
                    updateBulkChargeSummary();
                    updateChargeAmount();
                    resetConfirmationState();
                });
            }

            if (chargeTypeSelect) {
                chargeTypeSelect.addEventListener('change', updateChargeAmount);
            }

            const bulkChargeForm = document.getElementById('bulk-charge-form');
            if (bulkChargeForm) {
                bulkChargeForm.addEventListener('submit', (event) => {
                    syncHiddenSelectedPlotInputs();
                    updateBulkChargeSummary();

                    if (submitBulkChargeButton && submitBulkChargeButton.disabled) {
                        event.preventDefault();
                        return;
                    }

                    if (confirmBulkChargeCheckbox && !confirmBulkChargeCheckbox.checked) {
                        event.preventDefault();
                        confirmBulkChargeValidation.hidden = false;
                    }
                });
            }

            syncVisibleCheckboxes();
            syncHiddenSelectedPlotInputs();
            updateSelectAllState();
            updateBulkChargeSummary();
            updateChargeAmount();

            @if (Model.ReopenChargeModal)
            {
                <text>
                if (modalElement && window.bootstrap) {
                    window.bootstrap.Modal.getOrCreateInstance(modalElement).show();
                }
                </text>
            }
        })();
    </script>
}
