@page "/Administration/Plots/{plotId:int}/Ownerships/{id:int}/End"
@model Neftyanik.Portal.Web.Pages.Administration.Plots.Ownerships.EndModel
@{
    ViewData["Title"] = "Аннулирование владения";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h3 mb-3">Аннулирование владения</h1>

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <p>Вы собираетесь аннулировать запись владения. Запись останется в системе и будет перенесена в историю.</p>

                <dl class="row mb-4">
                    <dt class="col-sm-4">Участок</dt>
                    <dd class="col-sm-8">@Model.Plot.PlotNumber</dd>

                    <dt class="col-sm-4">Член товарищества</dt>
                    <dd class="col-sm-8">@Model.Ownership.MemberFullName</dd>

                    <dt class="col-sm-4">Дата начала</dt>
                    <dd class="col-sm-8">@(Model.Ownership.ValidFrom.HasValue ? Model.Ownership.ValidFrom.Value.ToString("dd.MM.yyyy") : "—")</dd>
                </dl>

                <form method="post">
                    <div class="mb-3">
                        <label asp-for="Input.ValidTo" class="form-label"></label>
                        <input asp-for="Input.ValidTo" class="form-control" type="date" />
                        <span asp-validation-for="Input.ValidTo" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2 flex-wrap">
                        <button type="submit" class="btn btn-warning">Подтвердить аннулирование</button>
                        <a class="btn btn-outline-secondary" asp-page="/Administration/Plots/Ownerships/Index" asp-route-plotId="@Model.Plot.PlotId">Отмена</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
