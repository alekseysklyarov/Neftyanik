@page "/Administration/Plots/{plotId:int}/Ownerships/Create"
@model Neftyanik.Portal.Web.Pages.Administration.Plots.Ownerships.CreateModel
@{
    ViewData["Title"] = $"Добавление владельца к участку {Model.Plot.PlotNumber}";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">Добавление владельца</h1>
        <p class="text-muted mb-0">Участок @Model.Plot.PlotNumber</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a class="btn btn-outline-secondary" asp-page="/Administration/Plots/Ownerships/Index" asp-route-plotId="@Model.Plot.PlotId">К списку владельцев</a>
        <a class="btn btn-outline-secondary" asp-page="/Administration/Plots/Details" asp-route-id="@Model.Plot.PlotId">К участку</a>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <p class="mb-2"><strong>Адрес:</strong> @(string.IsNullOrWhiteSpace(Model.Plot.PlotAddress) ? "—" : Model.Plot.PlotAddress)</p>
        <p class="mb-0"><strong>Статус владения:</strong> @(Model.Plot.ActiveOwnersCount > 0 ? "Активный" : "Свободен")</p>
    </div>
</div>

@if (Model.Plot.HasOpenOwnership)
{
    <div class="alert alert-warning" role="alert">
        У участка уже есть владелец. Сначала аннулируйте текущее владение, затем можно назначить нового.
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-12">
                        <label for="member-option-search" class="form-label">Поиск члена товарищества</label>
                        <input type="text" id="member-option-search" class="form-control mb-2" placeholder="Начните вводить ФИО, телефон или email" autocomplete="off" />
                        <label asp-for="Input.MemberId" class="form-label"></label>
                        <select asp-for="Input.MemberId" asp-items="Model.MemberOptions" class="form-select">
                            <option value="">Выберите члена товарищества</option>
                        </select>
                        <span asp-validation-for="Input.MemberId" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Input.ValidFrom" class="form-label"></label>
                        <input asp-for="Input.ValidFrom" class="form-control" type="date" />
                        <span asp-validation-for="Input.ValidFrom" class="text-danger"></span>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary">Сохранить</button>
                    <a class="btn btn-outline-secondary" asp-page="/Administration/Plots/Ownerships/Index" asp-route-plotId="@Model.Plot.PlotId">Отмена</a>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const searchInput = document.getElementById('member-option-search');
            const memberSelect = document.getElementById('Input_MemberId');

            if (!searchInput || !memberSelect) {
                return;
            }

            const noResultsText = 'Ничего не найдено';
            const originalOptions = Array.from(memberSelect.options).map(option => ({
                value: option.value,
                text: option.text,
                selected: option.selected,
                disabled: option.disabled
            }));

            const renderOptions = () => {
                const searchValue = searchInput.value.trim().toLowerCase();
                const selectedValue = memberSelect.value;
                const filteredOptions = originalOptions.filter(option => option.value === ''
                    || option.value === selectedValue
                    || option.text.toLowerCase().includes(searchValue));

                memberSelect.innerHTML = '';

                for (const optionData of filteredOptions) {
                    const option = document.createElement('option');
                    option.value = optionData.value;
                    option.text = optionData.text;
                    option.disabled = optionData.disabled;
                    option.selected = optionData.value === selectedValue || (!selectedValue && optionData.selected);
                    memberSelect.appendChild(option);
                }

                const hasMatchedMembers = filteredOptions.some(option => option.value !== '');
                if (!hasMatchedMembers) {
                    const option = document.createElement('option');
                    option.value = '';
                    option.text = noResultsText;
                    option.disabled = true;
                    memberSelect.appendChild(option);
                }
            };

            searchInput.addEventListener('input', renderOptions);
        })();
    </script>
}
