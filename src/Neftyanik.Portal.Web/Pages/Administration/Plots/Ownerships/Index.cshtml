@page "/Administration/Plots/{plotId:int}/Ownerships"
@model Neftyanik.Portal.Web.Pages.Administration.Plots.Ownerships.IndexModel
@{
    ViewData["Title"] = $"Владельцы участка {Model.Plot.PlotNumber}";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">Владельцы участка @Model.Plot.PlotNumber</h1>
        <p class="text-muted mb-0">Управление текущими и завершёнными записями владения.</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        @if (!Model.Plot.HasOpenOwnership)
        {
            <a class="btn btn-primary" asp-page="/Administration/Plots/Ownerships/Create" asp-route-plotId="@Model.Plot.PlotId">Добавить владельца</a>
        }
        <a class="btn btn-outline-secondary" asp-page="/Administration/Plots/Details" asp-route-id="@Model.Plot.PlotId">К участку</a>
        <a class="btn btn-outline-secondary" asp-page="/Administration/Plots/Index">К списку участков</a>
    </div>
</div>

@if (Model.Plot.HasOpenOwnership)
{
    <div class="alert alert-info" role="alert">
        У участка может быть только один владелец. Чтобы назначить нового, сначала завершите текущее владение.
    </div>
}

<div class="row g-4 mb-4">
    <div class="col-lg-4">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h2 class="h5 mb-3">Сведения об участке</h2>
                <dl class="row mb-0">
                    <dt class="col-sm-4">Номер</dt>
                    <dd class="col-sm-8">@Model.Plot.PlotNumber</dd>

                    <dt class="col-sm-4">Адрес</dt>
                    <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Plot.PlotAddress) ? "—" : Model.Plot.PlotAddress)</dd>

                    <dt class="col-sm-4">Статус</dt>
                    <dd class="col-sm-8">
                        @if (Model.Plot.PlotIsActive)
                        {
                            <span class="badge text-bg-success">Активен</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">В архиве</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h2 class="h5 mb-3">Текущие владельцы</h2>
                <p class="mb-2"><strong>Количество:</strong> @Model.Plot.ActiveOwnersCount</p>
                <p class="mb-0 text-muted">У участка может быть только один текущий владелец.</p>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card shadow-sm h-100">
            <div class="card-body d-flex flex-column">
                <h2 class="h5 mb-3">История владения</h2>
                <p class="text-muted flex-grow-1 mb-0">Здесь отображаются как активные владельцы, так и завершённые записи владения участком.</p>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-white">
        <h2 class="h5 mb-0">Текущие владельцы</h2>
    </div>
    <div class="card-body p-0">
        @if (Model.CurrentOwnerships.Count == 0)
        {
            <div class="p-4 text-center text-muted">Для участка пока нет активных владельцев.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Член товарищества</th>
                            <th>Телефон</th>
                            <th>Электронная почта</th>
                            <th>Действует с</th>
                            <th>Статус</th>
                            <th class="text-end">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ownership in Model.CurrentOwnerships)
                        {
                            <tr>
                                <td>
                                    <a asp-page="/Administration/Members/Details" asp-route-id="@ownership.MemberId">@ownership.MemberFullName</a>
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(ownership.MemberPhoneNumber) ? "—" : ownership.MemberPhoneNumber)</td>
                                <td>@(string.IsNullOrWhiteSpace(ownership.MemberEmail) ? "—" : ownership.MemberEmail)</td>
                                <td>@(ownership.ValidFrom.HasValue ? ownership.ValidFrom.Value.ToString("dd.MM.yyyy") : "—")</td>
                                <td><span class="badge text-bg-success">Активный</span></td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a class="btn btn-outline-success" asp-page="/Administration/Members/Finance" asp-route-id="@ownership.MemberId">Финансы</a>
                                        <a class="btn btn-outline-primary" asp-page="/Administration/Plots/Ownerships/Edit" asp-route-plotId="@ownership.PlotId" asp-route-id="@ownership.Id">Редактировать</a>
                                        <a class="btn btn-outline-warning" asp-page="/Administration/Plots/Ownerships/End" asp-route-plotId="@ownership.PlotId" asp-route-id="@ownership.Id">Аннулировать</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white">
        <h2 class="h5 mb-0">История владения</h2>
    </div>
    <div class="card-body p-0">
        @if (Model.HistoricalOwnerships.Count == 0)
        {
            <div class="p-4 text-center text-muted">Завершённые записи владения отсутствуют.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Член товарищества</th>
                            <th>Телефон</th>
                            <th>Электронная почта</th>
                            <th>Действует с</th>
                            <th>Действует до</th>
                            <th>Статус</th>
                            <th class="text-end">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ownership in Model.HistoricalOwnerships)
                        {
                            <tr>
                                <td>
                                    <a asp-page="/Administration/Members/Details" asp-route-id="@ownership.MemberId">@ownership.MemberFullName</a>
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(ownership.MemberPhoneNumber) ? "—" : ownership.MemberPhoneNumber)</td>
                                <td>@(string.IsNullOrWhiteSpace(ownership.MemberEmail) ? "—" : ownership.MemberEmail)</td>
                                <td>@(ownership.ValidFrom.HasValue ? ownership.ValidFrom.Value.ToString("dd.MM.yyyy") : "—")</td>
                                <td>@(ownership.ValidTo.HasValue ? ownership.ValidTo.Value.ToString("dd.MM.yyyy") : "—")</td>
                                <td><span class="badge text-bg-secondary">Аннулирован</span></td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a class="btn btn-outline-success" asp-page="/Administration/Members/Finance" asp-route-id="@ownership.MemberId">Финансы</a>
                                        <a class="btn btn-outline-primary" asp-page="/Administration/Plots/Ownerships/Edit" asp-route-plotId="@ownership.PlotId" asp-route-id="@ownership.Id">Редактировать</a>
                                        <a class="btn btn-outline-success" asp-page="/Administration/Plots/Ownerships/Restore" asp-route-plotId="@ownership.PlotId" asp-route-id="@ownership.Id">Возобновить владение</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
