@page "{id:int}"
@model Neftyanik.Portal.Web.Pages.Administration.Plots.ArchiveModel
@{
    ViewData["Title"] = Model.IsArchiveOperation ? "Архивация участка" : "Восстановление участка";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h3 mb-3">@(Model.IsArchiveOperation ? "Архивация участка" : "Восстановление участка")</h1>

                <p>
                    @(Model.IsArchiveOperation
                        ? "Вы собираетесь архивировать участок. Запись останется в системе и не будет удалена."
                        : "Вы собираетесь восстановить участок из архива.")
                </p>

                <dl class="row mb-4">
                    <dt class="col-sm-4">Номер</dt>
                    <dd class="col-sm-8">@Model.Plot.Number</dd>

                    <dt class="col-sm-4">Адрес</dt>
                    <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Plot.Address) ? "—" : Model.Plot.Address)</dd>
                </dl>

                <form method="post" class="d-flex gap-2">
                    <button type="submit" class="btn @(Model.IsArchiveOperation ? "btn-warning" : "btn-success")">
                        @(Model.IsArchiveOperation ? "Подтвердить архивацию" : "Подтвердить восстановление")
                    </button>
                    <a class="btn btn-outline-secondary" asp-page="/Administration/Plots/Details" asp-route-id="@Model.Plot.Id">Отмена</a>
                </form>
            </div>
        </div>
    </div>
</div>
