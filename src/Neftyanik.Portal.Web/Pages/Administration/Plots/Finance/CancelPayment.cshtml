@page "/Administration/Plots/{plotId:int}/Finance/Payments/{id:long}/Cancel"
@model Neftyanik.Portal.Web.Pages.Administration.Plots.Finance.CancelPaymentModel
@{
    ViewData["Title"] = "Отмена платежа";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h3 mb-3">Отмена платежа</h1>
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <p>Платеж будет отменен и исключен из активного баланса. Запись останется в истории.</p>

                <dl class="row mb-4">
                    <dt class="col-sm-4">Участок</dt>
                    <dd class="col-sm-8">@Model.Plot.PlotNumber</dd>

                    <dt class="col-sm-4">Сумма</dt>
                    <dd class="col-sm-8">@Model.Payment.Amount.ToString("0.00")</dd>

                    <dt class="col-sm-4">Дата платежа</dt>
                    <dd class="col-sm-8">@Model.Payment.PaymentDate.ToString("dd.MM.yyyy")</dd>

                    <dt class="col-sm-4">Способ оплаты</dt>
                    <dd class="col-sm-8">@Model.Payment.PaymentMethodText</dd>
                </dl>

                <form method="post">
                    <div class="mb-3">
                        <label asp-for="Input.CancellationReason" class="form-label"></label>
                        <textarea asp-for="Input.CancellationReason" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Input.CancellationReason" class="text-danger"></span>
                    </div>
                    <div class="d-flex gap-2 flex-wrap">
                        <button type="submit" class="btn btn-warning">Подтвердить отмену</button>
                        <a class="btn btn-outline-secondary" asp-page="/Administration/Plots/Finance/Index" asp-route-plotId="@Model.Plot.PlotId">Назад</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
