@page "/Administration/Plots/{plotId:int}/Finance/RegisterPayment"
@model Neftyanik.Portal.Web.Pages.Administration.Plots.Finance.RegisterPaymentModel
@{
    ViewData["Title"] = "Регистрация платежа";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">Регистрация платежа</h1>
        <p class="text-muted mb-0">Участок @Model.Plot.PlotNumber</p>
    </div>
    <a class="btn btn-outline-secondary" asp-page="/Administration/Plots/Finance/Index" asp-route-plotId="@Model.Plot.PlotId">К финансам участка</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Input.Amount" class="form-label"></label>
                    <input asp-for="Input.Amount" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="Input.Amount" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.PaymentDate" class="form-label"></label>
                    <input asp-for="Input.PaymentDate" class="form-control" type="date" />
                    <span asp-validation-for="Input.PaymentDate" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.PaymentMethod" class="form-label"></label>
                    <select asp-for="Input.PaymentMethod" asp-items="Model.PaymentMethods" class="form-select">
                        <option value="">Выберите способ оплаты</option>
                    </select>
                    <span asp-validation-for="Input.PaymentMethod" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.ReferenceNumber" class="form-label"></label>
                    <input asp-for="Input.ReferenceNumber" class="form-control" />
                    <span asp-validation-for="Input.ReferenceNumber" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Input.Description" class="form-label"></label>
                    <textarea asp-for="Input.Description" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Input.Description" class="text-danger"></span>
                </div>
            </div>
            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">Сохранить</button>
                <a class="btn btn-outline-secondary" asp-page="/Administration/Plots/Finance/Index" asp-route-plotId="@Model.Plot.PlotId">Отмена</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
