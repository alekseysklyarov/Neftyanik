@model Neftyanik.Portal.Web.Pages.Administration.Plots.Finance.CreateChargesModel
@{
    ViewData["Title"] = "Массовое начисление по участкам";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">Начисление по выбранным участкам</h1>
        <p class="text-muted mb-0">Будет создано отдельное начисление для каждого выбранного участка.</p>
    </div>
    <div>
        <a class="btn btn-outline-secondary"
           asp-page="/Administration/Plots/Index"
           asp-route-search="@Model.Search"
           asp-route-status="@Model.Status"
           asp-route-ownership="@Model.Ownership"
           asp-route-pageNumber="@Model.PageNumber">К списку участков</a>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4">
                <p class="mb-1"><strong>Выбрано участков:</strong> @Model.SelectedPlots.Count</p>
                <p class="mb-0 text-muted">Для начисления доступны только активные участки с текущими владельцами.</p>
            </div>
            <div class="col-md-8">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-0" role="alert"></div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-white">
        <h2 class="h5 mb-0">Выбранные участки</h2>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Номер</th>
                        <th>Адрес</th>
                        <th>Количество владельцев</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var plot in Model.SelectedPlots)
                    {
                        <tr>
                            <td class="fw-semibold">@plot.Number</td>
                            <td>@(string.IsNullOrWhiteSpace(plot.Address) ? "—" : plot.Address)</td>
                            <td>@plot.OwnersCount</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form method="post">
            <input asp-for="Search" type="hidden" />
            <input asp-for="Status" type="hidden" />
            <input asp-for="Ownership" type="hidden" />
            <input asp-for="PageNumber" type="hidden" />
            @for (var index = 0; index < Model.Input.SelectedPlotIds.Count; index++)
            {
                <input asp-for="Input.SelectedPlotIds[index]" type="hidden" />
            }

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Input.ChargeTypeId" class="form-label"></label>
                    @if (Model.HasSingleChargeType)
                    {
                        <input type="hidden" asp-for="Input.ChargeTypeId" />
                        <input class="form-control" value="@Model.SingleChargeTypeText" readonly />
                    }
                    else
                    {
                        <select asp-for="Input.ChargeTypeId" asp-items="Model.ChargeTypeOptions" class="form-select">
                            <option value="">Выберите тип начисления</option>
                        </select>
                    }
                    <span asp-validation-for="Input.ChargeTypeId" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.Amount" class="form-label"></label>
                    <input asp-for="Input.Amount" class="form-control" type="number" step="0.01" min="0.01" />
                    <span asp-validation-for="Input.Amount" class="text-danger"></span>
                </div>
                <div class="col-md-6 col-lg-4">
                    <label asp-for="Input.ChargeDate" class="form-label"></label>
                    <input asp-for="Input.ChargeDate" class="form-control" type="date" />
                    <span asp-validation-for="Input.ChargeDate" class="text-danger"></span>
                </div>
                <div class="col-md-6 col-lg-4">
                    <label asp-for="Input.DueDate" class="form-label"></label>
                    <input asp-for="Input.DueDate" class="form-control" type="date" />
                    <span asp-validation-for="Input.DueDate" class="text-danger"></span>
                </div>
                <div class="col-lg-4 d-flex align-items-end">
                    <div class="text-muted small">Сумма и параметры будут одинаковыми для всех выбранных участков.</div>
                </div>
                <div class="col-12">
                    <label asp-for="Input.Description" class="form-label"></label>
                    <textarea asp-for="Input.Description" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Input.Description" class="text-danger"></span>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4 flex-wrap">
                <button type="submit" class="btn btn-primary">Создать начисления</button>
                <a class="btn btn-outline-secondary"
                   asp-page="/Administration/Plots/Index"
                   asp-route-search="@Model.Search"
                   asp-route-status="@Model.Status"
                   asp-route-ownership="@Model.Ownership"
                   asp-route-pageNumber="@Model.PageNumber">Отмена</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
