@page "{id:int}"
@model Neftyanik.Portal.Web.Pages.Administration.Plots.DetailsModel
@{
    ViewData["Title"] = $"Участок {Model.Plot.Number}";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">Участок @Model.Plot.Number</h1>
        <p class="text-muted mb-0">Подробная информация об участке.</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" asp-page="/Administration/Plots/Edit" asp-route-id="@Model.Plot.Id">Редактировать</a>
        <a class="btn btn-info" asp-page="/Administration/Plots/Ownerships/Index" asp-route-plotId="@Model.Plot.Id">Управление владельцами</a>
        <a class="btn btn-outline-warning" asp-page="/Administration/Plots/Archive" asp-route-id="@Model.Plot.Id">@(Model.Plot.IsActive ? "Архивировать" : "Восстановить")</a>
        <a class="btn btn-outline-secondary" asp-page="/Administration/Plots/Index">К списку участков</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h2 class="h5 mb-3">Основные сведения</h2>
                <dl class="row mb-0">
                    <dt class="col-sm-4">Номер</dt>
                    <dd class="col-sm-8">@Model.Plot.Number</dd>

                    <dt class="col-sm-4">Адрес</dt>
                    <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Plot.Address) ? "—" : Model.Plot.Address)</dd>

                    <dt class="col-sm-4">Площадь, соток</dt>
                    <dd class="col-sm-8">@(Model.Plot.AreaSquareMeters.HasValue ? Model.Plot.AreaSquareMeters.Value.ToString("0.###") : "—")</dd>

                    <dt class="col-sm-4">Кадастровый номер</dt>
                    <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Plot.CadastralNumber) ? "—" : Model.Plot.CadastralNumber)</dd>

                    <dt class="col-sm-4">Статус</dt>
                    <dd class="col-sm-8">
                        @if (Model.Plot.IsActive)
                        {
                            <span class="badge text-bg-success">Активен</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">В архиве</span>
                        }
                    </dd>

                    <dt class="col-sm-4">Создан</dt>
                    <dd class="col-sm-8">@Model.Plot.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</dd>

                    <dt class="col-sm-4">Обновлён</dt>
                    <dd class="col-sm-8">@(Model.Plot.UpdatedAtUtc.HasValue ? Model.Plot.UpdatedAtUtc.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm") : "—")</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
                    <h2 class="h5 mb-0">Сводка по владельцам</h2>
                    <a class="btn btn-sm btn-outline-info" asp-page="/Administration/Plots/Ownerships/Index" asp-route-plotId="@Model.Plot.Id">Управление владельцами</a>
                </div>
                <p><strong>Количество текущих владельцев:</strong> @Model.Plot.OwnersCount</p>

                @if (Model.Plot.CurrentOwnerships.Count == 0)
                {
                    <p class="text-muted mb-0">Для участка пока нет активных записей владения.</p>
                }
                else
                {
                    <h3 class="h6 mt-4">Текущие владельцы</h3>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Член товарищества</th>
                                    <th>Действует с</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ownership in Model.Plot.CurrentOwnerships)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                                <a asp-page="/Administration/Members/Details" asp-route-id="@ownership.MemberId">@ownership.MemberFullName</a>
                                                <a class="btn btn-sm btn-outline-success" asp-page="/Administration/Members/Finance" asp-route-id="@ownership.MemberId">Финансы</a>
                                            </div>
                                        </td>
                                        <td>@(ownership.ValidFrom.HasValue ? ownership.ValidFrom.Value.ToString("dd.MM.yyyy") : "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm mt-4">
    <div class="card-body">
        <h2 class="h5 mb-3">Примечание</h2>
        <p class="mb-0">@(string.IsNullOrWhiteSpace(Model.Plot.Notes) ? "Примечание отсутствует." : Model.Plot.Notes)</p>
    </div>
</div>

<div class="card shadow-sm mt-4">
    <div class="card-header bg-white">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <h2 class="h5 mb-0">Начисления</h2>
            <form method="get" class="d-flex flex-column flex-sm-row gap-2 align-items-sm-center">
                <input type="hidden" name="id" value="@Model.Plot.Id" />
                <select asp-for="ChargeTypeId" asp-items="Model.ChargeTypeOptions" class="form-select form-select-sm">
                    <option value="">Все типы</option>
                </select>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-sm btn-outline-primary">Фильтр</button>
                    <a class="btn btn-sm btn-outline-secondary" asp-page="/Administration/Plots/Details" asp-route-id="@Model.Plot.Id">Сбросить</a>
                </div>
            </form>
        </div>
    </div>
    <div class="card-body p-0">
        @if (Model.Plot.Charges.Count == 0)
        {
            <div class="p-4 text-center text-muted">Начисления по участку отсутствуют.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Дата</th>
                            <th>Тип</th>
                            <th>Сумма</th>
                            <th>Срок</th>
                            <th>Статус</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var charge in Model.Plot.Charges)
                        {
                            <tr>
                                <td>@charge.ChargeDate.ToString("dd.MM.yyyy")</td>
                                <td>@charge.ChargeTypeName</td>
                                <td>@charge.Amount.ToString("0.00")</td>
                                <td>@(charge.DueDate.HasValue ? charge.DueDate.Value.ToString("dd.MM.yyyy") : "—")</td>
                                <td>@charge.StatusText</td>
                            </tr>
                            @if (!string.IsNullOrWhiteSpace(charge.Description) || !string.IsNullOrWhiteSpace(charge.CancellationReason))
                            {
                                <tr class="table-light">
                                    <td colspan="5" class="small text-muted">
                                        @if (!string.IsNullOrWhiteSpace(charge.Description))
                                        {
                                            <div><strong>Описание:</strong> @charge.Description</div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(charge.CancellationReason))
                                        {
                                            <div><strong>Причина отмены:</strong> @charge.CancellationReason</div>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
