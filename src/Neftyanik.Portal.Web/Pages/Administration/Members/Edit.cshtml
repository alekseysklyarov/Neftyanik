@page "{id:int}"
@model Neftyanik.Portal.Web.Pages.Administration.Members.EditModel
@{
    ViewData["Title"] = "Редактирование члена товарищества";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h2 mb-1">Редактирование члена товарищества</h1>
        <p class="text-muted mb-0">Измените данные карточки и сохраните их.</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-page="/Administration/Members/Details" asp-route-id="@Model.MemberId">Подробнее</a>
        <a class="btn btn-outline-secondary" asp-page="/Administration/Members/Index">К списку членов товарищества</a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        @if (!string.IsNullOrWhiteSpace(Model.LinkedAccount))
        {
            <div class="alert alert-info" role="alert">
                Связанная учётная запись: <strong>@Model.LinkedAccount</strong>
            </div>
        }

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Input.FullName" class="form-label"></label>
                    <input asp-for="Input.FullName" class="form-control" />
                    <span asp-validation-for="Input.FullName" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.JoinedAt" class="form-label"></label>
                    <input asp-for="Input.JoinedAt" class="form-control" type="date" />
                    <span asp-validation-for="Input.JoinedAt" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.PhoneNumber" class="form-label"></label>
                    <input asp-for="Input.PhoneNumber" class="form-control" />
                    <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.Email" class="form-label"></label>
                    <input asp-for="Input.Email" class="form-control" />
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Input.Notes" class="form-label"></label>
                    <textarea asp-for="Input.Notes" class="form-control" rows="5"></textarea>
                    <span asp-validation-for="Input.Notes" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <div class="form-check">
                        <input asp-for="Input.IsActive" class="form-check-input" />
                        <label asp-for="Input.IsActive" class="form-check-label"></label>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">Сохранить</button>
                <a class="btn btn-outline-secondary" asp-page="/Administration/Members/Details" asp-route-id="@Model.MemberId">Отмена</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
