@page "{id:int}/Finance"
@model Neftyanik.Portal.Web.Pages.Administration.Members.FinanceModel
@{
    ViewData["Title"] = AppLocalizer.Get($"Финансы: {Model.Member.FullName}", $"Фінанси: {Model.Member.FullName}", $"Finance: {Model.Member.FullName}");
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h4 mb-1">@AppLocalizer.Get("Финансы члена товарищества", "Фінанси члена товариства", "Member finance")</h1>
        <p class="h1 text-muted mb-0">@Model.Member.FullName</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        @if (Model.Plots.Count > 0)
        {
            <a class="btn btn-primary" asp-page="/Administration/Members/Finance/CreateCharge" asp-route-id="@Model.Member.Id">@AppLocalizer.Get("Добавить начисление", "Додати нарахування", "Add charge")</a>
            <a class="btn btn-outline-primary" asp-page="/Administration/Members/Finance/RegisterPayment" asp-route-id="@Model.Member.Id">@AppLocalizer.Get("Зарегистрировать платеж", "Зареєструвати платіж", "Register payment")</a>
        }
        @if (Model.CanEnterElectricityReading)
        {
            <button type="button" class="btn btn-outline-success" data-bs-toggle="modal" data-bs-target="#electricityReadingModal">@AppLocalizer.Get("Внести показание электросчётчика", "Внести показник електролічильника", "Enter meter reading")</button>
        }
        <a class="btn btn-outline-primary" asp-page="/Administration/Members/Details" asp-route-id="@Model.Member.Id">@AppLocalizer.Get("Карточка члена товарищества", "Картка члена товариства", "Member details")</a>
        <a class="btn btn-outline-secondary" asp-page="/Administration/Members/Index">@AppLocalizer.Get("К списку членов товарищества", "До списку членів товариства", "Back to members")</a>
    </div>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="alert">@successMessage</div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

<div class="row g-4 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card h-100 shadow-sm"><div class="card-body"><h2 class="h6 text-muted">Активные участки</h2><p class="display-6 mb-0">@Model.Member.ActivePlotsCount</p></div></div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card h-100 shadow-sm"><div class="card-body"><h2 class="h6 text-muted">Начислено</h2><p class="display-6 mb-0">@Model.Member.TotalCharges.ToString("0.00")</p></div></div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card h-100 shadow-sm"><div class="card-body"><h2 class="h6 text-muted">Оплачено</h2><p class="display-6 mb-0">@Model.Member.TotalPayments.ToString("0.00")</p></div></div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card h-100 shadow-sm @Model.Member.BalanceCardClass"><div class="card-body"><h2 class="h6 text-muted">Баланс</h2><p class="display-6 mb-0 @Model.Member.BalanceStatusClass">@Model.Member.BalanceDisplayAmount.ToString("0.00")</p><div class="text-muted">@Model.Member.BalanceStatusText</div></div></div>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4">
                <p class="mb-1"><strong>Телефон:</strong> @(string.IsNullOrWhiteSpace(Model.Member.PhoneNumber) ? "—" : Model.Member.PhoneNumber)</p>
                <p class="mb-0"><strong>Email:</strong> @(string.IsNullOrWhiteSpace(Model.Member.Email) ? "—" : Model.Member.Email)</p>
            </div>
            <div class="col-md-4">
                <p class="mb-0"><strong>Статус:</strong> @(Model.Member.IsActive ? "Активен" : "В архиве")</p>
            </div>
            <div class="col-md-4">
                <p class="mb-0"><strong>Финансовый статус:</strong> <span class="@Model.Member.BalanceStatusClass">@Model.Member.BalanceStatusText</span></p>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-white">
        <h2 class="h5 mb-0">@AppLocalizer.Get("Участки", "Ділянки", "Plots")</h2>
    </div>
    <div class="card-body p-0">
        @if (Model.Plots.Count == 0)
        {
            <div class="p-4 text-center text-muted">@AppLocalizer.Get("У этого члена товарищества нет активных участков с финансовыми данными.", "У цього члена товариства немає активних ділянок з фінансовими даними.", "This member has no active plots with financial data.")</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>@AppLocalizer.Get("Участок", "Ділянка", "Plot")</th>
                            <th>@AppLocalizer.Get("Адрес", "Адреса", "Address")</th>
                            <th>@AppLocalizer.Get("Начислено", "Нараховано", "Charged")</th>
                            <th>@AppLocalizer.Get("Оплачено", "Сплачено", "Paid")</th>
                            <th>@AppLocalizer.Get("Баланс", "Баланс", "Balance")</th>
                            <th>@AppLocalizer.Get("Статус", "Статус", "Status")</th>
                            <th class="text-end">@AppLocalizer.Get("Действия", "Дії", "Actions")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var plot in Model.Plots)
                        {
                            <tr>
                                <td class="fw-semibold">@plot.PlotNumber</td>
                                <td>@(string.IsNullOrWhiteSpace(plot.Address) ? "—" : plot.Address)</td>
                                <td>@plot.Charges.ToString("0.00")</td>
                                <td>@plot.Payments.ToString("0.00")</td>
                                <td class="@plot.BalanceStatusClass">@plot.BalanceDisplayAmount.ToString("0.00")</td>
                                <td>@plot.Status</td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a class="btn btn-outline-success" asp-page="/Administration/Members/Finance/CreateCharge" asp-route-id="@Model.Member.Id" asp-route-plotId="@plot.PlotId">Начислить</a>
                                        <a class="btn btn-outline-primary" asp-page="/Administration/Members/Finance/RegisterPayment" asp-route-id="@Model.Member.Id" asp-route-plotId="@plot.PlotId">Платеж</a>
                                        <a class="btn btn-outline-primary" asp-page="/Administration/Plots/Details" asp-route-id="@plot.PlotId">Карточка участка</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<div class="row g-4">
    <div class="col-xl-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white">
                <h2 class="h5 mb-0">Начисления</h2>
            </div>
            <div class="card-body p-0">
                @if (Model.Charges.Count == 0)
                {
                    <div class="p-4 text-center text-muted">Начисления отсутствуют.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Дата</th>
                                    <th>Участок</th>
                                    <th>Тип</th>
                                    <th>Сумма</th>
                                    <th>Срок</th>
                                    <th>Статус</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var charge in Model.Charges)
                                {
                                    <tr>
                                        <td>@charge.ChargeDate.ToString("dd.MM.yyyy")</td>
                                        <td>@charge.PlotNumber</td>
                                        <td>@charge.ChargeTypeName</td>
                                        <td>@charge.Amount.ToString("0.00")</td>
                                        <td>@(charge.DueDate.HasValue ? charge.DueDate.Value.ToString("dd.MM.yyyy") : "—")</td>
                                        <td>@charge.StatusText</td>
                                    </tr>
                                    @if (!string.IsNullOrWhiteSpace(charge.Description) || !string.IsNullOrWhiteSpace(charge.CancellationReason))
                                    {
                                        <tr class="table-light">
                                            <td colspan="6" class="small text-muted">
                                                @if (!string.IsNullOrWhiteSpace(charge.Description))
                                                {
                                                    <div><strong>Описание:</strong> @charge.Description</div>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(charge.CancellationReason))
                                                {
                                                    <div><strong>Причина отмены:</strong> @charge.CancellationReason</div>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
            @if (Model.ChargeTotalPages > 1)
            {
                <div class="card-footer bg-white">
                    <nav aria-label="Навигация по начислениям">
                        <ul class="pagination justify-content-center mb-0 flex-wrap">
                            <li class="page-item @(Model.HasChargePreviousPage ? string.Empty : "disabled")">
                                <a class="page-link" asp-page="/Administration/Members/Finance" asp-route-id="@Model.Member.Id" asp-route-chargePage="@(Model.ChargePage - 1)" asp-route-paymentPage="@Model.PaymentPage">Назад</a>
                            </li>
                            @for (var pageIndex = 1; pageIndex <= Model.ChargeTotalPages; pageIndex++)
                            {
                                <li class="page-item @(pageIndex == Model.ChargePage ? "active" : string.Empty)">
                                    <a class="page-link" asp-page="/Administration/Members/Finance" asp-route-id="@Model.Member.Id" asp-route-chargePage="@pageIndex" asp-route-paymentPage="@Model.PaymentPage">@pageIndex</a>
                                </li>
                            }
                            <li class="page-item @(Model.HasChargeNextPage ? string.Empty : "disabled")">
                                <a class="page-link" asp-page="/Administration/Members/Finance" asp-route-id="@Model.Member.Id" asp-route-chargePage="@(Model.ChargePage + 1)" asp-route-paymentPage="@Model.PaymentPage">Вперёд</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>
    <div class="col-xl-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white">
                <h2 class="h5 mb-0">Платежи</h2>
            </div>
            <div class="card-body p-0">
                @if (Model.Payments.Count == 0)
                {
                    <div class="p-4 text-center text-muted">Платежи отсутствуют.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Дата</th>
                                    <th>Участок</th>
                                    <th>Сумма</th>
                                    <th>Способ</th>
                                    <th>Документ</th>
                                    <th>Статус</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var payment in Model.Payments)
                                {
                                    <tr>
                                        <td>@payment.PaymentDate.ToString("dd.MM.yyyy")</td>
                                        <td>@payment.PlotNumber</td>
                                        <td>@payment.Amount.ToString("0.00")</td>
                                        <td>@payment.PaymentMethodText</td>
                                        <td>@(string.IsNullOrWhiteSpace(payment.ReferenceNumber) ? "—" : payment.ReferenceNumber)</td>
                                        <td>@payment.StatusText</td>
                                    </tr>
                                    @if (!string.IsNullOrWhiteSpace(payment.Description) || !string.IsNullOrWhiteSpace(payment.CancellationReason))
                                    {
                                        <tr class="table-light">
                                            <td colspan="6" class="small text-muted">
                                                @if (!string.IsNullOrWhiteSpace(payment.Description))
                                                {
                                                    <div><strong>Описание:</strong> @payment.Description</div>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(payment.CancellationReason))
                                                {
                                                    <div><strong>Причина отмены:</strong> @payment.CancellationReason</div>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
            @if (Model.PaymentTotalPages > 1)
            {
                <div class="card-footer bg-white">
                    <nav aria-label="Навигация по платежам">
                        <ul class="pagination justify-content-center mb-0 flex-wrap">
                            <li class="page-item @(Model.HasPaymentPreviousPage ? string.Empty : "disabled")">
                                <a class="page-link" asp-page="/Administration/Members/Finance" asp-route-id="@Model.Member.Id" asp-route-chargePage="@Model.ChargePage" asp-route-paymentPage="@(Model.PaymentPage - 1)">Назад</a>
                            </li>
                            @for (var pageIndex = 1; pageIndex <= Model.PaymentTotalPages; pageIndex++)
                            {
                                <li class="page-item @(pageIndex == Model.PaymentPage ? "active" : string.Empty)">
                                    <a class="page-link" asp-page="/Administration/Members/Finance" asp-route-id="@Model.Member.Id" asp-route-chargePage="@Model.ChargePage" asp-route-paymentPage="@pageIndex">@pageIndex</a>
                                </li>
                            }
                            <li class="page-item @(Model.HasPaymentNextPage ? string.Empty : "disabled")">
                                <a class="page-link" asp-page="/Administration/Members/Finance" asp-route-id="@Model.Member.Id" asp-route-chargePage="@Model.ChargePage" asp-route-paymentPage="@(Model.PaymentPage + 1)">Вперёд</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>
</div>

@if (!Model.IsElectricityFeatureAvailable)
{
    <div class="alert alert-warning" role="alert">
        @Model.ElectricityFeatureWarningMessage
    </div>
}
else
{
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <h2 class="h5 mb-0">@AppLocalizer.Get("Электросчётчики", "Електролічильники", "Electricity meters")</h2>
            <div class="d-flex gap-2 flex-wrap">
                @if (Model.CanSetupElectricityMeter)
                {
                    <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#electricitySetupModal">@AppLocalizer.Get("Инициализировать электросчётчик", "Ініціалізувати електролічильник", "Initialize meter")</button>
                }
                @if (Model.CanInitializeElectricity)
                {
                    <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#electricityInitializationModal">@AppLocalizer.Get("Инициализировать значения", "Ініціалізувати значення", "Initialize values")</button>
                }
            </div>
        </div>
        <div class="card-body p-0">
            <div class="p-3 border-bottom bg-light-subtle">
                @if (Model.CurrentMemberTariff is null)
                {
                    <div class="alert alert-warning mb-0 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3" role="alert">
                        <div>
                            <div class="fw-semibold">@AppLocalizer.Get("Тариф для участников не задан.", "Тариф для учасників не задано.", "The member tariff is not set.")</div>
                            <div class="small">@AppLocalizer.Get("Тарифы со страницы общих тарифов не используются для начислений участникам.", "Тарифи зі сторінки загальних тарифів не використовуються для нарахувань учасникам.", "Tariffs from the common tariff page are not used for member charges.")</div>
                        </div>
                        <a class="btn btn-sm btn-outline-primary" asp-page="/Administration/Electricity/MemberTariffs/Index">@AppLocalizer.Get("Тариф для участников", "Тариф для учасників", "Member tariff")</a>
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 small">
                        <div>
                            <span class="text-muted">@AppLocalizer.Get("Текущий тариф для участников:", "Поточний тариф для учасників:", "Current member tariff:")</span>
                            <strong>@Model.CurrentMemberTariff.Rate.ToString("0.0000") грн/кВт·ч</strong>
                            <span class="text-muted">@AppLocalizer.Get("с", "з", "from") @Model.CurrentMemberTariff.EffectiveFrom.ToString("dd.MM.yyyy")</span>
                        </div>
                        <a class="btn btn-sm btn-outline-primary" asp-page="/Administration/Electricity/MemberTariffs/Index">@AppLocalizer.Get("Изменить тариф", "Змінити тариф", "Change tariff")</a>
                    </div>
                }
            </div>
            @if (!Model.HasElectricityMeters)
            {
                <div class="p-4 text-center text-muted">
                    <div>@AppLocalizer.Get("У участника пока нет привязанных электросчётчиков.", "У учасника поки немає прив'язаних електролічильників.", "The member has no linked electricity meters yet.")</div>
                    @if (Model.CanSetupElectricityMeter)
                    {
                        <button type="button" class="btn btn-sm btn-outline-primary mt-3" data-bs-toggle="modal" data-bs-target="#electricitySetupModal">@AppLocalizer.Get("Привязать счётчик и сохранить начальные показания", "Прив'язати лічильник і зберегти початкові показання", "Link meter and save initial readings")</button>
                    }
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>@AppLocalizer.Get("Счётчик", "Лічильник", "Meter")</th>
                                <th>@AppLocalizer.Get("Расчётный участок", "Розрахункова ділянка", "Billing plot")</th>
                                <th>@AppLocalizer.Get("Статус", "Статус", "Status")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var meter in Model.ElectricityMeters)
                            {
                                <tr>
                                    <td class="fw-semibold">@meter.DisplayName</td>
                                    <td>@meter.BillingPlotNumber</td>
                                    <td>
                                        @if (!meter.IsActive)
                                        {
                                            <span class="badge text-bg-secondary">@AppLocalizer.Get("Неактивен", "Неактивний", "Inactive")</span>
                                        }
                                        else if (!meter.HasReadings)
                                        {
                                            <span class="badge text-bg-warning">@AppLocalizer.Get("Требуется инициализация", "Потрібна ініціалізація", "Initialization required")</span>
                                        }
                                        else
                                        {
                                            <span class="badge text-bg-success">@AppLocalizer.Get("Готов к работе", "Готовий до роботи", "Ready")</span>
                                        }
                                    </td>
                                </tr>
                                <tr class="table-light">
                                    <td colspan="3">
                                        <div class="small">
                                            <div class="fw-semibold mb-2">@AppLocalizer.Get("История показаний", "Історія показань", "Reading history")</div>

                                            @if (meter.Readings.Count == 0)
                                            {
                                                <span class="text-muted">@AppLocalizer.Get("История отсутствует", "Історія відсутня", "No history")</span>
                                            }
                                            else
                                            {
                                                <div class="d-flex flex-column gap-2 py-1">
                                                    @foreach (var reading in meter.Readings)
                                                    {
                                                        <div class="border rounded px-2 py-1 bg-light-subtle">
                                                            <div class="d-flex flex-wrap justify-content-between gap-2">
                                                                <span class="fw-semibold">@reading.ReadingDate.ToString("dd.MM.yyyy")</span>
                                                                <span>@reading.CurrentReading.ToString("0.###") кВт·ч</span>
                                                            </div>
                                                            <div class="d-flex flex-wrap gap-3 text-muted mt-1">
                                                                @if (reading.IsInitialReading)
                                                                {
                                                                    <span>@AppLocalizer.Get("Начальные показания", "Початкові показання", "Initial reading")</span>
                                                                }
                                                                else if (reading.Consumption.HasValue)
                                                                {
                                                                    <span>@AppLocalizer.Get("Расход:", "Споживання:", "Consumption:") @reading.Consumption.Value.ToString("0.###") кВт·ч</span>
                                                                }

                                                                @if (reading.Amount.HasValue)
                                                                {
                                                                    <span>@AppLocalizer.Get("Начисление:", "Нарахування:", "Charge:") @reading.Amount.Value.ToString("0.00") грн</span>
                                                                }
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

<div class="modal fade" id="electricityReadingModal" tabindex="-1" aria-labelledby="electricityReadingModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="CreateElectricityReading" asp-route-id="@Model.Member.Id">
                <input asp-for="ChargePage" type="hidden" />
                <input asp-for="PaymentPage" type="hidden" />
                <div class="modal-header">
                    <h2 class="modal-title h5" id="electricityReadingModalLabel">@AppLocalizer.Get("Ввод показаний электросчётчика", "Введення показників електролічильника", "Enter meter readings")</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@AppLocalizer.Get("Закрыть", "Закрити", "Close")"></button>
                </div>
                <div class="modal-body">
                    <div asp-validation-summary="All" class="alert alert-danger @(ViewContext.ViewData.ModelState.ErrorCount > 0 ? string.Empty : "d-none")" role="alert"></div>
                    @if (Model.CurrentMemberTariff is null)
                    {
                        <div class="alert alert-warning" role="alert">
                            @AppLocalizer.Get("Для сохранения показаний сначала добавьте тариф для участников.", "Щоб зберегти показання, спочатку додайте тариф для учасників.", "Add a member tariff before saving readings.")
                            <a asp-page="/Administration/Electricity/MemberTariffs/Index">@AppLocalizer.Get("Открыть тарифы для участников", "Відкрити тарифи для учасників", "Open member tariffs")</a>
                        </div>
                    }
                    <div class="mb-3">
                        <label asp-for="ReadingInput.MeterId" class="form-label"></label>
                        <select asp-for="ReadingInput.MeterId" asp-items="Model.ReadingMeterOptions" class="form-select">
                            <option value="">@AppLocalizer.Get("Выберите счётчик", "Виберіть лічильник", "Select meter")</option>
                        </select>
                        <span asp-validation-for="ReadingInput.MeterId" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ReadingInput.ReadingDate" class="form-label"></label>
