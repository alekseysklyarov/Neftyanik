@page "/Administration/Members/Finance/{id:int}/RegisterPayment"
@model Neftyanik.Portal.Web.Pages.Administration.Members.Finance.RegisterPaymentModel
@{
    ViewData["Title"] = AppLocalizer.Get($"Платеж: {Model.Member.FullName}", $"Платіж: {Model.Member.FullName}", $"Payment: {Model.Member.FullName}");
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">@AppLocalizer.Get("Новый платеж", "Новий платіж", "New payment")</h1>
        <p class="text-muted mb-0">@AppLocalizer.Get("Член товарищества:", "Член товариства:", "Member:") @Model.Member.FullName</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a class="btn btn-outline-primary" asp-page="/Administration/Members/Finance" asp-route-id="@Model.Member.Id">@AppLocalizer.Get("К финансам участника", "До фінансів учасника", "Back to member finance")</a>
        <a class="btn btn-outline-secondary" asp-page="/Administration/Members/Details" asp-route-id="@Model.Member.Id">@AppLocalizer.Get("Карточка члена товарищества", "Картка члена товариства", "Member details")</a>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4">
                <p class="mb-1"><strong>@AppLocalizer.Get("Активные участки:", "Активні ділянки:", "Active plots:")</strong> @Model.Member.ActivePlotsCount</p>
                <p class="mb-0"><strong>@AppLocalizer.Get("Телефон:", "Телефон:", "Phone:")</strong> @(string.IsNullOrWhiteSpace(Model.Member.PhoneNumber) ? "—" : Model.Member.PhoneNumber)</p>
            </div>
            <div class="col-md-4">
                <p class="mb-0"><strong>Email:</strong> @(string.IsNullOrWhiteSpace(Model.Member.Email) ? "—" : Model.Member.Email)</p>
            </div>
            <div class="col-md-4">
                <p class="mb-0 text-muted">@AppLocalizer.Get("Платеж будет зарегистрирован по выбранному участку и автоматически распределён по задолженности всех текущих участков участника.", "Платіж буде зареєстровано за вибраною ділянкою та автоматично розподілено за заборгованістю всіх поточних ділянок учасника.", "The payment will be registered for the selected plot and automatically allocated to the debts of all current plots of the member.")</p>
            </div>
        </div>
    </div>
</div>

<div class="alert alert-info" role="alert">
    Сейчас в кассе должно быть <strong id="currentCashAmount" data-current-cash="@Model.CurrentCashAmount.ToString(System.Globalization.CultureInfo.InvariantCulture)">@Model.CurrentCashAmount.ToString("0.00") грн</strong>.
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form method="post" id="registerPaymentForm">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Input.PlotId" class="form-label"></label>
                    @if (Model.HasSinglePlot)
                    {
                        <input type="hidden" asp-for="Input.PlotId" />
                        <input class="form-control" value="@Model.SinglePlotText" readonly />
                    }
                    else
                    {
                        <select asp-for="Input.PlotId" asp-items="Model.PlotOptions" class="form-select">
                            <option value="">@AppLocalizer.Get("Не выбран", "Не вибрано", "Not selected")</option>
                        </select>
                    }
                    <span asp-validation-for="Input.PlotId" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.PaymentMethod" class="form-label">@AppLocalizer.Get("Способ оплаты", "Спосіб оплати", "Payment method")</label>
                    <select asp-for="Input.PaymentMethod" asp-items="Model.PaymentMethodOptions" class="form-select"></select>
                    <span asp-validation-for="Input.PaymentMethod" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Input.Amount" class="form-label"></label>
                    <input asp-for="Input.Amount" class="form-control" type="number" step="0.01" min="0.01" />
                    <span asp-validation-for="Input.Amount" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Input.PaymentDate" class="form-label">@AppLocalizer.Get("Дата платежа", "Дата платежу", "Payment date")</label>
                    <input asp-for="Input.PaymentDate" class="form-control" type="date" />
                    <span asp-validation-for="Input.PaymentDate" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Input.ReferenceNumber" class="form-label">@AppLocalizer.Get("Номер документа / квитанции", "Номер документа / квитанції", "Document / receipt number")</label>
                    <input asp-for="Input.ReferenceNumber" class="form-control" />
                    <span asp-validation-for="Input.ReferenceNumber" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Input.Description" class="form-label"></label>
                    <textarea asp-for="Input.Description" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Input.Description" class="text-danger"></span>
                </div>
            </div>
            <div class="d-flex gap-2 mt-4 flex-wrap">
                <button type="button" class="btn btn-primary" id="openRegisterPaymentConfirmation">@AppLocalizer.Get("Сохранить платеж", "Зберегти платіж", "Save payment")</button>
                <a class="btn btn-outline-secondary" asp-page="/Administration/Members/Finance" asp-route-id="@Model.Member.Id">@AppLocalizer.Get("Отмена", "Скасувати", "Cancel")</a>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="registerPaymentConfirmationModal" tabindex="-1" aria-labelledby="registerPaymentConfirmationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5" id="registerPaymentConfirmationModalLabel">Подтверждение регистрации платежа</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <div class="modal-body">
                <p class="mb-2" id="registerPaymentConfirmationMessage"></p>
                <p class="mb-0 text-muted" id="registerPaymentCashChangeMessage"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Отмена</button>
                <button type="button" class="btn btn-primary" id="confirmRegisterPayment">Подтвердить</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const form = document.getElementById('registerPaymentForm');
            const openButton = document.getElementById('openRegisterPaymentConfirmation');
            const confirmButton = document.getElementById('confirmRegisterPayment');
            const modalElement = document.getElementById('registerPaymentConfirmationModal');
            const amountInput = document.getElementById('Input_Amount');
            const paymentMethodSelect = document.getElementById('Input_PaymentMethod');
            const currentCashElement = document.getElementById('currentCashAmount');
            const confirmationMessage = document.getElementById('registerPaymentConfirmationMessage');
            const cashChangeMessage = document.getElementById('registerPaymentCashChangeMessage');

            if (!form || !openButton || !confirmButton || !modalElement || !amountInput || !paymentMethodSelect || !currentCashElement || !confirmationMessage || !cashChangeMessage || !window.bootstrap) {
                return;
            }

            const modal = window.bootstrap.Modal.getOrCreateInstance(modalElement);

            const formatAmount = value => `${value.toFixed(2)} грн`;

            openButton.addEventListener('click', () => {
                if (!form.reportValidity()) {
                    return;
                }

                const currentCash = Number.parseFloat(currentCashElement.dataset.currentCash ?? '0');
                const paymentAmount = Number.parseFloat(amountInput.value.replace(',', '.'));
                const nextCash = Number.isFinite(paymentAmount)
                    ? currentCash + paymentAmount
                    : currentCash;

                confirmationMessage.textContent = `Подтвердите регистрацию платежа на сумму ${Number.isFinite(paymentAmount) ? formatAmount(paymentAmount) : '0.00 грн'}.`;
                cashChangeMessage.textContent = `Сейчас в кассе должно быть ${formatAmount(currentCash)}. После сохранения будет ${formatAmount(nextCash)}.`;

                modal.show();
            });

            confirmButton.addEventListener('click', () => {
                modal.hide();
                form.requestSubmit();
            });
        })();
    </script>
}
