@page "/Administration/Members/Finance/{id:int}/RegisterPayment"
@model Neftyanik.Portal.Web.Pages.Administration.Members.Finance.RegisterPaymentModel
@{
    ViewData["Title"] = $"Платеж: {Model.Member.FullName}";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">Новый платеж</h1>
        <p class="text-muted mb-0">Член товарищества: @Model.Member.FullName</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a class="btn btn-outline-primary" asp-page="/Administration/Members/Finance" asp-route-id="@Model.Member.Id">К финансам участника</a>
        <a class="btn btn-outline-secondary" asp-page="/Administration/Members/Details" asp-route-id="@Model.Member.Id">Карточка члена товарищества</a>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4">
                <p class="mb-1"><strong>Активные участки:</strong> @Model.Member.ActivePlotsCount</p>
                <p class="mb-0"><strong>Телефон:</strong> @(string.IsNullOrWhiteSpace(Model.Member.PhoneNumber) ? "—" : Model.Member.PhoneNumber)</p>
            </div>
            <div class="col-md-4">
                <p class="mb-0"><strong>Email:</strong> @(string.IsNullOrWhiteSpace(Model.Member.Email) ? "—" : Model.Member.Email)</p>
            </div>
            <div class="col-md-4">
                <p class="mb-0 text-muted">Платеж будет зарегистрирован по выбранному участку и автоматически распределён по задолженности всех текущих участков участника.</p>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Input.PlotId" class="form-label"></label>
                    @if (Model.HasSinglePlot)
                    {
                        <input type="hidden" asp-for="Input.PlotId" />
                        <input class="form-control" value="@Model.SinglePlotText" readonly />
                    }
                    else
                    {
                        <select asp-for="Input.PlotId" asp-items="Model.PlotOptions" class="form-select">
                            <option value="">Не выбран</option>
                        </select>
                    }
                    <span asp-validation-for="Input.PlotId" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.PaymentMethod" class="form-label"></label>
                    <select asp-for="Input.PaymentMethod" asp-items="Model.PaymentMethodOptions" class="form-select"></select>
                    <span asp-validation-for="Input.PaymentMethod" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Input.Amount" class="form-label"></label>
                    <input asp-for="Input.Amount" class="form-control" type="number" step="0.01" min="0.01" />
                    <span asp-validation-for="Input.Amount" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Input.PaymentDate" class="form-label"></label>
                    <input asp-for="Input.PaymentDate" class="form-control" type="date" />
                    <span asp-validation-for="Input.PaymentDate" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Input.ReferenceNumber" class="form-label"></label>
                    <input asp-for="Input.ReferenceNumber" class="form-control" />
                    <span asp-validation-for="Input.ReferenceNumber" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Input.Description" class="form-label"></label>
                    <textarea asp-for="Input.Description" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Input.Description" class="text-danger"></span>
                </div>
            </div>
            <div class="d-flex gap-2 mt-4 flex-wrap">
                <button type="submit" class="btn btn-primary">Сохранить платеж</button>
                <a class="btn btn-outline-secondary" asp-page="/Administration/Members/Finance" asp-route-id="@Model.Member.Id">Отмена</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
