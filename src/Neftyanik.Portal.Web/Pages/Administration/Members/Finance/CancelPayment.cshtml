@page "/Administration/Members/Finance/{memberId:int}/Payments/{paymentId:long}/Cancel"
@model Neftyanik.Portal.Web.Pages.Administration.Members.Finance.CancelPaymentModel
@{
    ViewData["Title"] = "Отменить платеж";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">Отменить платеж</h1>
        <p class="text-muted mb-0">Член товарищества: @Model.Payment.MemberFullName</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a class="btn btn-outline-primary" asp-page="/Administration/Members/Finance" asp-route-id="@Model.Payment.MemberId">К финансам участника</a>
        <a class="btn btn-outline-secondary" asp-page="/Administration/Members/Details" asp-route-id="@Model.Payment.MemberId">Карточка члена товарищества</a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <p class="mb-4">Платеж останется в системе и в истории аудита, но будет исключён из активных финансовых итогов и распределений.</p>

                <dl class="row mb-4">
                    <dt class="col-sm-4">Платеж</dt>
                    <dd class="col-sm-8">#@Model.Payment.PaymentId</dd>

                    <dt class="col-sm-4">Дата платежа</dt>
                    <dd class="col-sm-8">@Model.Payment.PaymentDate.ToString("dd.MM.yyyy")</dd>

                    <dt class="col-sm-4">Участок</dt>
                    <dd class="col-sm-8">@Model.Payment.PlotNumber</dd>

                    <dt class="col-sm-4">Сумма</dt>
                    <dd class="col-sm-8">@Model.Payment.Amount.ToString("0.00") грн</dd>

                    <dt class="col-sm-4">Способ оплаты</dt>
                    <dd class="col-sm-8">@Model.Payment.PaymentMethodText</dd>

                    <dt class="col-sm-4">Документ</dt>
                    <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Payment.ReferenceNumber) ? "—" : Model.Payment.ReferenceNumber)</dd>

                    <dt class="col-sm-4">Описание</dt>
                    <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Payment.Description) ? "—" : Model.Payment.Description)</dd>

                    @if (Model.Payment.SourcePaymentNotificationId.HasValue)
                    {
                        <dt class="col-sm-4">Уведомление о платеже</dt>
                        <dd class="col-sm-8">#@Model.Payment.SourcePaymentNotificationId.Value</dd>
                    }
                </dl>

                @if (Model.Payment.Allocations.Count > 0)
                {
                    <div class="mb-4">
                        <h2 class="h5 mb-3">Распределения</h2>
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Начисление</th>
                                        <th>Участок</th>
                                        <th>Дата начисления</th>
                                        <th>Сумма</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var allocation in Model.Payment.Allocations)
                                    {
                                        <tr>
                                            <td>#@allocation.ChargeId</td>
                                            <td>@(string.IsNullOrWhiteSpace(allocation.ChargePlotNumber) ? "—" : allocation.ChargePlotNumber)</td>
                                            <td>@(allocation.ChargeDate.HasValue ? allocation.ChargeDate.Value.ToString("dd.MM.yyyy") : "—")</td>
                                            <td>@allocation.Amount.ToString("0.00") грн</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-info mb-4">У этого платежа нет распределений. После отмены он также будет сохранён в истории как аванс без активного финансового эффекта.</div>
                }

                @if (Model.CanCancel)
                {
                    <form method="post" class="d-flex gap-2 flex-wrap">
                        <div class="w-100 mb-3">
                            <label asp-for="Input.CancellationReason" class="form-label"></label>
                            <textarea asp-for="Input.CancellationReason" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Input.CancellationReason" class="text-danger"></span>
                        </div>
                        <button type="submit" class="btn btn-warning">Отменить платеж</button>
                        <a class="btn btn-outline-secondary" asp-page="/Administration/Members/Finance" asp-route-id="@Model.Payment.MemberId">Назад</a>
                    </form>
                }
                else
                {
                    <div class="alert alert-warning mb-3">
                        Платеж уже отменён @(Model.Payment.CancelledAtUtc.HasValue ? $"{Model.Payment.CancelledAtUtc.Value:dd.MM.yyyy HH:mm} UTC" : string.Empty).
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.Payment.CancellationReason))
                    {
                        <p><strong>Причина отмены:</strong> @Model.Payment.CancellationReason</p>
                    }
                    <a class="btn btn-outline-secondary" asp-page="/Administration/Members/Finance" asp-route-id="@Model.Payment.MemberId">Назад</a>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
