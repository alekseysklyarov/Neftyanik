@page "/Administration/Members/Finance/{memberId:int}/Charges/{chargeId:long}/Cancel"
@model Neftyanik.Portal.Web.Pages.Administration.Members.Finance.CancelChargeModel
@{
    ViewData["Title"] = "Отменить начисление";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">Отменить начисление</h1>
        <p class="text-muted mb-0">Член товарищества: @Model.Charge.MemberFullName</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a class="btn btn-outline-primary" asp-page="/Administration/Members/Finance" asp-route-id="@Model.Charge.MemberId">К финансам участника</a>
        <a class="btn btn-outline-secondary" asp-page="/Administration/Members/Details" asp-route-id="@Model.Charge.MemberId">Карточка члена товарищества</a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <p class="mb-4">Начисление останется в системе и в финансовом аудите, но будет исключено из активной задолженности участника.</p>

                <dl class="row mb-4">
                    <dt class="col-sm-4">Начисление</dt>
                    <dd class="col-sm-8">#@Model.Charge.ChargeId</dd>

                    <dt class="col-sm-4">Участок</dt>
                    <dd class="col-sm-8">@Model.Charge.PlotNumber</dd>

                    <dt class="col-sm-4">Тип начисления</dt>
                    <dd class="col-sm-8">@Model.Charge.ChargeTypeName</dd>

                    <dt class="col-sm-4">Дата начисления</dt>
                    <dd class="col-sm-8">@Model.Charge.ChargeDate.ToString("dd.MM.yyyy")</dd>

                    <dt class="col-sm-4">Срок оплаты</dt>
                    <dd class="col-sm-8">@(Model.Charge.DueDate.HasValue ? Model.Charge.DueDate.Value.ToString("dd.MM.yyyy") : "—")</dd>

                    <dt class="col-sm-4">Сумма</dt>
                    <dd class="col-sm-8">@Model.Charge.Amount.ToString("0.00") грн</dd>

                    <dt class="col-sm-4">Описание</dt>
                    <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Charge.Description) ? "—" : Model.Charge.Description)</dd>

                    <dt class="col-sm-4">Активно оплачено</dt>
                    <dd class="col-sm-8">@Model.Charge.ActiveAllocatedAmount.ToString("0.00") грн</dd>

                    <dt class="col-sm-4">Текущий остаток</dt>
                    <dd class="col-sm-8">@Model.Charge.OutstandingAmount.ToString("0.00") грн</dd>
                </dl>

                @if (Model.Charge.MemberElectricityReadingId.HasValue)
                {
                    <div class="alert alert-info mb-4">
                        <div><strong>Связанные показания:</strong> #@Model.Charge.MemberElectricityReadingId.Value</div>
                        @if (Model.Charge.ReadingDate.HasValue)
                        {
                            <div><strong>Дата показаний:</strong> @Model.Charge.ReadingDate.Value.ToString("dd.MM.yyyy")</div>
                        }
                        @if (Model.Charge.ReadingAmount.HasValue)
                        {
                            <div><strong>Сумма по показаниям:</strong> @Model.Charge.ReadingAmount.Value.ToString("0.00") грн</div>
                        }
                        @if (Model.Charge.AppliedMemberRate.HasValue)
                        {
                            <div><strong>Тариф Т1:</strong> @Model.Charge.AppliedMemberRate.Value.ToString("0.0000") грн/кВт·ч</div>
                        }
                        @if (Model.Charge.AppliedMemberNightRate.HasValue)
                        {
                            <div><strong>Тариф Т2:</strong> @Model.Charge.AppliedMemberNightRate.Value.ToString("0.0000") грн/кВт·ч</div>
                        }
                        <div class="small mt-2">Показания и их история останутся без изменений.</div>
                    </div>
                }

                @if (Model.Charge.Allocations.Count > 0)
                {
                    <div class="mb-4">
                        <h2 class="h5 mb-3">Распределения платежей</h2>
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Платеж</th>
                                        <th>Дата</th>
                                        <th>Участок платежа</th>
                                        <th>Сумма</th>
                                        <th>Статус платежа</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var allocation in Model.Charge.Allocations)
                                    {
                                        <tr>
                                            <td>#@allocation.PaymentId</td>
                                            <td>@(allocation.PaymentDate.HasValue ? allocation.PaymentDate.Value.ToString("dd.MM.yyyy") : "—")</td>
                                            <td>@(string.IsNullOrWhiteSpace(allocation.PaymentPlotNumber) ? "—" : allocation.PaymentPlotNumber)</td>
                                            <td>@allocation.Amount.ToString("0.00") грн</td>
                                            <td>@(allocation.IsPaymentCancelled ? "Платеж отменен" : "Активный платеж")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-info mb-4">У начисления нет распределений платежей.</div>
                }

                @if (Model.CanCancel)
                {
                    <form method="post" class="d-flex gap-2 flex-wrap">
                        <div class="w-100 mb-3">
                            <label asp-for="Input.CancellationReason" class="form-label"></label>
                            <textarea asp-for="Input.CancellationReason" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Input.CancellationReason" class="text-danger"></span>
                        </div>
                        <button type="submit" class="btn btn-warning">Отменить начисление</button>
                        <a class="btn btn-outline-secondary" asp-page="/Administration/Members/Finance" asp-route-id="@Model.Charge.MemberId">Назад</a>
                    </form>
                }
                else
                {
                    <div class="alert alert-warning mb-3">
                        Начисление уже отменено @(Model.Charge.CancelledAtUtc.HasValue ? $"{Model.Charge.CancelledAtUtc.Value:dd.MM.yyyy HH:mm} UTC" : string.Empty).
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.Charge.CancellationReason))
                    {
                        <p><strong>Причина отмены:</strong> @Model.Charge.CancellationReason</p>
                    }
                    <a class="btn btn-outline-secondary" asp-page="/Administration/Members/Finance" asp-route-id="@Model.Charge.MemberId">Назад</a>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
