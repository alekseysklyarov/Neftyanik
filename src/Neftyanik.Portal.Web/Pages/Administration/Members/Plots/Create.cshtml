@page
@model Neftyanik.Portal.Web.Pages.Administration.Members.Plots.CreateModel
@{
    ViewData["Title"] = $"Добавить участок: {Model.Member.FullName}";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">Добавить участок члену товарищества</h1>
        <p class="text-muted mb-0">@Model.Member.FullName</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a class="btn btn-outline-success" asp-page="/Administration/Members/Finance" asp-route-id="@Model.Member.Id">Финансы</a>
        <a class="btn btn-outline-secondary" asp-page="/Administration/Members/Details" asp-route-id="@Model.Member.Id">К карточке члена товарищества</a>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">ФИО</dt>
            <dd class="col-sm-8">@Model.Member.FullName</dd>

            <dt class="col-sm-4">Телефон</dt>
            <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Member.PhoneNumber) ? "—" : Model.Member.PhoneNumber)</dd>

            <dt class="col-sm-4">Электронная почта</dt>
            <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Member.Email) ? "—" : Model.Member.Email)</dd>

            <dt class="col-sm-4">Текущих владений</dt>
            <dd class="col-sm-8">@Model.Member.ActiveOwnershipsCount</dd>
        </dl>
    </div>
</div>

@if (!Model.Member.IsActive)
{
    <div class="alert alert-warning" role="alert">
        Нельзя добавить участок архивному члену товарищества.
    </div>
}
else if (!Model.HasAvailablePlots)
{
    <div class="alert alert-info" role="alert">
        Нет свободных участков, доступных для добавления.
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="Input.PlotId" class="form-label"></label>
                        <select asp-for="Input.PlotId" asp-items="Model.PlotOptions" class="form-select">
                            <option value="">Выберите участок</option>
                        </select>
                        <span asp-validation-for="Input.PlotId" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Input.ValidFrom" class="form-label"></label>
                        <input asp-for="Input.ValidFrom" class="form-control" type="date" />
                        <span asp-validation-for="Input.ValidFrom" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Input.OwnershipShare" class="form-label"></label>
                        <input asp-for="Input.OwnershipShare" class="form-control" type="number" step="0.01" min="0.01" max="100" />
                        <span asp-validation-for="Input.OwnershipShare" class="text-danger"></span>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary">Добавить участок</button>
                    <a class="btn btn-outline-secondary" asp-page="/Administration/Members/Details" asp-route-id="@Model.Member.Id">Отмена</a>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
