@page
@using Neftyanik.Portal.Domain.Enums
@model Neftyanik.Portal.Web.Pages.Administration.Members.IndexModel
@{
    ViewData["Title"] = AppLocalizer.Get("Члены товарищества", "Члени товариства", "Members");
    var isAdministrator = User.IsInRole(RoleNames.Administrator);
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">@AppLocalizer.Get("Члены товарищества", "Члени товариства", "Members")</h1>
        <p class="text-muted mb-0">@AppLocalizer.Get("Список членов товарищества и их карточек.", "Список членів товариства та їхніх карток.", "List of members and their records.")</p>
    </div>
    @if (isAdministrator)
    {
        <div>
            <a class="btn btn-primary" asp-page="/Administration/Members/Create">@AppLocalizer.Get("Добавить члена товарищества", "Додати члена товариства", "Add member")</a>
        </div>
    }
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <input asp-for="SortBy" type="hidden" />
            <input asp-for="SortDirection" type="hidden" />
            <div class="col-md-6">
                <label asp-for="Search" class="form-label">@AppLocalizer.Get("Поиск", "Пошук", "Search")</label>
                <input asp-for="Search" class="form-control" placeholder="@AppLocalizer.Get("ФИО или телефон", "ПІБ або телефон", "Full name or phone")" />
            </div>
            <div class="col-md-3">
                <label asp-for="Status" class="form-label">@AppLocalizer.Get("Статус", "Статус", "Status")</label>
                <select asp-for="Status" class="form-select">
                    <option value="all">@AppLocalizer.Get("Все", "Усі", "All")</option>
                    <option value="active">@AppLocalizer.Get("Только активные", "Лише активні", "Active only")</option>
                    <option value="archived">@AppLocalizer.Get("Только архивные", "Лише архівні", "Archived only")</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-outline-primary flex-fill">@AppLocalizer.Get("Найти", "Знайти", "Search")</button>
                <a class="btn btn-outline-secondary" asp-page="/Administration/Members/Index" asp-route-status="all">@AppLocalizer.Get("Сбросить", "Скинути", "Reset")</a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="d-flex justify-content-between align-items-center px-3 pt-3 text-muted small">
            <span>@AppLocalizer.Get("Количество записей", "Кількість записів", "Record count"): @Model.TotalCount</span>
        </div>
        @if (Model.Members.Count == 0)
        {
            <div class="p-4 text-center text-muted">
                @Model.EmptyStateMessage
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>
                                <a class="text-decoration-none link-dark" asp-page="/Administration/Members/Index" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-sortBy="fullname" asp-route-sortDirection="@Model.GetNextSortDirection("fullname")">@AppLocalizer.Get("ФИО", "ПІБ", "Full name") @Model.GetSortIndicator("fullname")</a>
                            </th>
                            <th>
                                <a class="text-decoration-none link-dark" asp-page="/Administration/Members/Index" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-sortBy="phone" asp-route-sortDirection="@Model.GetNextSortDirection("phone")">@AppLocalizer.Get("Телефон", "Телефон", "Phone") @Model.GetSortIndicator("phone")</a>
                            </th>
                            <th>@AppLocalizer.Get("Тип счётчика", "Тип лічильника", "Meter type")</th>
                            <th>
                                <a class="text-decoration-none link-dark" asp-page="/Administration/Members/Index" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-sortBy="joinedat" asp-route-sortDirection="@Model.GetNextSortDirection("joinedat")">@AppLocalizer.Get("Дата вступления", "Дата вступу", "Join date") @Model.GetSortIndicator("joinedat")</a>
                            </th>
                            <th>
                                <a class="text-decoration-none link-dark" asp-page="/Administration/Members/Index" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-sortBy="status" asp-route-sortDirection="@Model.GetNextSortDirection("status")">@AppLocalizer.Get("Статус", "Статус", "Status") @Model.GetSortIndicator("status")</a>
                            </th>
                            <th>
                                <a class="text-decoration-none link-dark" asp-page="/Administration/Members/Index" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-sortBy="electricity" asp-route-sortDirection="@Model.GetNextSortDirection("electricity")">@AppLocalizer.Get("Электрика отключена", "Електрику відключено", "Electricity disconnected") @Model.GetSortIndicator("electricity")</a>
                            </th>
                            <th>
                                <a class="text-decoration-none link-dark" asp-page="/Administration/Members/Index" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-sortBy="ownerships" asp-route-sortDirection="@Model.GetNextSortDirection("ownerships")">@AppLocalizer.Get("Активные владения", "Активні володіння", "Active ownerships") @Model.GetSortIndicator("ownerships")</a>
                            </th>
                            <th>
                                <a class="text-decoration-none link-dark" asp-page="/Administration/Members/Index" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-sortBy="balance" asp-route-sortDirection="@Model.GetNextSortDirection("balance")">@AppLocalizer.Get("Баланс", "Баланс", "Balance") @Model.GetSortIndicator("balance")</a>
                            </th>
                            <th>
                                <a class="text-decoration-none link-dark" asp-page="/Administration/Members/Index" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-sortBy="login" asp-route-sortDirection="@Model.GetNextSortDirection("login")">@AppLocalizer.Get("Логин", "Логін", "Login") @Model.GetSortIndicator("login")</a>
                            </th>
                            <th class="text-end">@AppLocalizer.Get("Действия", "Дії", "Actions")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var member in Model.Members)
                        {
                            <tr>
                                <td class="fw-semibold">@member.FullName</td>
                                <td>@(string.IsNullOrWhiteSpace(member.PhoneNumber) ? "—" : member.PhoneNumber)</td>
                                <td>@(member.ElectricityMeterType == MemberElectricityMeterType.DayNight ? AppLocalizer.Get("Двухзонный", "Двозонний", "Day/night") : AppLocalizer.Get("Однозонный", "Однозонний", "Single-rate"))</td>
                                <td>@(member.JoinedAt.HasValue ? member.JoinedAt.Value.ToString("dd.MM.yyyy") : "—")</td>
                                <td>
                                    @if (member.IsActive)
                                    {
                                        <span class="badge text-bg-success">Активен</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">@AppLocalizer.Get("В архиве", "В архіві", "Archived")</span>
                                    }
                                </td>
                                <td>
                                    @if (member.IsElectricityDisconnected)
                                    {
                                        <span class="text-muted">@AppLocalizer.Get("Да", "Так", "Yes")</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-danger">@AppLocalizer.Get("Нет", "Ні", "No")</span>
                                    }
                                </td>
                                <td>@member.ActiveOwnershipsCount</td>
                                <td class="@member.BalanceStatusClass">@member.BalanceDisplayText</td>
                                <td>@(string.IsNullOrWhiteSpace(member.Login) ? "—" : member.Login)</td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a class="btn btn-outline-secondary" asp-page="/Administration/Members/Details" asp-route-id="@member.Id">@AppLocalizer.Get("Подробнее", "Детальніше", "Details")</a>
                                        <a class="btn btn-outline-success" asp-page="/Administration/Members/Finance" asp-route-id="@member.Id">@AppLocalizer.Get("Финансы", "Фінанси", "Finance")</a>
                                        @if (isAdministrator)
                                        {
                                            <a class="btn btn-outline-primary" asp-page="/Administration/Members/Edit" asp-route-id="@member.Id">@AppLocalizer.Get("Редактировать", "Редагувати", "Edit")</a>
                                            <a class="btn btn-outline-warning" asp-page="/Administration/Members/Archive" asp-route-id="@member.Id">@(member.IsActive ? AppLocalizer.Get("Архивировать", "Архівувати", "Archive") : AppLocalizer.Get("Восстановить", "Відновити", "Restore"))</a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav aria-label="@AppLocalizer.Get("Навигация по страницам", "Навігація сторінками", "Pagination")" class="mt-4">
        <ul class="pagination justify-content-center flex-wrap">
            <li class="page-item @(Model.HasPreviousPage ? string.Empty : "disabled")">
                <a class="page-link"
                   asp-page="/Administration/Members/Index"
                   asp-route-search="@Model.Search"
                   asp-route-status="@Model.Status"
                   asp-route-sortBy="@Model.SortBy"
                   asp-route-sortDirection="@Model.SortDirection"
                   asp-route-pageNumber="@(Model.PageNumber - 1)">@AppLocalizer.Get("Назад", "Назад", "Previous")</a>
            </li>
            @for (var pageIndex = 1; pageIndex <= Model.TotalPages; pageIndex++)
            {
                <li class="page-item @(pageIndex == Model.PageNumber ? "active" : string.Empty)">
                    <a class="page-link"
                       asp-page="/Administration/Members/Index"
                       asp-route-search="@Model.Search"
                       asp-route-status="@Model.Status"
                       asp-route-sortBy="@Model.SortBy"
                       asp-route-sortDirection="@Model.SortDirection"
                       asp-route-pageNumber="@pageIndex">@pageIndex</a>
                </li>
            }
            <li class="page-item @(Model.HasNextPage ? string.Empty : "disabled")">
                <a class="page-link"
                   asp-page="/Administration/Members/Index"
                   asp-route-search="@Model.Search"
                   asp-route-status="@Model.Status"
                   asp-route-sortBy="@Model.SortBy"
                   asp-route-sortDirection="@Model.SortDirection"
                   asp-route-pageNumber="@(Model.PageNumber + 1)">@AppLocalizer.Get("Вперёд", "Вперед", "Next")</a>
            </li>
        </ul>
    </nav>
}
