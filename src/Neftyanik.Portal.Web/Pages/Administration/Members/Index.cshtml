@page
@model Neftyanik.Portal.Web.Pages.Administration.Members.IndexModel
@{
    ViewData["Title"] = "Члены товарищества";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">Члены товарищества</h1>
        <p class="text-muted mb-0">Список членов товарищества и их карточек.</p>
    </div>
    <div>
        <a class="btn btn-primary" asp-page="/Administration/Members/Create">Добавить члена товарищества</a>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-6">
                <label asp-for="Search" class="form-label">Поиск</label>
                <input asp-for="Search" class="form-control" placeholder="ФИО, телефон или электронная почта" />
            </div>
            <div class="col-md-3">
                <label asp-for="Status" class="form-label">Статус</label>
                <select asp-for="Status" class="form-select">
                    <option value="active">Только активные</option>
                    <option value="all">Все</option>
                    <option value="archived">Только архивные</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-outline-primary flex-fill">Найти</button>
                <a class="btn btn-outline-secondary" asp-page="/Administration/Members/Index" asp-route-status="all">Сбросить</a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        @if (Model.Members.Count == 0)
        {
            <div class="p-4 text-center text-muted">
                @Model.EmptyStateMessage
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>ФИО</th>
                            <th>Телефон</th>
                            <th>Электронная почта</th>
                            <th>Дата вступления</th>
                            <th>Статус</th>
                            <th>Активные владения</th>
                            <th>Связанная учётная запись</th>
                            <th class="text-end">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var member in Model.Members)
                        {
                            <tr>
                                <td class="fw-semibold">@member.FullName</td>
                                <td>@(string.IsNullOrWhiteSpace(member.PhoneNumber) ? "—" : member.PhoneNumber)</td>
                                <td>@(string.IsNullOrWhiteSpace(member.Email) ? "—" : member.Email)</td>
                                <td>@(member.JoinedAt.HasValue ? member.JoinedAt.Value.ToString("dd.MM.yyyy") : "—")</td>
                                <td>
                                    @if (member.IsActive)
                                    {
                                        <span class="badge text-bg-success">Активен</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">В архиве</span>
                                    }
                                </td>
                                <td>@member.ActiveOwnershipsCount</td>
                                <td>@(string.IsNullOrWhiteSpace(member.LinkedAccount) ? "—" : member.LinkedAccount)</td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a class="btn btn-outline-secondary" asp-page="/Administration/Members/Details" asp-route-id="@member.Id">Подробнее</a>
                                        <a class="btn btn-outline-primary" asp-page="/Administration/Members/Edit" asp-route-id="@member.Id">Редактировать</a>
                                        <a class="btn btn-outline-warning" asp-page="/Administration/Members/Archive" asp-route-id="@member.Id">@(member.IsActive ? "Архивировать" : "Восстановить")</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav aria-label="Навигация по страницам" class="mt-4">
        <ul class="pagination justify-content-center flex-wrap">
            <li class="page-item @(Model.HasPreviousPage ? string.Empty : "disabled")">
                <a class="page-link"
                   asp-page="/Administration/Members/Index"
                   asp-route-search="@Model.Search"
                   asp-route-status="@Model.Status"
                   asp-route-pageNumber="@(Model.PageNumber - 1)">Назад</a>
            </li>
            @for (var pageIndex = 1; pageIndex <= Model.TotalPages; pageIndex++)
            {
                <li class="page-item @(pageIndex == Model.PageNumber ? "active" : string.Empty)">
                    <a class="page-link"
                       asp-page="/Administration/Members/Index"
                       asp-route-search="@Model.Search"
                       asp-route-status="@Model.Status"
                       asp-route-pageNumber="@pageIndex">@pageIndex</a>
                </li>
            }
            <li class="page-item @(Model.HasNextPage ? string.Empty : "disabled")">
                <a class="page-link"
                   asp-page="/Administration/Members/Index"
                   asp-route-search="@Model.Search"
                   asp-route-status="@Model.Status"
                   asp-route-pageNumber="@(Model.PageNumber + 1)">Вперёд</a>
            </li>
        </ul>
    </nav>
}
