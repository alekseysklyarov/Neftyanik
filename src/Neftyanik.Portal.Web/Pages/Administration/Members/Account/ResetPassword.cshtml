@page "/Administration/Members/{memberId:int}/Account/ResetPassword"
@model Neftyanik.Portal.Web.Pages.Administration.Members.Account.ResetPasswordModel
@{
    ViewData["Title"] = AppLocalizer.Get("Сброс пароля", "Скидання пароля", "Reset password");
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h3 mb-3">@AppLocalizer.Get("Сброс временного пароля", "Скидання тимчасового пароля", "Reset temporary password")</h1>
                <p class="text-muted">@AppLocalizer.Get("Член товарищества:", "Член товариства:", "Member:") @Model.Member.FullName</p>

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <dl class="row mb-4">
                    <dt class="col-sm-4">@AppLocalizer.Get("Логин / email", "Логін / email", "Login / email")</dt>
                    <dd class="col-sm-8">@Model.LoginEmail</dd>
                </dl>

                <form method="post">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Input.NewTemporaryPassword" class="form-label">@AppLocalizer.Get("Новый временный пароль", "Новий тимчасовий пароль", "New temporary password")</label>
                            <input asp-for="Input.NewTemporaryPassword" class="form-control" type="password" autocomplete="new-password" />
                            <span asp-validation-for="Input.NewTemporaryPassword" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.ConfirmPassword" class="form-label">@AppLocalizer.Get("Подтверждение пароля", "Підтвердження пароля", "Confirm password")</label>
                            <input asp-for="Input.ConfirmPassword" class="form-control" type="password" autocomplete="new-password" />
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <input asp-for="Input.MustChangePasswordOnLogin" class="form-check-input" />
                                <label asp-for="Input.MustChangePasswordOnLogin" class="form-check-label">@AppLocalizer.Get("Сменить при входе", "Змінити при вході", "Change on sign-in")</label>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="form-text">@AppLocalizer.Get("Передайте временный пароль пользователю безопасным способом.", "Передайте тимчасовий пароль користувачу безпечним способом.", "Share the temporary password with the user using a secure method.")</div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4 flex-wrap">
                        <button type="submit" class="btn btn-primary">@AppLocalizer.Get("Установить временный пароль", "Встановити тимчасовий пароль", "Set temporary password")</button>
                        <a class="btn btn-outline-success" asp-page="/Administration/Members/Finance" asp-route-id="@Model.Member.Id">@AppLocalizer.Get("Финансы", "Фінанси", "Finance")</a>
                        <a class="btn btn-outline-secondary" asp-page="/Administration/Members/Details" asp-route-id="@Model.Member.Id">@AppLocalizer.Get("Отмена", "Скасувати", "Cancel")</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
