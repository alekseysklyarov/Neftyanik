@page "/Administration/Members/{memberId:int}/Account/Lock"
@model Neftyanik.Portal.Web.Pages.Administration.Members.Account.LockModel
@{
    ViewData["Title"] = Model.IsUnlockOperation ? "Разблокировка учетной записи" : "Блокировка учетной записи";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h3 mb-3">@(Model.IsUnlockOperation ? "Разблокировка учетной записи" : "Блокировка учетной записи")</h1>
                <p class="text-muted">Член товарищества: @Model.Member.FullName</p>

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <dl class="row mb-4">
                    <dt class="col-sm-4">Логин / email</dt>
                    <dd class="col-sm-8">@Model.Account.LoginEmail</dd>

                    <dt class="col-sm-4">Статус</dt>
                    <dd class="col-sm-8">@(Model.Account.IsLockedOut ? "Учетная запись заблокирована" : "Учетная запись активна")</dd>
                </dl>

                <p>
                    @(Model.IsUnlockOperation
                        ? "Подтвердите разблокировку учетной записи пользователя."
                        : "Подтвердите блокировку учетной записи пользователя. Учетная запись не будет удалена и связь с членом товарищества сохранится.")
                </p>

                <form method="post" class="d-flex gap-2 flex-wrap">
                    <button type="submit" class="btn @(Model.IsUnlockOperation ? "btn-success" : "btn-warning")">@(Model.IsUnlockOperation ? "Подтвердить разблокировку" : "Подтвердить блокировку")</button>
                    <a class="btn btn-outline-secondary" asp-page="/Administration/Members/Details" asp-route-id="@Model.Member.Id">Отмена</a>
                </form>
            </div>
        </div>
    </div>
</div>
