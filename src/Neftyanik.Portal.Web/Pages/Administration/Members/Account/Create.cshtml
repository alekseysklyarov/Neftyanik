@page "/Administration/Members/{memberId:int}/Account/Create"
@model Neftyanik.Portal.Web.Pages.Administration.Members.Account.CreateModel
@{
    ViewData["Title"] = "Создание учетной записи";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">Создание учетной записи</h1>
        <p class="text-muted mb-0">Член товарищества: @Model.Member.FullName</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a class="btn btn-outline-secondary" asp-page="/Administration/Members/Details" asp-route-id="@Model.Member.Id">К карточке члена товарищества</a>
        <a class="btn btn-outline-success" asp-page="/Administration/Members/Finance" asp-route-id="@Model.Member.Id">Финансы</a>
        <a class="btn btn-outline-secondary" asp-page="/Administration/Members/Index">К списку членов товарищества</a>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">ФИО</dt>
            <dd class="col-sm-8">@Model.Member.FullName</dd>

            <dt class="col-sm-4">Электронная почта в карточке</dt>
            <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Member.Email) ? "—" : Model.Member.Email)</dd>

            <dt class="col-sm-4">Телефон</dt>
            <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Member.PhoneNumber) ? "—" : Model.Member.PhoneNumber)</dd>
        </dl>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="Input.Login" class="form-label"></label>
                    <input asp-for="Input.Login" class="form-control" autocomplete="username" />
                    <span asp-validation-for="Input.Login" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.TemporaryPassword" class="form-label"></label>
                    <input asp-for="Input.TemporaryPassword" class="form-control" type="password" autocomplete="new-password" />
                    <span asp-validation-for="Input.TemporaryPassword" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.ConfirmPassword" class="form-label"></label>
                    <input asp-for="Input.ConfirmPassword" class="form-control" type="password" autocomplete="new-password" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <div class="form-text">Передайте временный пароль пользователю безопасным способом.</div>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">Создать учетную запись</button>
                <a class="btn btn-outline-success" asp-page="/Administration/Members/Finance" asp-route-id="@Model.Member.Id">Финансы</a>
                <a class="btn btn-outline-secondary" asp-page="/Administration/Members/Details" asp-route-id="@Model.Member.Id">Отмена</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
