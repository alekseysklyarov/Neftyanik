@page "/Administration/Members/{memberId:int}/Account/Create"
@model Neftyanik.Portal.Web.Pages.Administration.Members.Account.CreateModel
@{
    ViewData["Title"] = AppLocalizer.Get("Создание учетной записи", "Створення облікового запису", "Create account");
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">@AppLocalizer.Get("Создание учетной записи", "Створення облікового запису", "Create account")</h1>
        <p class="text-muted mb-0">@AppLocalizer.Get("Член товарищества:", "Член товариства:", "Member:") @Model.Member.FullName</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a class="btn btn-outline-secondary" asp-page="/Administration/Members/Details" asp-route-id="@Model.Member.Id">@AppLocalizer.Get("К карточке члена товарищества", "До картки члена товариства", "Back to member details")</a>
        <a class="btn btn-outline-success" asp-page="/Administration/Members/Finance" asp-route-id="@Model.Member.Id">@AppLocalizer.Get("Финансы", "Фінанси", "Finance")</a>
        <a class="btn btn-outline-secondary" asp-page="/Administration/Members/Index">@AppLocalizer.Get("К списку членов товарищества", "До списку членів товариства", "Back to members")</a>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">@AppLocalizer.Get("ФИО", "ПІБ", "Full name")</dt>
            <dd class="col-sm-8">@Model.Member.FullName</dd>

            <dt class="col-sm-4">@AppLocalizer.Get("Электронная почта в карточке", "Електронна пошта в картці", "Email in member record")</dt>
            <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Member.Email) ? "—" : Model.Member.Email)</dd>

            <dt class="col-sm-4">@AppLocalizer.Get("Телефон", "Телефон", "Phone")</dt>
            <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Member.PhoneNumber) ? "—" : Model.Member.PhoneNumber)</dd>
        </dl>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="Input.Login" class="form-label">@AppLocalizer.Get("Логин", "Логін", "Login")</label>
                    <input asp-for="Input.Login" class="form-control" autocomplete="username" />
                    <span asp-validation-for="Input.Login" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.TemporaryPassword" class="form-label">@AppLocalizer.Get("Временный пароль", "Тимчасовий пароль", "Temporary password")</label>
                    <input asp-for="Input.TemporaryPassword" class="form-control" type="password" autocomplete="new-password" />
                    <span asp-validation-for="Input.TemporaryPassword" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.ConfirmPassword" class="form-label">@AppLocalizer.Get("Подтверждение пароля", "Підтвердження пароля", "Confirm password")</label>
                    <input asp-for="Input.ConfirmPassword" class="form-control" type="password" autocomplete="new-password" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <div class="form-check">
                        <input asp-for="Input.MustChangePasswordOnLogin" class="form-check-input" />
                        <label asp-for="Input.MustChangePasswordOnLogin" class="form-check-label">@AppLocalizer.Get("Сменить пароль при следующем входе", "Змінити пароль при наступному вході", "Require password change on next sign-in")</label>
                    </div>
                </div>
                <div class="col-12">
                    <div class="form-text">@AppLocalizer.Get("Передайте временный пароль пользователю безопасным способом.", "Передайте тимчасовий пароль користувачу безпечним способом.", "Share the temporary password with the user securely.")</div>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">@AppLocalizer.Get("Создать учетную запись", "Створити обліковий запис", "Create account")</button>
                <a class="btn btn-outline-success" asp-page="/Administration/Members/Finance" asp-route-id="@Model.Member.Id">@AppLocalizer.Get("Финансы", "Фінанси", "Finance")</a>
                <a class="btn btn-outline-secondary" asp-page="/Administration/Members/Details" asp-route-id="@Model.Member.Id">@AppLocalizer.Get("Отмена", "Скасувати", "Cancel")</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
