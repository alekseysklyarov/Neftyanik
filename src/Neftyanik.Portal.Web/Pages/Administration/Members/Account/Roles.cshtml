@page "/Administration/Members/{memberId:int}/Account/Roles"
@model Neftyanik.Portal.Web.Pages.Administration.Members.Account.RolesModel
@{
    ViewData["Title"] = "Права доступа";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">Права доступа</h1>
        <p class="text-muted mb-0">Член товарищества: @Model.Member.FullName</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a class="btn btn-outline-secondary" asp-page="/Administration/Members/Details" asp-route-id="@Model.Member.Id">К карточке члена товарищества</a>
        <a class="btn btn-outline-success" asp-page="/Administration/Members/Finance" asp-route-id="@Model.Member.Id">Финансы</a>
        <a class="btn btn-outline-secondary" asp-page="/Administration/Members/Index">К списку членов товарищества</a>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">ФИО</dt>
            <dd class="col-sm-8">@Model.Member.FullName</dd>

            <dt class="col-sm-4">Логин / email</dt>
            <dd class="col-sm-8">@LoginEmailOrPlaceholder()</dd>

            <dt class="col-sm-4">Текущие роли</dt>
            <dd class="col-sm-8">@(Model.CurrentRoles.Count > 0 ? string.Join(", ", Model.CurrentRoles) : "—")</dd>
        </dl>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-check mb-3">
                <input asp-for="Input.IsAccountant" class="form-check-input" />
                <label asp-for="Input.IsAccountant" class="form-check-label"></label>
            </div>

            <div class="form-text mb-4">
                Роль администратора на этой странице не изменяется. Учетная запись члена товарищества сохраняет остальные назначенные роли.
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <button type="submit" class="btn btn-primary">Сохранить</button>
                <a class="btn btn-outline-secondary" asp-page="/Administration/Members/Details" asp-route-id="@Model.Member.Id">Отмена</a>
            </div>
        </form>
    </div>
</div>

@functions {
    private string LoginEmailOrPlaceholder()
    {
        return string.IsNullOrWhiteSpace(Model.LoginEmail) ? "—" : Model.LoginEmail;
    }
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
