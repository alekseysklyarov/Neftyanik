@page "/Member/Electricity"
@model Neftyanik.Portal.Web.Pages.Member.Electricity.IndexModel
@{
    ViewData["Title"] = AppLocalizer.Get("Электроэнергия", "Електроенергія", "Electricity");
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">@AppLocalizer.Get("Электроэнергия", "Електроенергія", "Electricity")</h1>
        <p class="text-muted mb-0">@AppLocalizer.Get("Ваши индивидуальные однотарифные счётчики.", "Ваші індивідуальні однотарифні лічильники.", "Your individual single-rate meters.")</p>
    </div>
    <div>
        <a class="btn btn-outline-secondary" asp-page="/Member/Index">@AppLocalizer.Get("Назад в личный кабинет", "Назад до особистого кабінету", "Back to dashboard")</a>
    </div>
</div>

@if (!Model.IsLinked)
{
    <div class="alert alert-warning">@AppLocalizer.Get("Учетная запись не связана с карточкой члена товарищества. Обратитесь к администратору.", "Обліковий запис не пов'язаний із карткою члена товариства. Зверніться до адміністратора.", "The account is not linked to a member record. Contact the administrator.")</div>
}
else if (Model.Meters.Count == 0)
{
    <div class="alert alert-info">@AppLocalizer.Get("Активные счётчики участника не найдены.", "Активних лічильників учасника не знайдено.", "No active member meters were found.")</div>
}
else
{
    <div class="row g-4">
        @foreach (var meter in Model.Meters)
        {
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <div class="d-flex flex-column flex-lg-row justify-content-between gap-3">
                            <div>
                                <h2 class="h5 mb-1">@meter.DisplayName</h2>
                                <p class="text-muted mb-3">@(string.IsNullOrWhiteSpace(meter.MeterNumber) ? AppLocalizer.Get("Номер не указан", "Номер не вказано", "Number not specified") : AppLocalizer.Get($"Номер: {meter.MeterNumber}", $"Номер: {meter.MeterNumber}", $"Number: {meter.MeterNumber}"))</p>
                                <div class="row g-3">
                                    <div class="col-md-4"><div class="text-muted small">@AppLocalizer.Get("Связанные участки", "Пов'язані ділянки", "Connected plots")</div><div class="fw-semibold">@string.Join(", ", meter.ConnectedPlots)</div></div>
                                    <div class="col-md-4"><div class="text-muted small">@AppLocalizer.Get("Расчётный участок", "Розрахункова ділянка", "Billing plot")</div><div class="fw-semibold">@meter.BillingPlotNumber</div></div>
                                    <div class="col-md-4"><div class="text-muted small">@AppLocalizer.Get("Последняя дата", "Остання дата", "Latest date")</div><div class="fw-semibold">@(meter.LatestReadingDate.HasValue ? meter.LatestReadingDate.Value.ToString("dd.MM.yyyy") : "—")</div></div>
                                    <div class="col-md-4"><div class="text-muted small">@AppLocalizer.Get("Последнее показание", "Останній показник", "Latest reading")</div><div class="fw-semibold">@(meter.LatestReading.HasValue ? $"{meter.LatestReading.Value:0.000} кВт·ч" : "—")</div></div>
                                    <div class="col-md-4"><div class="text-muted small">@AppLocalizer.Get("Последний расход", "Останнє споживання", "Latest consumption")</div><div class="fw-semibold">@(meter.LatestConsumption.HasValue ? $"{meter.LatestConsumption.Value:0.000} кВт·ч" : "—")</div></div>
                                    <div class="col-md-4"><div class="text-muted small">@AppLocalizer.Get("Последнее начисление", "Останнє нарахування", "Latest charge")</div><div class="fw-semibold">@(meter.LatestChargeAmount.HasValue ? $"{meter.LatestChargeAmount.Value:0.00} грн" : "—")</div></div>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(meter.StatusMessage))
                                {
                                    <div class="alert alert-warning mt-3 mb-0">@meter.StatusMessage</div>
                                }
                            </div>
                            <div class="d-flex flex-column gap-2 align-self-start">
                                @if (meter.HasInitialReading)
                                {
                                    <a class="btn btn-primary" asp-page="/Member/Electricity/Meters/Readings/Create" asp-route-meterId="@meter.Id">@AppLocalizer.Get("Передать показания", "Передати показання", "Submit readings")</a>
                                }
                                <a class="btn btn-outline-primary" asp-page="/Member/Electricity/Meters/Readings/Index" asp-route-meterId="@meter.Id">@AppLocalizer.Get("История показаний", "Історія показань", "Reading history")</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
