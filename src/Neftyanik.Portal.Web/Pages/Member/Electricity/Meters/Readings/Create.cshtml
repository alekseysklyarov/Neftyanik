@page "/Member/Electricity/Meters/{meterId:int}/Readings/Create"
@model Neftyanik.Portal.Web.Pages.Member.Electricity.Meters.Readings.CreateModel
@{
    ViewData["Title"] = AppLocalizer.Get("Передать показания", "Передати показання", "Submit readings");
    var energyUnit = AppLocalizer.Get("кВт·ч", "кВт·год", "kWh");
    var currencyUnit = AppLocalizer.Get("грн", "грн", "UAH");
}

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body">
                <h1 class="h3 mb-3">@AppLocalizer.Get("Передать показания", "Передати показання", "Submit readings")</h1>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <form method="post" class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Input.ReadingDate" class="form-label">@AppLocalizer.Get("Дата показаний", "Дата показань", "Reading date")</label>
                        <input asp-for="Input.ReadingDate" class="form-control" />
                        <span asp-validation-for="Input.ReadingDate" class="text-danger"></span>
                    </div>
                    @if (Model.Meter.HasTwoElectricityMeters)
                    {
                        <div class="col-12">
                            <h2 class="h6 mb-0">@AppLocalizer.Get("Текущие показания", "Поточні показання", "Current readings")</h2>
                        </div>
                    }
                    <div class="col-md-6">
                        <label asp-for="Input.CurrentReading" class="form-label">@(Model.Meter.HasTwoElectricityMeters
                            ? Model.Meter.RequiresNightReading
                                ? AppLocalizer.Get("Счётчик 1: день (кВт·ч)", "Лічильник 1: день (кВт·год)", "Meter 1: day (kWh)")
                                : AppLocalizer.Get("Счётчик 1 (кВт·ч)", "Лічильник 1 (кВт·год)", "Meter 1 (kWh)")
                            : Model.Meter.RequiresNightReading
                                ? AppLocalizer.Get("Текущее дневное показание, кВт·ч", "Поточний денний показник, кВт·год", "Current day reading, kWh")
                                : AppLocalizer.Get("Текущее показание, кВт·ч", "Поточний показник, кВт·год", "Current reading, kWh"))</label>
                        <input asp-for="Input.CurrentReading" class="form-control" />
                        <span asp-validation-for="Input.CurrentReading" class="text-danger"></span>
                    </div>
                    @if (Model.Meter.RequiresNightReading)
                    {
                        <div class="col-md-6">
                            <label asp-for="Input.CurrentNightReading" class="form-label">@(Model.Meter.HasTwoElectricityMeters
                                ? AppLocalizer.Get("Счётчик 1: ночь (кВт·ч)", "Лічильник 1: ніч (кВт·год)", "Meter 1: night (kWh)")
                                : AppLocalizer.Get("Текущее ночное показание, кВт·ч", "Поточний нічний показник, кВт·год", "Current night reading, kWh"))</label>
                            <input asp-for="Input.CurrentNightReading" class="form-control" />
                            <span asp-validation-for="Input.CurrentNightReading" class="text-danger"></span>
                        </div>
                    }
                    @if (Model.Meter.HasTwoElectricityMeters)
                    {
                        <div class="col-md-6">
                            <label asp-for="Input.SecondMeterReading" class="form-label">@(Model.Meter.RequiresNightReading ? AppLocalizer.Get("Счётчик 2: день (кВт·ч)", "Лічильник 2: день (кВт·год)", "Meter 2: day (kWh)") : AppLocalizer.Get("Счётчик 2 (кВт·ч)", "Лічильник 2 (кВт·год)", "Meter 2 (kWh)"))</label>
                            <input asp-for="Input.SecondMeterReading" class="form-control" />
                            <span asp-validation-for="Input.SecondMeterReading" class="text-danger"></span>
                        </div>
                        @if (Model.Meter.RequiresNightReading)
                        {
                            <div class="col-md-6">
                                <label asp-for="Input.SecondMeterNightReading" class="form-label">@AppLocalizer.Get("Счётчик 2: ночь (кВт·ч)", "Лічильник 2: ніч (кВт·год)", "Meter 2: night (kWh)")</label>
                                <input asp-for="Input.SecondMeterNightReading" class="form-control" />
                                <span asp-validation-for="Input.SecondMeterNightReading" class="text-danger"></span>
                            </div>
                        }
                        <div class="col-12 small text-muted">@AppLocalizer.Get("Для расчёта используется сумма показаний двух счётчиков.", "Для розрахунку використовується сума показань двох лічильників.", "Billing uses the sum of both meter readings.")</div>
                    }
                    <div class="col-12 d-flex gap-2">
                        <button type="submit" class="btn btn-primary">@AppLocalizer.Get("Сохранить", "Зберегти", "Save")</button>
                        <a class="btn btn-outline-secondary" asp-page="/Member/Electricity/Index">@AppLocalizer.Get("Назад", "Назад", "Back")</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card shadow-sm mb-3">
            <div class="card-body">
                <h2 class="h5 mb-3">@AppLocalizer.Get("Сведения о счётчике", "Відомості про лічильник", "Meter details")</h2>
                <dl class="mb-0">
                    <dt>@AppLocalizer.Get("Счётчик", "Лічильник", "Meter")</dt>
                    <dd>@Model.Meter.DisplayName</dd>
                    <dt>@AppLocalizer.Get("Связанные участки", "Пов'язані ділянки", "Linked plots")</dt>
                    <dd>@string.Join(", ", Model.Meter.LinkedPlotNumbers)</dd>
                    <dt>@AppLocalizer.Get("Расчётный участок", "Розрахункова ділянка", "Billing plot")</dt>
                    <dd>@Model.Meter.BillingPlotNumber</dd>
                    <dt>@AppLocalizer.Get("Предыдущая дата", "Попередня дата", "Previous date")</dt>
                    <dd>@Model.Meter.PreviousReadingDate?.ToString("dd.MM.yyyy")</dd>
                    <dt>@(Model.Meter.HasTwoElectricityMeters
                        ? AppLocalizer.Get("Сумма предыдущих показаний", "Сума попередніх показань", "Sum of previous readings")
                        : AppLocalizer.Get("Предыдущее показание", "Попередній показник", "Previous reading"))</dt>
                    <dd>
                        @if (Model.Meter.PreviousReading.HasValue)
                        {
                            <div>Т1 @(Model.Meter.PreviousReading.Value.ToString("0.0")) @energyUnit</div>
                            @if (Model.Meter.PreviousNightReading.HasValue)
                            {
                                <div>Т2 @(Model.Meter.PreviousNightReading.Value.ToString("0.0")) @energyUnit</div>
                            }
                        }
                        else
                        {
                            @:—
                        }
                    </dd>
                    @if (Model.Meter.PreviousPhysicalMeterReadingsJson is not null)
                    {
                        <dd><partial name="_PhysicalMeterReadings" model="Model.Meter.PreviousPhysicalMeterReadingsJson" /></dd>
                    }
                    <dt>@AppLocalizer.Get("Тариф", "Тариф", "Tariff")</dt>
                    <dd>
                        @if (Model.Preview.Tariff is null)
                        {
                            @:—
                        }
                        else
                        {
                            <div>Т1 @Model.Preview.Tariff.Rate.ToString("0.00") @currencyUnit/@energyUnit</div>
                            @if (Model.Preview.Tariff.NightRate.HasValue)
                            {
                                <div>Т2 @Model.Preview.Tariff.NightRate.Value.ToString("0.00") @currencyUnit/@energyUnit</div>
                            }
                        }
                    </dd>
                    <dt>@AppLocalizer.Get("Предварительный расход", "Попереднє споживання", "Estimated consumption")</dt>
                    <dd>@(Model.Preview.Consumption.HasValue ? $"{Model.Preview.Consumption.Value:0.000} {energyUnit}" : "—")</dd>
                    <dt>@AppLocalizer.Get("Предварительная сумма", "Попередня сума", "Estimated amount")</dt>
                    <dd>@(Model.Preview.Amount.HasValue ? $"{Model.Preview.Amount.Value:0.00} {currencyUnit}" : "—")</dd>
                </dl>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
