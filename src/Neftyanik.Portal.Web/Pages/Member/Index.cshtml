                                <label asp-for="Profile.FullName" class="form-label">@AppLocalizer.Get("ФИО", "ПІБ", "Full name")</label>
                                <input asp-for="Profile.FullName" class="form-control" />
                                <span asp-validation-for="Profile.FullName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Profile.PhoneNumber" class="form-label">@AppLocalizer.Get("Телефон", "Телефон", "Phone")</label>
                                <input asp-for="Profile.PhoneNumber" class="form-control" />
                                <span asp-validation-for="Profile.PhoneNumber" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Profile.Email" class="form-label">@AppLocalizer.Get("Электронная почта", "Електронна пошта", "Email")</label>
                                <input asp-for="Profile.Email" class="form-control" />
                                <span asp-validation-for="Profile.Email" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@AppLocalizer.Get("Отмена", "Скасувати", "Cancel")</button>
                        <button type="submit" class="btn btn-primary">@AppLocalizer.Get("Сохранить изменения", "Зберегти зміни", "Save changes")</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="changePasswordModal" tabindex="-1" aria-labelledby="changePasswordModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title h5" id="changePasswordModalLabel">@AppLocalizer.Get("Изменить пароль", "Змінити пароль", "Change password")</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@AppLocalizer.Get("Закрыть", "Закрити", "Close")"></button>
                </div>
                <form method="post" asp-page-handler="ChangePassword">
                    <div class="modal-body">
                        <input type="hidden" asp-for="ChargeTypeId" />
                        <input type="hidden" asp-for="ChargePage" />
                        <input type="hidden" asp-for="PaymentPage" />

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="ChangePassword.CurrentPassword" class="form-label">@AppLocalizer.Get("Текущий пароль", "Поточний пароль", "Current password")</label>
                            <input asp-for="ChangePassword.CurrentPassword" class="form-control" type="password" autocomplete="current-password" />
                            <span asp-validation-for="ChangePassword.CurrentPassword" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ChangePassword.NewPassword" class="form-label">@AppLocalizer.Get("Новый пароль", "Новий пароль", "New password")</label>
                            <input asp-for="ChangePassword.NewPassword" class="form-control" type="password" autocomplete="new-password" />
                            <span asp-validation-for="ChangePassword.NewPassword" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ChangePassword.ConfirmNewPassword" class="form-label">@AppLocalizer.Get("Подтверждение нового пароля", "Підтвердження нового пароля", "Confirm new password")</label>
                            <input asp-for="ChangePassword.ConfirmNewPassword" class="form-control" type="password" autocomplete="new-password" />
                            <span asp-validation-for="ChangePassword.ConfirmNewPassword" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@AppLocalizer.Get("Отмена", "Скасувати", "Cancel")</button>
                        <button type="submit" class="btn btn-primary">@AppLocalizer.Get("Изменить пароль", "Змінити пароль", "Change password")</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="paymentNotificationModal" tabindex="-1" aria-labelledby="paymentNotificationModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title h5" id="paymentNotificationModalLabel">@AppLocalizer.Get("Уведомление о платеже", "Повідомлення про платіж", "Payment notification")</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@AppLocalizer.Get("Закрыть", "Закрити", "Close")"></button>
                </div>
                <form method="post" asp-page-handler="CreatePaymentNotification" id="paymentNotificationForm">
                    <div class="modal-body">
                        <input type="hidden" asp-for="ChargeTypeId" />
                        <input type="hidden" asp-for="ChargePage" />
                        <input type="hidden" asp-for="PaymentPage" />

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="PaymentNotification.Amount" class="form-label">@AppLocalizer.Get("Сумма", "Сума", "Amount")</label>
                            <input asp-for="PaymentNotification.Amount" class="form-control" type="number" step="0.01" min="0.01" inputmode="decimal" autocomplete="off" />
                            <span asp-validation-for="PaymentNotification.Amount" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PaymentNotification.PaymentMethod" class="form-label">@AppLocalizer.Get("Способ оплаты", "Спосіб оплати", "Payment method")</label>
                            <select asp-for="PaymentNotification.PaymentMethod" asp-items="Model.PaymentMethodOptions" class="form-select">
                                <option value="">@AppLocalizer.Get("Выберите способ оплаты", "Оберіть спосіб оплати", "Select a payment method")</option>
                            </select>
                            <span asp-validation-for="PaymentNotification.PaymentMethod" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PaymentNotification.Description" class="form-label">@AppLocalizer.Get("Описание", "Опис", "Description")</label>
                            <textarea asp-for="PaymentNotification.Description" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="PaymentNotification.Description" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@AppLocalizer.Get("Отмена", "Скасувати", "Cancel")</button>
                        <button type="button" class="btn btn-primary" id="openPaymentNotificationConfirmation">@AppLocalizer.Get("Отправить уведомление", "Надіслати повідомлення", "Send notification")</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="paymentNotificationConfirmationModal" tabindex="-1" aria-labelledby="paymentNotificationConfirmationModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title h5" id="paymentNotificationConfirmationModalLabel">@AppLocalizer.Get("Подтверждение уведомления", "Підтвердження повідомлення", "Confirm notification")</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@AppLocalizer.Get("Закрыть", "Закрити", "Close")"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0" id="paymentNotificationConfirmationMessage"></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@AppLocalizer.Get("Отмена", "Скасувати", "Cancel")</button>
                    <button type="button" class="btn btn-primary" id="confirmPaymentNotification">@AppLocalizer.Get("Подтвердить", "Підтвердити", "Confirm")</button>
                </div>
            </div>
        </div>
    </div>

}
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (() => {
            const form = document.getElementById('paymentNotificationForm');
            const openButton = document.getElementById('openPaymentNotificationConfirmation');
            const confirmButton = document.getElementById('confirmPaymentNotification');
            const confirmationModalElement = document.getElementById('paymentNotificationConfirmationModal');
            const notificationModalElement = document.getElementById('paymentNotificationModal');
            const amountInput = document.getElementById('PaymentNotification_Amount');
            const paymentMethodSelect = document.getElementById('PaymentNotification_PaymentMethod');
            const messageElement = document.getElementById('paymentNotificationConfirmationMessage');
            const cultureName = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(currentCultureName));
            const confirmButtonText = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(AppLocalizer.Get("Подтвердить", "Підтвердити", "Confirm")));
            const submittingButtonText = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(AppLocalizer.Get("Отправка...", "Надсилання...", "Submitting...")));
            const invalidAmountMessage = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(AppLocalizer.Get("Сумма платежа должна быть больше нуля.", "Сума платежу має бути більшою за нуль.", "The payment amount must be greater than zero.")));
            const invalidPaymentMethodMessage = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(AppLocalizer.Get("Выберите способ оплаты: наличные или перевод на карту.", "Оберіть спосіб оплати: готівка або переказ на картку.", "Select a payment method: cash or card transfer.")));
            const confirmationPrefix = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(AppLocalizer.Get("Вы подтверждаете, что оплатили", "Ви підтверджуєте, що оплатили", "Do you confirm that you paid")));
            const confirmationSuffix = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(AppLocalizer.Get("После отправки платеж будет ожидать подтверждения бухгалтером.", "Після надсилання платіж очікуватиме підтвердження бухгалтером.", "After submission, the payment will await accountant confirmation.")));

            if (!form || !openButton || !confirmButton || !confirmationModalElement || !notificationModalElement || !amountInput || !paymentMethodSelect || !messageElement || !window.bootstrap) {
                return;
            }

            const confirmationModal = window.bootstrap.Modal.getOrCreateInstance(confirmationModalElement);
            const notificationModal = window.bootstrap.Modal.getOrCreateInstance(notificationModalElement);

            const numberParts = new Intl.NumberFormat(cultureName).formatToParts(12345.6);
            const decimalSeparator = numberParts.find(part => part.type === 'decimal')?.value ?? ',';
            const groupSeparator = numberParts.find(part => part.type === 'group')?.value ?? ' ';
            const formattedCurrency = amount => `${new Intl.NumberFormat(cultureName, { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(amount)} грн`;

            const parseAmount = value => {
                if (!value) {
                    return Number.NaN;
                }

                const normalized = value
                    .replaceAll(groupSeparator, '')
                    .replace(/\s/g, '')
                    .replace(decimalSeparator, '.');

                return Number.parseFloat(normalized);
            };

            const validateAmount = () => {
                const parsedAmount = parseAmount(amountInput.value);
                if (!Number.isFinite(parsedAmount) || parsedAmount <= 0) {
                    amountInput.setCustomValidity(invalidAmountMessage);
                    return Number.NaN;
                }

                amountInput.setCustomValidity('');
                return parsedAmount;
            };

            const validatePaymentMethod = () => {
                if (!paymentMethodSelect.value) {
                    paymentMethodSelect.setCustomValidity(invalidPaymentMethodMessage);
                    return false;
                }

                paymentMethodSelect.setCustomValidity('');
                return true;
            };

            amountInput.addEventListener('input', () => validateAmount());
            paymentMethodSelect.addEventListener('change', () => validatePaymentMethod());

            openButton.addEventListener('click', () => {
                const parsedAmount = validateAmount();
                const hasValidPaymentMethod = validatePaymentMethod();
                if (!Number.isFinite(parsedAmount) || !hasValidPaymentMethod || !form.reportValidity()) {
                    return;
                }

                messageElement.textContent = confirmationPrefix + ' ' + formattedCurrency(parsedAmount) + '? ' + confirmationSuffix;
                confirmationModal.show();
            });

            confirmationModalElement.addEventListener('hidden.bs.modal', () => {
                confirmButton.disabled = false;
                confirmButton.textContent = confirmButtonText;
            });

            confirmButton.addEventListener('click', () => {
                const parsedAmount = validateAmount();
                const hasValidPaymentMethod = validatePaymentMethod();
                if (!Number.isFinite(parsedAmount) || !hasValidPaymentMethod || !form.reportValidity()) {
                    confirmationModal.hide();
                    notificationModal.show();
                    return;
                }

                confirmButton.disabled = true;
                confirmButton.textContent = submittingButtonText;
                confirmationModal.hide();
                form.requestSubmit();
            });
        })();
    </script>

    <script>
        (() => {
            const storageKey = 'member-dashboard-active-tab';
            const tabTriggers = Array.from(document.querySelectorAll('[data-member-dashboard-tab="true"]'));

            if (tabTriggers.length === 0 || !window.bootstrap?.Tab || !window.sessionStorage) {
                return;
            }

            const defaultTabId = 'member-dashboard-overview-tab';
            const storedTabId = window.sessionStorage.getItem(storageKey);
            const initialTrigger = tabTriggers.find(trigger => trigger.id === storedTabId)
                ?? tabTriggers.find(trigger => trigger.id === defaultTabId)
                ?? tabTriggers[0];

            if (initialTrigger && !initialTrigger.classList.contains('active')) {
                window.bootstrap.Tab.getOrCreateInstance(initialTrigger).show();
            }

            tabTriggers.forEach(trigger => {
                trigger.addEventListener('shown.bs.tab', event => {
                    if (event.target instanceof HTMLElement && event.target.id) {
                        window.sessionStorage.setItem(storageKey, event.target.id);
                    }
                });
            });
        })();
    </script>

    @if (Model.ReopenEditProfileModal)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                var modalElement = document.getElementById('editProfileModal');
                if (modalElement) {
                    bootstrap.Modal.getOrCreateInstance(modalElement).show();
                }
            });
        </script>
    }

    @if (Model.ReopenChangePasswordModal)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                var modalElement = document.getElementById('changePasswordModal');
                if (modalElement) {
                    bootstrap.Modal.getOrCreateInstance(modalElement).show();
                }
            });
        </script>
    }

    @if (Model.ReopenPaymentNotificationModal)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                var modalElement = document.getElementById('paymentNotificationModal');
                if (modalElement) {
                    bootstrap.Modal.getOrCreateInstance(modalElement).show();
                }
            });
        </script>
    }
}
