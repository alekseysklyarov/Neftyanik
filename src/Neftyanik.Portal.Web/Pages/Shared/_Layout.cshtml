@using Neftyanik.Portal.Domain.Constants
@using System.Globalization
@using Neftyanik.Portal.Web.Localization

@inject UserManager<ApplicationUser> UserManager

@{
    var currentUser = User.Identity?.IsAuthenticated == true ? await UserManager.GetUserAsync(User) : null;
    var userDisplayName = !string.IsNullOrWhiteSpace(currentUser?.DisplayName)
        ? currentUser.DisplayName
        : currentUser?.Email ?? User.Identity?.Name;
    var isAdministrator = User.IsInRole(RoleNames.Administrator);
    var canAccessAdministration = isAdministrator || User.IsInRole(RoleNames.Accountant);
    var successMessage = TempData["SuccessMessage"] as string;
    var errorMessage = TempData["ErrorMessage"] as string;
    var currentCulture = CultureInfo.CurrentUICulture.Name;
    var currentUrl = string.Concat(Context.Request.PathBase, Context.Request.Path, Context.Request.QueryString);
}

<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @AppLocalizer.Get("Портал Нефтяник", "Портал Нафтовик", "Neftyanik Portal")</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Neftyanik.styles.css" asp-append-version="true" />
</head>
<body class="portal-body">
    <header class="portal-header border-bottom">
        <nav class="navbar navbar-expand-lg portal-navbar">
            <div class="container">
                <a class="navbar-brand portal-brand" asp-area="" asp-page="/Index">
                    <span class="portal-brand-line">
                        <span class="portal-brand-title">Нефтяник</span>
                        <span class="portal-brand-subtitle">@AppLocalizer.Get("портал товарищества", "портал товариства", "association portal")</span>
                    </span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#portalNavbar" aria-controls="portalNavbar"
                        aria-expanded="false" aria-label="@AppLocalizer.Get("Переключить навигацию", "Перемкнути навігацію", "Toggle navigation")">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse portal-navbar-collapse" id="portalNavbar">
                    <div class="portal-navbar-content d-lg-flex justify-content-between align-items-lg-center w-100">
                    <ul class="navbar-nav me-auto mb-3 mb-lg-0 align-items-lg-center">
                        @if (User.IsInRole(RoleNames.Member))
                        {
                            <li class="nav-item">
                                <a class="nav-link portal-nav-link" asp-page="/Member/Index">@AppLocalizer.Get("Личный кабинет", "Особистий кабінет", "Member dashboard")</a>
                            </li>
                        }
                        @if (canAccessAdministration)
                        {
                            <li class="nav-item">
                                <a class="nav-link portal-nav-link" asp-page="/Administration/Index">@AppLocalizer.Get("Администрирование", "Адміністрування", "Administration")</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link portal-nav-link" asp-page="/Administration/Plots/Index">@AppLocalizer.Get("Участки", "Ділянки", "Plots")</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link portal-nav-link" asp-page="/Administration/Members/Index">@AppLocalizer.Get("Члены товарищества", "Члени товариства", "Members")</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link portal-nav-link" asp-page="/Administration/Finance/Index">@AppLocalizer.Get("Финансы", "Фінанси", "Finance")</a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav portal-navbar-actions align-items-stretch align-items-lg-center justify-content-lg-end gap-2 gap-lg-3">
                        <li class="nav-item">
                            <form asp-page="/Localization/SetLanguage" method="post" asp-antiforgery="true" class="d-flex align-items-center gap-2 portal-language-form">
                                <input type="hidden" name="returnUrl" value="@currentUrl" />
                                <label class="visually-hidden" for="page-culture-selector">@AppLocalizer.Get("Язык", "Мова", "Language")</label>
                                <select id="page-culture-selector" name="culture" class="form-select form-select-sm">
                                    <option value="ru-RU" selected="@(currentCulture == "ru-RU")">Русский</option>
                                    <option value="uk-UA" selected="@(currentCulture == "uk-UA")">Українська</option>
                                    <option value="en-US" selected="@(currentCulture == "en-US")">English</option>
                                </select>
                                <button type="submit" class="btn btn-outline-secondary btn-sm">@AppLocalizer.Get("Применить", "Застосувати", "Apply")</button>
                            </form>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (canAccessAdministration)
                            {
                                <li class="nav-item">
                                    @await Component.InvokeAsync("PaymentNotificationBell")
                                </li>
                            }
                            <li class="nav-item">
                                <span class="navbar-text portal-user-pill">@userDisplayName</span>
                            </li>
                            <li class="nav-item">
                                <form asp-page="/Account/Logout" method="post" asp-antiforgery="true" class="portal-logout-form">
                                    <button type="submit" class="btn btn-link nav-link portal-nav-link portal-logout-button px-0">@AppLocalizer.Get("Выход", "Вийти", "Log out")</button>
                                </form>
                            </li>
                        }
                    </ul>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container portal-main-shell">
        @if (!string.IsNullOrWhiteSpace(successMessage))
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @successMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@AppLocalizer.Get("Закрыть", "Закрити", "Close")"></button>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @errorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@AppLocalizer.Get("Закрыть", "Закрити", "Close")"></button>
            </div>
        }

        <main role="main" class="portal-main pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer portal-footer text-muted">
        <div class="container">
            &copy; 2026 - Neftyanik Portal
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
