@page "/Account/Login"
@model Neftyanik.Portal.Web.Pages.Account.LoginModel
@using Neftyanik.Portal.Web.Localization
@{
    ViewData["Title"] = AppLocalizer.Get("Вход", "Вхід", "Log in");
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-header">
                <h1 class="h4 mb-0">@AppLocalizer.Get("Вход в систему", "Вхід до системи", "Sign in")</h1>
            </div>
            <div class="card-body">
                <partial name="_LoginForm" model="Model" />
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
