@page
@model Neftyanik.Portal.Web.Pages.Account.ChangeInitialPasswordModel
@using Neftyanik.Portal.Web.Localization
@{
    ViewData["Title"] = AppLocalizer.Get("Смена временного пароля", "Зміна тимчасового пароля", "Change temporary password");
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h3 mb-3">@AppLocalizer.Get("Смена временного пароля", "Зміна тимчасового пароля", "Change temporary password")</h1>
                <p class="text-muted">@AppLocalizer.Get("Для продолжения работы необходимо изменить временный пароль.", "Щоб продовжити роботу, потрібно змінити тимчасовий пароль.", "You need to change the temporary password to continue.")</p>

                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Input.CurrentPassword" class="form-label">@AppLocalizer.Get("Текущий пароль", "Поточний пароль", "Current password")</label>
                        <input asp-for="Input.CurrentPassword" class="form-control" type="password" autocomplete="current-password" />
                        <span asp-validation-for="Input.CurrentPassword" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.NewPassword" class="form-label">@AppLocalizer.Get("Новый пароль", "Новий пароль", "New password")</label>
                        <input asp-for="Input.NewPassword" class="form-control" type="password" autocomplete="new-password" />
                        <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.ConfirmNewPassword" class="form-label">@AppLocalizer.Get("Подтверждение нового пароля", "Підтвердження нового пароля", "Confirm new password")</label>
                        <input asp-for="Input.ConfirmNewPassword" class="form-control" type="password" autocomplete="new-password" />
                        <span asp-validation-for="Input.ConfirmNewPassword" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2 flex-wrap">
                        <button type="submit" class="btn btn-primary">@AppLocalizer.Get("Изменить пароль", "Змінити пароль", "Change password")</button>
                    </div>
                </form>

                <form asp-page="/Account/Logout" method="post" asp-antiforgery="true" class="mt-3">
                    <button type="submit" class="btn btn-outline-secondary">@AppLocalizer.Get("Выйти", "Вийти", "Log out")</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
