SITE_ADDRESS=:80
# Current IP-only HTTP deployment values.
# Use :80 while the site is served directly by IP over plain HTTP.
SITE_ADDRESS=:80
# Keep HTTPS enforcement disabled until a real domain and HTTPS are configured.
REQUIRE_HTTPS=false
MSSQL_SA_PASSWORD=ChangeThis_StrongPassword123!
DB_NAME=NeftyanikPortalDb

# Future domain-based HTTPS deployment example:
# SITE_ADDRESS=example.com
# REQUIRE_HTTPS=true

